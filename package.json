{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "guard:install": "git config core.hooksPath .githooks",
    "guard:private": "node scripts/check-private-leaks.mjs --staged",
    "import:30months": "node scripts/import-30months-release.mjs",
    "test:guard": "node --test scripts/check-private-leaks.test.mjs",
    "test:30months": "node --test scripts/import-30months-release.test.mjs",
    "verify": "pnpm test:guard && pnpm test:30months && pnpm lint && pnpm build",
    "test:email": "node scripts/send-test-email.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.12.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
