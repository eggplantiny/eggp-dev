    {
      "kind": "record",
      "id": "0350",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 415",
      "provenance": "수집 Day 415 · C-2",
      "attribution": {
        "subject": "무균 의약제조 시설 관계자",
        "interviewer": "윤재경",
        "purpose": "제조 시설 기록수집",
        "testimonyTime": "Day 415 15:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "시설에서 질소는 어디에 쓰입니까."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "거의 다요. 원료 보관, 배관 치환, 충전실 분위기. 무균이라는 게 절반은 질소예요. 사람들이 그건 잘 모르시더라고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "공급 축소의 영향을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "이번 주 두 batch를 미뤘어요. 라인을 세운 건 아니고, 순서를 당길 걸 당기고 미룰 걸 미룬 거예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "미루는 순서는 어떻게 정합니까."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "위에서 내려와요. 저희는 표를 받아요. 표에는 번호만 있어요. 그 번호가 뭐가 되는 약인지는 저희 층에선 몰라요. 아는 층이 따로 있고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "미뤄진 것들은 어떻게 됩니까."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "다음 슬롯에 들어가요. 슬롯이 나면요. 밀린 게 밀린 걸 밀어요. 저희가 보는 건 거기까지예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "걱정되는 부분이 있으십니까."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "저는 절차를 걱정해요. 절차 밖의 일은 제 자리에서 안 보여요. 안 보이는 걸 걱정하기 시작하면 이 일은 못 해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "번호만 있는 표를 받는 기분을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "처음엔 이상했어요. 내가 만드는 게 뭔지 모르고 만든다는 게요. 지금은 그게 맞다고 생각해요. 알면 손이 떨릴 표도 있을 거 아니에요. 모르니까 모든 batch를 똑같이 정성 들여요. 그게 이 층의 예의예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "연기된 두 건도 번호로만 아셨습니까."
        },
        {
          "b": "speech",
          "who": "관계자",
          "text": "네. 사번호 둘. 표에서 아랫줄로 내려갔어요. 줄이 내려가는 걸 보면서, 이 줄 끝에 누가 있긴 있겠구나, 그 생각은 했어요. 거기까지만 했어요. 그 다음은 제 층이 아니에요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0351",
      "type": "FR",
      "source": "이송 작업 현장 녹취",
      "time": "Day 417 09:40",
      "provenance": "수집 Day 418 10:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:31:20",
        "recovered": "00:00~11:05"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실외. 트럭 후진 경보음)"
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "스트랩 좌측 고정. 확인."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "좌측 확인. 우측 고정. 확인."
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "우측 확인. 압력계 읽어."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "정상 범위. 배기 밸브 잠금 확인."
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "잠금 확인. 들어 올린다. 천천히."
        },
        {
          "b": "cue",
          "text": "(유압 소리. 금속이 받침에 닿는 소리)"
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "안착. 수평 확인."
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "수평 확인. 다음 거."
        },
        {
          "b": "cue",
          "text": "(발소리. 잠시 무음)"
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "이거는 작네. 이런 것도 다 옮겨요?"
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "목록에 있으면 옮겨. 목록에 없으면 손도 대지 마."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "알겠습니다. 스트랩 좌측 고정. 확인."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
