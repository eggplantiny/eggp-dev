      "provenance": "수집 Day 422 15:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0355.jpg",
          "alt": "성에가 앉은 밸브 손잡이와 그 옆 잔량계의 근접 촬영. 계기 유리에 촬영자의 손이 흐리게 비친다.",
          "caption": "통합 보존고 탱크실 · Day 422"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 낮은 기계음.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 탱크실. 열다섯 시. 큰 탱크 넷. 바닥에 작은 용기 다섯."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "성에는 큰 것에만. 작은 것은 아직 마른 채."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "소리. 낮게 도는 소리 하나. 들은 적 있는 소리. 어디서였는지는 적지 않는다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "벽에 일지. 마지막 줄에 어제 날짜. 그 아래 빈 줄."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "밸브 손잡이. 만졌다. 차갑다. 그것만 적는다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 밸브와 계기."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기까지."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    }
  ]
