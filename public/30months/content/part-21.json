      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실외. 트럭 후진 경보음. 리프트 게이트 내려오는 소리.)"
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "1번. 스트랩 좌."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "좌 걸었습니다."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "우."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "우 걸었습니다."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "압력계."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "초록 안에요."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "숫자로."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "…영점 오."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "영점 오. 배기 밸브 잠금."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "잠갔습니다."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "올린다. 손 떼."
        },
        {
          "b": "cue",
          "text": "(리프트 모터. 금속이 받침에 닿는 소리.)"
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "안착. 수평."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "수평요."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "2번."
        },
        {
          "b": "silence",
          "sec": 20,
          "note": "발소리. 스트랩 푸는 소리"
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "2번은 작네요. 이것도 스트랩 두 개요?"
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "목록에 두 개면 두 개. 크기 보고 정하는 거 아니야."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "좌 걸었습니다. 우 걸었습니다."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "압력계."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "영점 사."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "영점 사. 밸브."
        },
        {
          "b": "speech",
          "who": "작업 보조",
          "text": "잠갔습니다."
        },
        {
          "b": "speech",
          "who": "담당자",
          "text": "(가까이에서, 작게) 그건 제가 들게요. 목록 2번요."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "담당자분은 입회만 하시는 겁니다."
        },
        {
          "b": "speech",
          "who": "담당자",
          "text": "입회하면서 들게요. 열두 해 봤어요, 이거."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "스트랩은 저희가 겁니다. 드는 것만 하세요. 천천히."
        },
        {
          "b": "cue",
          "text": "(발소리 둘. 리프트 모터.)"
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "안착. 수평."
        },
        {
          "b": "speech",
          "who": "담당자",
          "text": "수평이에요."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "담당자분은 복창 안 하셔도 됩니다."
        },
        {
          "b": "speech",
          "who": "담당자",
          "text": "네. 수평이에요."
        },
        {
          "b": "speech",
          "who": "작업 반장",
          "text": "3번."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료.)"
        },
        {
          "b": "cut"
        }
      ]
    },
