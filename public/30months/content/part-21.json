    {
      "kind": "record",
      "id": "0353",
      "type": "FR",
      "source": "○○석유화학 3호 반응기 제어실 · 상시 녹음",
      "time": "Day 419 06:20",
      "provenance": "수집 Day 419 18:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(제어실. 환기 소리. 교대 인계 직후.)"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "개방 전 치환. 오늘은 두 번."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "절차서 4항은 세 번인데요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "두 번. 충전소에서 이번 주 반만 줬다. 압력 봐라."
        },
        {
          "b": "cue",
          "text": "(계기 쪽으로 발소리.)"
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "영점 삼이요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "세 번 돌리면 다음 개방 때 없다. 두 번 돌리고 게이지로 확인해. 게이지 안에 들어오면 개방."
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "왜 그렇게 하세요?"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "방금 말했다. 반만 줬다고."
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "반만 준 건 알겠는데요. 절차서에는 세 번 아니면 개방 금지라고 돼 있어요. 두 번에 게이지로 한다는 항이 없어요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "없지. 없으니까 내가 말하는 거고."
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "그러면 인계장에 뭐라고 적어요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "두 번 했다고 적어. 세 번이라고 적지 말고. 게이지 값도 적고."
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "두 번, 게이지 값. 절차서 4항하고 다르다는 것도 적을게요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "적어라. 그건 니 수첩에 적고, 인계장엔 값만."
        },
        {
          "b": "cue",
          "text": "(종이 넘기는 소리. 적는 소리.)"
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "충전소는 왜 반만 줘요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "몰라. 배차표가 그렇대. 물어봐도 그거야."
        },
        {
          "b": "speech",
          "who": "임세아",
          "text": "그것도 적어 둘게요. 내일 다시 여쭐게요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "내일도 몰라. 치환 시작해."
        },
        {
          "b": "cue",
          "text": "(밸브 도는 소리. 환기 소리 계속.)"
        }
      ]
    },
