    {
      "kind": "record",
      "id": "0350",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 415 15:00",
      "provenance": "수집 Day 415 17:00 · C-2",
      "attribution": {
        "subject": "무균 제조동 충전실 근무자",
        "interviewer": "윤재경",
        "purpose": "제조 시설 기록수집",
        "testimonyTime": "Day 415 15:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "충전실에서 질소가 쓰이는 자리를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "셋이요. 원료 보관 탱크 위, 배관 치환, 충전실 안 공기. 저는 셋째 거 담당이에요. 들어가기 전에 게이지 보고, 나올 때 게이지 보고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "공급이 줄어든 뒤 절차가 바뀌었습니까."
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "절차는 안 바뀌어요. 절차가 바뀌면 그건 다른 제품이에요. 바뀐 건 순서예요. 이번 주에 두 batch가 아래로 내려갔어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "내려갔다는 것은요."
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "표에서요. 위에서 표가 내려오면 저희는 번호순으로 해요. 번호 두 개가 아랫줄로 갔어요. 사유 칸에 원료 수급이라고 있었고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 번호가 무엇인지 아십니까."
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "몰라요. 저희 층에는 번호만 와요. 이름은 위층에서 붙여요. 저는 번호 순서대로 가운 갈아입고 들어가요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "모르는 채로 만드는 것에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "처음엔 이상했어요. 지금은 그게 맞다고 생각해요. 이름을 알면 손이 다른 batch도 있을 거예요. 모르니까 다 같이 정성 들여요. 게이지 보는 횟수가 똑같아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "연기된 두 건은 언제 다시 들어옵니까."
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "슬롯이 나면요. 밀린 게 밀린 걸 밀어요. 이번 주에 제가 하는 건 원래 다음 주 거예요. 저는 그렇게만 알아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 줄의 끝을 생각해 보신 적이 있습니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "근무자",
          "text": "줄이 내려가는 걸 보면서요. 이 번호 끝에 누가 있긴 있겠구나. 거기까지요. 그다음은 제 층이 아니에요. 제 층은 게이지예요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0351",
      "type": "FR",
      "source": "소규모 보존고 이송 작업 · 현장 녹음",
      "time": "Day 417 09:40",
      "provenance": "수집 Day 418 10:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:31:20",
