  "items": [
    {
      "kind": "record",
      "id": "0055",
      "type": "AN",
      "source": "긴급 고시 · 게시 사본",
      "time": "Day 15 06:00",
      "provenance": "수집 Day 15 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 안전민감직무 종사자 배치 제한 긴급 고시\n\n금일 06:00부로 다음 기준을 시행한다.\n\n1. 남성 종사자의 단독 고위험 작업을 금지한다.\n2. 여객항공, 고속여객철도, 대형크레인 단독 운전의 배치를 중단한다.\n3. 발전·수도·정유·화물철도·통신복구·정비 직무는 완화 기준에 따라 계속한다.\n4. 완화 기준과 대상 직무 목록은 소관 기관이 별도 통지한다.\n\n본 고시는 별도 해제 시까지 유효하다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0056",
      "type": "BR",
      "source": "공영방송 정시 안내",
      "time": "Day 15 09:00",
      "provenance": "수집 Day 15 09:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음. 스튜디오 단독)"
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "오늘 새벽 여섯 시부로 시행된 배치 제한 고시를 안내해 드리겠습니다. 목록만 전해 드립니다."
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "중단됩니다. 여객항공. 고속여객철도. 대형크레인 단독 운전."
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "계속됩니다. 발전. 수도. 정유. 화물철도. 통신복구. 정비."
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "해당 사업장 종사자께서는 소속 기관의 통지를 기다려 주시기 바랍니다."
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "필수 기반 시설은 유지됩니다. 다음 안내는 열두 시입니다."
        }
      ]
    },
    {
      "personas": {
        "A": "따뜻한물한잔",
        "B": "세탁기돌리는중",
        "C": "이불밖은위험해",
        "D": "커피는아아",
        "E": "단골손님",
        "F": "호두과자",
        "G": "집앞편의점",
        "H": "겨울준비",
        "I": "초록불"
      },
      "kind": "record",
      "id": "0057",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 15 19:20",
      "provenance": "수집 Day 16 07:00 · C-2",
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0057-1.jpg",
          "alt": "복도에 세워 둔 자전거. 먼지 닦은 자국. 핸들에 걸린 걸레. 바닥의 손펌프.",
          "caption": "아파트 복도 · Day 15"
        }
      ],
      "blocks": [
        {
          "b": "post",
          "ts": "19:20",
          "who": "A",
          "text": "내일부터 버스가 준다는데 다들 출근 어떻게 하세요. 저는 왕복 세 시간 거리입니다"
        },
        {
          "b": "post",
          "ts": "19:48",
          "who": "B",
          "text": "회사에서 통근 차량을 알아본다는데 아직 답이 없습니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "20:15",
          "who": "C",
          "text": "화물차는 다닌다니까 도로가 빈 건 아닐 겁니다. 카풀 구합니다. 북부권입니다"
        },
        {
          "b": "post",
          "ts": "20:37",
          "who": "D",
          "text": "저희 사업장은 필수라서 계속 나오랍니다. 기준이 뭔지는 안 알려줘요"
        },
        {
          "b": "post",
          "ts": "21:02",
          "who": "E",
          "text": "저희도요. 문자 한 통이 전부였습니다",
          "re": "D"
        },
        {
          "b": "post",
          "ts": "21:40",
          "who": "F",
          "text": "자전거를 다시 꺼냈습니다. 십오 년 만입니다"
        },
        {
          "b": "post",
          "ts": "22:26",
          "who": "G",
          "text": "지하철은 다니나요? 공고에 철도는 여객만 중단이라고 돼 있던데요"
        },
        {
          "b": "post",
          "ts": "22:51",
          "who": "B",
          "text": "도시철도는 감편 운행이랍니다. 배차 확인하고 나가세요",
          "re": "G"
        },
        {
          "b": "post",
          "ts": "23:30",
          "who": "H",
          "text": "걸어서 사십 분이면 걷는 게 낫겠네요. 오늘은 일찍 자야겠습니다"
        },
        {
          "b": "post",
          "ts": "23:52",
          "who": "I",
          "text": "필수 사업장인지 아닌지는 어디서 확인하나요. 저희 회사는 아무 말이 없습니다"
        },
        {
          "b": "post",
          "ts": "23:58",
          "who": "C",
          "text": "카풀 두 분 구해졌습니다. 새벽 다섯 시 반 출발입니다. 늦으면 못 기다립니다",
          "re": "C"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0058",
      "type": "FR",
      "source": "버스 차고지 · 무전 겸용 기록",
      "time": "Day 16 05:40",
      "provenance": "수집 Day 16 18:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(옥외 차고지. 디젤 공회전음 하나)"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "3479호, 점검 시작합니다."
        },
        {
          "b": "cue",
          "text": "(타이어 두드리는 소리. 규칙적으로 여섯 번)"
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "각 호차, 금일 전 노선 운행 없습니다. 점검 후 지정 위치에 주차 바랍니다."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "3479호, 수신했습니다."
        },
        {
          "b": "silence",
          "sec": 8,
          "note": "공회전음"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "(작게) 엔진은 돌려놓고. 오 분만 돌리고."
        },
        {
          "b": "cue",
          "text": "(공회전음. 멀리서 셔터 내리는 소리)"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "(작게) 다른 호차들은 어제 다 세웠구나."
        },
        {
          "b": "cue",
          "text": "(차량 내부. 손잡이 부딪는 소리)"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "유류 사분의 삼. 적어놔야 하나. …적어놓자."
        },
        {
          "b": "cue",
          "text": "(종이에 적는 소리)"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "차내 유실물, 우산 하나. 사무실에 갖다 둡니다."
        },
        {
          "b": "cue",
          "text": "(공회전음이 이어지다 멎음. 에어브레이크 배기음)"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "3479호, 주차 완료했습니다. 열쇠는 어디에 둡니까."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "사무실 키박스에 두시면 됩니다."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "알겠습니다."
        },
        {
          "b": "cue",
          "text": "(문 닫히는 소리. 발소리가 멀어짐)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0059",
      "type": "AN",
      "source": "여객운송 중단 공고",
      "time": "Day 16 10:00",
      "provenance": "수집 Day 16 11:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 여객운송 순차 중단 안내\n\n- 시내버스: 금일부로 전 노선 운행을 중단합니다.\n- 시외·고속버스: 예매분 환불 후 순차 중단합니다.\n- 철도: 여객 운행을 중단합니다. 화물 운행은 계속합니다.\n- 도시철도: 감편 운행합니다. 배차 간격은 역별 게시를 확인하십시오.\n- 필수 통근 연계 노선은 사업장 협의를 거쳐 별도 운영합니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0060",
      "type": "LG",
      "source": "운수 사업소 노선 종료 확인 대장",
      "time": "Day 16 23:00",
      "provenance": "수집 Day 17 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "노선 운행 종료 확인 대장",
          "rows": "총 노선           42\n입고 확인         41\n미입고             1\n102번    05:52   입고 확인\n205번    05:47   입고 확인\n318번    06:10   입고 확인 · 서명 누락\n409번    05:58   입고 확인\n523번    06:04   입고 확인 · 유류 기록 없음\n88-1번   06:15   입고 확인\n급행2번  06:22   입고 확인 · 차내 유실물 3건 인계\n771번    회송 미도착   무전 응답 없음 (07:20 최종)",
          "note": "41개 노선 종료 확인 서명 완료. 318번 서명은 추후 보완.\n771번 기사 연락 두절. 차량 위치 확인 중."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0061",
      "type": "AN",
      "source": "비상작업기준 시행 공고",
      "time": "Day 17 09:00",
      "provenance": "수집 Day 17 10:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 비상작업기준 시행\n\n필수 유지 사업장에 다음 기준을 시행한다.\n\n1. 고위험·단독 불가 작업은 2인 1조로 편성한다.\n2. 연속 근무는 6시간을 초과하지 않는다.\n3. 각 작업조에 관찰 인력 1명을 배치할 수 있다. 관찰 인력은 해당 직무 자격을 요하지 않는다.\n4. 작업 중 징후 발생 시 작업을 중단하지 말고 즉시 인계한다.\n5. 인계 발생은 당일 대장에 기록한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0062",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 17 18:40",
      "provenance": "수집 Day 17 18:40 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0062.jpg",
          "alt": "빈 정류장. 벤치의 우산 하나. 반쯤 뜯긴 시간표.",
          "caption": "중앙로 정류장 · Day 17"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 바람에 종이 펄럭이는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 중앙로 정류장. 열여덟 시 사십 분."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "시간표가 반쯤 뜯겨 있다. 기다리는 사람 없음. 벤치에 우산 하나."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "유리에 예전 파업 때 안내문 자국이 남아 있다. 그때는 끝나는 날짜가 적혀 있었다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지나간 차. 화물 아홉, 승용 셋, 자전거 다섯."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "차량 통과음"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "자전거가 더 많은 줄은 처음 센다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0063",
      "type": "FR",
      "source": "정수장 펌프동 · 작업 녹음",
      "time": "Day 18 10:30",
      "provenance": "수집 Day 19 11:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내 펌프동. 저주파 기계음의 잔향)"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "3번 유입 밸브, 반 바퀴 잠급니다."
        },
        {
          "b": "speech",
          "who": "조원",
          "text": "3번 유입, 반 바퀴 잠금."
        },
        {
          "b": "cue",
          "text": "(밸브 휠 도는 소리)"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "압력 확인. 4.2."
        },
        {
          "b": "speech",
          "who": "조원",
          "text": "4.2 확인."
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "제어실입니다. 3번 계통 수치 확인했습니다."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "현장 확인 동일합니다."
        },
        {
          "b": "silence",
          "sec": 7,
          "note": "기계음"
        },
        {
          "b": "speech",
          "who": "관찰 인력",
          "text": "저, 여쭤봐도 됩니까. 같은 밸브를 두 분이 같이 도시는 게 규정입니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "예."
        },
        {
          "b": "speech",
          "who": "관찰 인력",
          "text": "한 분이 돌리고 한 분은 보고만 계시던데요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "하나가 쓰러져도 하나는 밸브를 잠글 수 있으니까요."
        },
        {
          "b": "silence",
          "sec": 9,
          "note": "기계음. 밸브 휠 도는 소리"
        },
        {
          "b": "speech",
          "who": "조원",
          "text": "4번 유입, 반 바퀴 잠금."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "4번 유입, 반 바퀴 잠금 확인."
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "제어실입니다. 4번 계통 확인했습니다."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "현장 동일합니다. 가압동으로 이동합니다."
        },
        {
          "b": "cue",
          "text": "(발소리 둘. 철문 여닫는 소리. 펌프 기동음)"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "2호 가압 펌프, 기동 확인."
        },
        {
          "b": "speech",
          "who": "조원",
          "text": "2호 기동 확인. 진동 정상."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "베어링 온도."
        },
        {
          "b": "speech",
          "who": "조원",
          "text": "사십일 도. 정상 범위."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "펌프 구동음"
        },
        {
          "b": "speech",
          "who": "관찰 인력",
          "text": "저도 뭘 배우면 도울 수 있습니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "지금은 보는 게 일입니다. 보이는 걸 다 기억해 두세요."
        },
        {
          "b": "cue",
          "text": "(작업음 계속)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0064",
      "type": "FR",
      "source": "송전 선로 활선 작업 · 현장 녹음",
      "time": "Day 19 14:00",
      "provenance": "수집 Day 20 15:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(옥외. 높은 곳의 바람 소리. 유압 장치음)"
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "양태식 반, 응답하세요. 723호 철탑 구간 투입 확인합니다."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "예, 올라갑니다. 오늘은 둘이라 버킷이 좁네요. 살쪘으면 큰일 날 뻔했습니다."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "(웃음) 형님이 더 쪘잖아요."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "그러니까 니가 안쪽으로 붙어."
        },
        {
          "b": "cue",
          "text": "(버킷 상승음. 바람 소리가 커짐)"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "절연봉 이리 주고. 왼손은 계속 난간."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "왼손 난간, 예."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "다음 주에 교육생 두 명 온답니다. 형님 반으로 온다던데요."
        },
        {
          "b": "silence",
          "sec": 11,
          "note": "바람 소리. 유압음"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "클램프 물었다. 확인."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "클램프 확인."
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "양태식 반, 723호 완료 확인. 다음 구간 724호."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "수신. 내려간다. 니는 물 마시고 올라와. 한 번에 길게 못 있는다."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "형님도요."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "나는 반장이라 된다."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "(웃음) 그런 게 어딨습니까."
        },
        {
          "b": "cue",
          "text": "(버킷 하강음. 바람 소리 잦아듦)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0065",
      "type": "AN",
      "source": "구내식당 운영 안내",
      "time": "Day 20 08:00",
      "provenance": "수집 Day 20 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 무료 구내식당 운영 안내\n\n- 필수 유지 사업장 종사자와 동거 가족은 무료로 이용할 수 있습니다.\n- 운영 시간: 06:00~08:00 / 11:30~13:30 / 17:30~19:30\n- 사원증 또는 종사자 확인 문자를 제시하십시오.\n- 교대 근무자의 식사는 동료가 대신 수령할 수 있습니다.\n- 일부 품목은 수급 사정에 따라 예고 없이 변경될 수 있습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0066",
      "type": "FR",
      "source": "사업장 구내식당 · 배식 시간 녹음",
      "time": "Day 20 12:20",
      "provenance": "수집 Day 21 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내 식당. 식판과 수저 소리. 배식대 국자 소리)"
        },
        {
          "b": "speech",
          "who": "배식 담당",
          "text": "국 하나 더 드릴까요."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "아니요, 됐습니다. 아, 잠깐만요. 주세요."
        },
        {
          "b": "cue",
          "text": "(국자 소리)"
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "교대조 것도 하나 받아 갑니다. 확인 문자 여기요."
        },
        {
          "b": "speech",
          "who": "배식 담당",
          "text": "뚜껑 있는 걸로 드릴게요."
        },
        {
          "b": "cue",
          "text": "(안내 방송음)"
        },
        {
          "b": "speech",
          "who": "안내 방송",
          "text": "배식 마감 삼십 분 전입니다. 잔여 좌석 여유 있습니다."
        },
        {
          "b": "silence",
          "sec": 10,
          "note": "식판 소리. 낮은 대화 소음"
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "저기, 여기 앉아도 됩니까."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "앉으세요. 어느 쪽이세요."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "정수장이요."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "아, 수도. 우리는 가스요."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "식판 소리"
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "국 식겠다. 드세요."
        },
        {
          "b": "cue",
          "text": "(아이 목소리. 식판 끄는 소리)"
        },
        {
          "b": "speech",
          "who": "미상 (아이)",
          "text": "아빠는 언제 와요."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "아빠 야간이야. 아침에 와. 이거 먹고 집에 가서 자자."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "(지나가며) 여기 김치가 집 김치 맛이네."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "어느 집이요."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "몰라. 어느 집이겠지."
        },
        {
          "b": "cue",
          "text": "(식판 반납 소리)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0067",
      "type": "AN",
      "source": "자격정보확인 통보 문자 · 양식 사본",
      "time": "Day 21 10:00",
      "provenance": "수집 Day 21 10:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "[자격정보확인] 안내\n\n귀하 명의의 아래 자격이 확인되었습니다.\n\n- 전기기능사 (2007)\n- 제1종 대형 운전면허 (2004)\n\n현재 유효 여부와 관계없이 회신 바랍니다.\n본인이 아니거나 해당 없는 경우 「해당없음」으로 회신하십시오.\n본 확인은 별도 신청과 무관합니다."
        }
      ]
    },
    {
      "personas": {
        "A": "동네주민",
        "B": "바람쐬는중",
        "C": "산책중",
        "D": "무소식이희소식",
        "E": "고구마두개",
        "F": "별헤는밤",
        "G": "조카바보",
        "H": "지나가는행인1"
      },
      "kind": "record",
      "id": "0068",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 21 21:40",
      "provenance": "수집 Day 22 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "21:40",
          "who": "A",
          "text": "방금 이상한 문자를 받았습니다. 이십 년 전에 딴 지게차 면허가 확인됐다는데, 이걸 왜 지금 확인하나요"
        },
        {
          "b": "post",
          "ts": "21:58",
          "who": "B",
          "text": "저도 왔습니다. 저는 무선통신사요. 학교 때 딴 겁니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:15",
          "who": "C",
          "text": "아버지 앞으로도 왔습니다. 아버지는 요양 중이신데요"
        },
        {
          "b": "post",
          "ts": "22:31",
          "who": "D",
          "text": "스팸 아닌가요? 발신 번호가 다 다르던데요"
        },
        {
          "b": "post",
          "ts": "22:49",
          "who": "E",
          "text": "국번이 행정망입니다. 스팸은 아닌 것 같습니다",
          "re": "D"
        },
        {
          "b": "post",
          "ts": "23:07",
          "who": "F",
          "text": "회신하면 뭐가 되는 건가요. 안 하면요"
        },
        {
          "b": "post",
          "ts": "23:24",
          "who": "G",
          "text": "아무 설명이 없으니 그게 제일 무섭네요",
          "re": "F"
        },
        {
          "b": "post",
          "ts": "23:40",
          "who": "A",
          "text": "일단 회신 안 하고 둡니다. 뭔지 알려주는 데가 없어요"
        },
        {
          "b": "post",
          "ts": "23:47",
          "who": "D",
          "text": "회신해 봤습니다. 「확인되었습니다」 자동응답만 옵니다",
          "re": "E"
        },
        {
          "b": "post",
          "ts": "23:55",
          "who": "H",
          "text": "남편 것만 오고 제 것은 안 왔습니다. 저도 간호조무사 자격이 있는데요"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0069",
      "type": "FR",
      "source": "항만 도선선 · 승선 기록",
      "time": "Day 22 06:10",
      "provenance": "수집 Day 23 14:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:47:10",
        "recovered": "00:00~08:44"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(선상. 엔진음과 바람. 파도가 선체를 치는 소리)"
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "정기웅 도선사님, 한주호 좌현 접현 준비됐습니다."
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "수신. 바람 먼저 봅시다. 북서 12노트. 갑니다."
        },
        {
          "b": "speech",
          "who": "동승자",
          "text": "사다리 고정 확인했습니다."
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "조류는."
        },
        {
          "b": "speech",
          "who": "동승자",
          "text": "창조류 끝물입니다."
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "예인선 두 척 위치는."
        },
        {
          "b": "speech",
          "who": "동승자",
          "text": "선수 하나, 선미 하나. 대기 중입니다."
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "배는 나중에 봐도 돼. 바람하고 물부터 보고."
        },
        {
          "b": "silence",
          "sec": 14,
          "note": "엔진음. 바람"
        },
        {
          "b": "speech",
          "who": "동승자",
          "text": "사다리 내려갑니다."
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "한 칸씩. 왼손 놓기 전에 오른손."
        },
        {
          "b": "speech",
          "who": "동승자",
          "text": "왼손 전에 오른손, 예."
        },
        {
          "b": "speech",
          "who": "무전",
          "text": "한주호, 도선사 승선 준비. 좌현 사다리 대기."
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "한주호, 수신했으면 기적 한 번."
        },
        {
          "b": "cue",
          "text": "(먼 기적 소리 한 번)"
        },
        {
          "b": "speech",
          "who": "도선사",
          "text": "접현 개시합니다."
        },
        {
          "b": "cut"
        }
      ]
    },
