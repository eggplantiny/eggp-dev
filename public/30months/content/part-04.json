    {
      "kind": "record",
      "id": "0071",
      "type": "AN",
      "source": "폐쇄근무 전환 통보 · 수신자 전달 사본",
      "time": "Day 23 09:00",
      "provenance": "수집 Day 23 09:00 · C-1",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "폐쇄근무 전환 통보\n\n수신: 준서\n전환 일자: 금일\n근무 형태: 주거지 원격 근무 (폐쇄)\n\n1. 지정 주거지 외 이동을 제한한다.\n2. 지원 물자는 주 1회 문 앞에 배송한다.\n3. 장비 이상 시 원격 지원을 우선한다.\n4. 보고는 지정 채널로 일 1회 이상 한다.\n\n해제 시점은 별도 통보한다."
        },
        {
          "b": "para",
          "text": "전달문: 출근만 없어진다고 한다. 나머지는 그대로라고 한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0072",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 24 22:30",
      "provenance": "수집 Day 24 22:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 벽 너머에서 낮은 장비 팬 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 옆방, 스물두 시 삼십 분. 팬 소리. 키보드 소리. 목소리는 없음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오늘 정리분. 정수장 것 하나. 식당 것 하나. 대장 사본 둘."
        },
        {
          "b": "silence",
          "sec": 7,
          "note": "팬 소리"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문 앞에 둔 저녁, 아직 그대로다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "물은 나온다. 불도 들어온다. 문자도 온다."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사람을 살리려고 둘을 넣는 게 아님."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "설비를 지키려고 둘을 넣는 것임."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
  ]
}
