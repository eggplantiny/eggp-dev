    {
      "kind": "record",
      "id": "0151",
      "type": "IV",
      "source": "인터뷰",
      "time": "Month 22",
      "provenance": "수집 Month 22 · C-4",
      "attribution": {
        "subject": "시·군 선거관리 실무자",
        "interviewer": "윤재경",
        "purpose": "행정 사무 운영 기록수집",
        "testimonyTime": "Day 48 09:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "재선거 사무 준비 지시를 받았을 때부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "서식이 왔어요. 현황표 서식이요. 한 장짜리요. 재선거는 원래 있는 일이니까 별생각 없었어요. 한 해에 한두 번은 하거든요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "언제부터 별생각이 생겼습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "둘째 주요. 별지가 한 장에서 두 장이 됐을 때요. 서식은 한 장에 다 들어가게 만든 서식이었거든요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "보류 지시를 받고는요."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "보고는 계속했어요. 사흘마다요. 숫자만 바뀌는 보고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "보고에 회신은 있었습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "처음 두 번은 접수됐다는 회신이 왔어요. 그다음부터는 없었어요. 없는데도 보냈어요. 그만 보내라는 말도 없었으니까요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 무렵에 계산을 하셨다고 들었습니다."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "계산이랄 것도 없어요. 현황표를 만들면 돌아가신 분들을 세게 되잖아요. 세다 보니까 어느 날 남은 분들을 세고 있더라고요. 그건 지시에 없는 일이었는데요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 계산의 결과를 여쭤도 되겠습니까."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "그건 안 말씀드릴게요. 제가 계산한 게 맞았는지 아직도 모르거든요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어려운 계산이었습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "아니요. 재적이 몇이고, 과반이 몇이고. 초등학교 산수예요."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "저 같은 사람이 전국에 몇백 명 있었을 거예요. 다 각자 계산기를 두드렸을 거고요."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "그게 제일 무서운 부분이에요. 어려운 계산이 아니었다는 거."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "계산하신 다음에는요."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "서랍에 넣었어요. 사흘마다 보고를 계속했고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 메모를 누구에게 보여주신 적이 있습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "없어요. 지시받은 일도 아닌데 보여줄 데가 어디 있어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "연기 통지가 왔을 때는요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "서랍을 한 번 열어봤어요. 그리고 닫았어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 사무실은 어땠습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "똑같았어요. 통지 오고, 접수 도장 찍고, 현황표 갱신하고. 투표 사무원 명단만 서랍 다른 칸으로 옮겼어요. 다섯 명이었어요. 회신해 주신 분들한테 따로 연락은 안 했어요. 뭐라고 해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금 그 메모는 어디에 있습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "그대로 있어요. 버리려니까 공문서 같아서요. 공문서도 아닌데."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "현황표는 그 뒤로도 보내셨습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "그건 여기서 말씀드릴 게 아닌 것 같아요. 그만 보내라는 지시가 온 적이 없다는 것까지만요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그때로 돌아가면 무엇을 다르게 하시겠습니까."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "다르게 할 게 없어요. 저는 서식대로 다 했어요. 서식 안에서는 알 수가 없는 거였어요. 이면지에다가나 알 수 있지."
        }
      ]
    },
    {
      "kind": "record",
