      "blocks": [
        {
          "b": "cue",
          "text": "(환기음. 발소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "중앙 통로. 여기서 한 장."
        },
        {
          "b": "cue",
          "text": "(셔터음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "번호표는 가까이 찍지 말라고 했다. 사진에는 줄만 보일 것 같다."
        },
        {
          "b": "cue",
          "text": "(발소리 멈춤)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문 앞에 장갑을 두고 들어왔다. 돌아가서 가져올 것."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0492",
      "type": "BR",
      "source": "공영방송 저녁 단신",
      "time": "Day 837 19:00",
      "provenance": "수집 Day 837 19:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음)"
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "권역 연구소가 태아기 예방 절차의 제한 검증에 착수했습니다. 연구소는 정해진 참여 조건 아래 기전과 초기 안전성을 확인할 계획이라고 밝혔습니다."
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "현재 결과 발표 단계는 아니며, 기존 반복치료의 중단이나 변경을 뜻하지 않는다고 덧붙였습니다."
        },
        {
          "b": "speech",
          "who": "진행자",
          "text": "이어서 내일의 여객 운행 안내입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0493",
      "type": "PV",
      "source": "개인 수첩",
      "time": "Day 840 22:00",
      "provenance": "수집 Day 840 22:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "hand",
          "text": "Day 837 저녁 단신.\n'검증에 착수.' 완료 아님.\n\n연구소에 물어볼 것\n— 누구에게 하는 절차인가.\n— 지금 확인하려는 것은 무엇인가.\n— 무엇은 아직 알 수 없는가.\n\n보건 창구에 문의했으나 발표문 외 답변 받지 못함.\n단신이 실제로 어디까지를 뜻하는지 모름.\n\n원음 00:18의 '제한'이 냉장고 소리와 겹침.\n사무실에서 다시 들을 것."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0494",
      "type": "AN",
      "source": "연구소 검증 협력 안내 · 보건 창구 게시본",
      "time": "Day 845 09:00",
      "provenance": "수집 Day 845 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 검증 협력 문의\n\n참여 조건과 절차는 보건 창구의 개별 상담을 통해 안내합니다.\n게시판에 이름·등록번호·임신 관련 정보를 남기지 마십시오.\n\n문의와 참여는 자율이며 철회할 수 있습니다.\n참여 여부는 기존 보건·배급 서비스와 관계없습니다.\n명단과 검체의 식별 정보는 분리해 관리합니다.\n\n창구 접수: 오전 9시~11시\n접수증은 문의 예약 확인용입니다. 참여 승인서가 아닙니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0495",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 850 10:00",
      "provenance": "수집 Day 850 11:00 · C-2",
      "attribution": {
        "subject": "권역 기록소 입고 담당",
        "interviewer": "윤재경",
        "purpose": "수집 기록 이관 절차 확인",
        "testimonyTime": "Day 850 10:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "담당",
          "text": "그 상자 그대로 오시면 안 돼요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "젖은 적은 없습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "젖어서가 아니라 바닥이요. 들어 보셨어요? 들면 이쪽이 벌어져요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "끈으로 묶어 오겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "묶고 밑에 판 하나 받치세요. 도착할 때까지만 버티면 돼요. 여기서 옮겨 담을 거니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여러 군데 나눠 둔 것도 가져와야 합니까?"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "가져올 수 있으면요. 종이가 오래 살려면 종이끼리 모여 살아야 해요. 제가 집집마다 물 새는 데를 봐드릴 수는 없잖아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기도 새는 데가 있습니까?"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "저 끝은 아직 안 써요. 비 오는 날 확인하고 넣으려고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "빈 서가도 배정을 해두셨군요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "빈 게 아니라 못 쓰는 거죠. 거긴 사진에 안 나왔으면 좋겠는데."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금은 녹음만 하고 있습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아, 그러네요. 빈방 자랑한 것처럼 들릴까 봐요."
        },
        {
          "b": "cue",
          "text": "(서랍 여는 소리)"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "이건 반입표. 이건 내용 목록. 묶음 순서는 그대로 적으세요. 날짜가 뒤집혀 있어도 저희가 먼저 고치지 않아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "원본하고 사본이 섞여 있으면요?"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아는 데까지만 표시해요. 모르면 모른다고. 그리고 녹음은 종이 상자에 같이 넣지 마세요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "따로 보냅니까?"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "따로 받아요. 종이는 먼저 오고 장치가 안 오는 분이 있어서, 체크를 따로 해놨어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아직 수집이 끝나지 않았는데요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "한 번에 안 주셔도 돼요. 주신 데까지 영수증 드려요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "원본을 다시 볼 수는 있습니까?"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "네. 그때 이 영수증 가져오세요. 번호로 찾아드려요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "잃어버리면요?"
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "이름으로도 찾아요. 그래도 잃어버리지 마세요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0496",
      "type": "LG",
      "source": "기록소 이관 대장 · 신규 서고 입고분",
      "time": "Day 855 17:00",
