    {
      "kind": "record",
      "id": "0179",
      "type": "FR",
      "source": "극저온 충전소 상차장 · 상시 녹음",
      "time": "Day 80 14:20",
      "provenance": "수집 Day 81 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(상차장. 펌프 소리. 김 빠지는 소리 길게.)"
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "삼 번 차. 액체질소. 목요일 보존 시설 건."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "목요일 건 나예요. 얼마나 넣어요."
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "배정량대로. 지난주보다 이백 적어요. 위에서 그렇게 내려왔어요."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "이백 적으면 저쪽에서 뭐라 안 해요?"
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "뭐라 하면 배정표 보여 드려요. 열하나 중 하나. 그거 하나가 그쪽 거예요."
        },
        {
          "b": "silence",
          "sec": 28,
          "note": "펌프 소리"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "어제 산업용 하나 빠진 거, 그거 이쪽으로 안 넘어와요?"
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "안 넘어와요. 결항은 결항이에요. 이월 없음."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "차가 서서 빠진 건데."
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "그래도요. 표가 그래요."
        },
        {
          "b": "cue",
          "text": "(호스 소리. 밸브 잠그는 소리.)"
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "삼 번 차 마감. 다음 주 목요일도 같은 시간."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "같은 시간. 저쪽은 갈 때마다 조용해서 좋아요. 병원은 하차장부터 정신이 없는데."
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "조용하지. 손님이 조용한 데니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "상차",
          "text": "웃자고 한 말은 아니고. 사 번 차. 의료용 산소."
        },
        {
          "b": "cue",
          "text": "(펌프 소리 계속.)"
        }
      ]
    },
    {
      "kind": "record",
