    {
      "kind": "record",
      "id": "0179",
      "type": "FR",
      "source": "보존 시설 탱크실 · 상시 녹음",
      "time": "Day 80 14:20",
      "provenance": "수집 Day 81 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(탱크실. 환풍기 소리)"
        },
        {
          "b": "cue",
          "text": "(밸브 여는 소리. 김 빠지는 소리 길게)"
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "일번 탱크. 육십이 퍼센트."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "받으세요."
        },
        {
          "b": "cue",
          "text": "(호스 연결음. 충전음)"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "이번 주는 양이 좀 짭니다. 위에서 그렇게 왔어요."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "짜도 와 주시는 게 어디예요."
        },
        {
          "b": "silence",
          "sec": 28,
          "note": "충전음"
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "다음 주도 옵니다. 목요일요."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "목요일. 적어둘게요."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "여기는 올 때마다 조용해서 좋네요. 병원은 하차장에서부터 정신이 없거든요."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "조용하죠. 저희 손님들이 조용한 분들이라."
        },
        {
          "b": "speech",
          "who": "기사",
          "text": "(웃음) 그러네요."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "웃자고 한 말인데 하고 나니까 이상하네요."
        },
        {
          "b": "cue",
          "text": "(호스 분리음. 밸브 잠그는 소리)"
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "(작게) 일번 팔십칠. 이번 주도 넘겼다."
        },
        {
          "b": "cue",
          "text": "(환풍기 소리 계속)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0180",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 81 23:00",
      "provenance": "수집 Day 81 23:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 수첩 넘기는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 이번 주 취재. 울산 배치 면담. 시험 병동. 보존 시설. 행정복지센터."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "적은 항목 마흔둘. 받은 자료 열하나. 사진 아홉."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네 곳에서 네 번, 같은 걸 봤다. 어디에나 명단이 있고, 명단마다 기준이 있고, 기준을 정한 사람은 그 자리에 없다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이건 적지 말자. 관찰이 아니라 생각이다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "방금 문장은 지운다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수첩에 답을 못 받은 질문이 하나 남았다. 어디 가서 물어봐야 하는지도 모르겠는 질문이다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "질문 옆에 동그라미만 쳐 둔다. 답을 받으면 지울 거다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0181",
      "type": "AN",
      "source": "시험 병동 운영 공고",
      "time": "Day 82 09:00",
      "provenance": "수집 Day 82 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 시험 병동 운영 연장 공고\n\n권역 시험 병동의 운영을 연장한다.\n\n1. 연장 기간: 별도 공고 시까지.\n2. 선정 기준: 현행 유지."
        }
      ]
    }
