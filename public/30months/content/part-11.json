      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 수첩 넘기는 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 이번 주. 울산. 대전. 병동. 센터."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "적은 항목 마흔둘. 받은 서류 열하나. 사진 아홉. 그중 게시판에서 받은 게 둘."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "공고 넷. 개정 사유 칸 빈 것 하나. 관찰 중단 사유 칸 빈 것 하나."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "명단 셋. 각각 기준이 있다. 기준을 적은 사람은 셋 다 그 자리에 없었다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수첩 마지막 장. 답을 못 받은 질문 하나. 열일곱 번."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어디에 물어야 하는지 모르는 질문이다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "질문 옆에 동그라미. 답이 오면 지운다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
