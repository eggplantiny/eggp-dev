      "time": "Day 76",
      "provenance": "수집 Day 76 · C-2",
      "attribution": {
        "subject": "생식세포 보존 시설 운영 실무자 (대전)",
        "interviewer": "윤재경",
        "purpose": "보존 시설 운영 기록수집",
        "testimonyTime": "Day 76 11:00"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0174.jpg",
          "alt": "성에가 앉은 보존 탱크 한 기. 밸브 손잡이와 잔량계, 그 옆 벽에 압정으로 고정된 충전 일지. 일지의 글자는 흐려 읽히지 않는다.",
          "caption": "면담 대상 제공 · 보존 시설 탱크실 · Day 76"
        }
      ],
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "시설의 하루를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "아침 여덟 시에 잔량 재고요. 탱크 넷. 서리 상태 보고. 그걸 일지에 적고요. 그다음은 전화예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어디에 하는 전화입니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "공급처요. 다음 충전차가 며칠이냐고요. 목요일이라고 하면 목요일이라고 적어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "충전이 늦어진 적이 있습니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "두 번요. 하루 한 번, 사흘 한 번. 사흘 때는 여기서 잤어요. 자면서 할 수 있는 게 없는데 그랬어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 사흘 동안 잔량은 어땠습니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "일 번 탱크가 사십일까지 내려갔어요. 평소엔 육십 밑으로 안 내려가요. 사십일에서 충전차가 왔고요. 그 숫자는 아직 외워요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "보관 중인 것에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "건수는 대장에 있어요. 지역별로도 있고요. 그건 보시면 되고."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "저희 탱크 안에는 아직 아무도 안 태어났고요."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "그 말이 맞는 말인지는 모르겠네요. 있는 건데 아직 없는 거니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "주 1회 슬롯에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "열하나 중에 하나요. 대장 받았을 때 표를 봤어요. 산소가 열, 저희가 하나. 그렇게 돼 있었고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 배정을 어떻게 받아들이셨습니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "받아들이고 말고가 없어요. 목요일에 차가 오냐, 안 오냐. 저는 그것만 봐요. 지난주엔 왔어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "기증 문의는 어떻습니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "전화가 줄었어요. 지난달에 스물셋, 이달에 아홉. 그중에 실제로 오신 분이 넷, 셋, ~5  …그건 여기까지 할게요. 대장에 있어요."
        }
      ]
    },
