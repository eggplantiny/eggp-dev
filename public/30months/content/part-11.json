    {
      "kind": "record",
      "id": "0177",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 78",
      "provenance": "수집 Day 78 · C-2",
      "attribution": {
        "subject": "권역 시험 병동 간호 실무자",
        "interviewer": "윤재경",
        "purpose": "의료 운영 기록수집",
        "testimonyTime": "Day 78 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "병동의 하루를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "아침에 명단 확인, 투여, 여섯 시간 간격 관찰 기록. 저녁에 다음 날 명단이 내려와요. 그게 다예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이 병동에 오시기 전에는 어디 계셨습니까."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "응급에 십오 년. 그다음 초기 병동. 응급 때는 오는 사람을 다 받았어요. 침상 없으면 복도에, 복도 차면 로비에. 못 받는 날은 있어도 안 받는 날은 없었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금은요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "지금은 명단이 받아요. 저희는 명단 다음이에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "명단은 어디서 내려옵니까."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "위에서요. 저희는 이름 옆에 시간만 적어요. 여기까지가 제가 본 거고, 그 위는 들은 거라 말 안 할게요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "관찰 항목에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "체온, 혈압, 산소 포화도. 그리고 별도 항목이 있어요. 그건 제가 말할 수 있는 게 아니에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "투여받지 못하는 분들에 대해 여쭙겠습니다."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "전에는 우리가 못 구해서 못 줬거든요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "지금은 있는데 안 줘요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "옆 침상은 받았고 이 침상은 안 받았고. 그건 제가 봤어요. 왜 그 침상인지는 안 적혀 있어요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "(짧게 웃음) 이 얘기는 여기까지요. 세 시에 활력징후 돌아야 돼요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하나만 더요. responder가 무슨 뜻입니까."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "공고에 있는 말이요? 회의 때 저희도 물었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "답을 들으셨습니까."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "관찰하면 알게 된다고요. 그게 답이었어요. 그래서 저희는 관찰해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "면회 줄에서 가족들을 만나실 때가 있습니까."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "매일요. 십오 번이 왜 안 나오냐고 물으시면, 오후에 다시 부른다고 해요. 그건 사실이니까요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "세 시예요. 가볼게요."
        }
      ]
    },
