    {
      "kind": "record",
      "id": "0174",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 76",
      "provenance": "수집 Day 76 · C-2",
      "attribution": {
        "subject": "생식세포 보존 시설 운영자",
        "interviewer": "윤재경",
        "purpose": "보존 시설 운영 기록수집",
        "testimonyTime": "Day 76 11:00"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0174.jpg",
          "alt": "성에 낀 보존 탱크. 밸브와 잔량계. 벽의 충전 일지.",
          "caption": "보존 시설 탱크실 · Day 76"
        }
      ],
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "시설의 하루를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "아침에 잔량 재고, 서리 확인하고요. 일주일에 한 번 충전차가 와요. 그날이 제일 큰 날이에요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "충전이 늦어진 적이 있습니까."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "두 번요. 한 번은 하루, 한 번은 사흘. 사흘 때는 제가 여기서 잤어요. 잔다고 뭐가 달라지는 건 아닌데, 그래도요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 사흘 동안 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "잔량계 보고, 밸브 확인하고. 새벽에 한 번은 탱크에 대고 얘기를 했네요. 조금만 버티라고. (웃음) 탱크한테요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "보관 중인 것에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "숫자는 대장에 있으니까 그걸 보시면 되고요."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "저희 탱크 안에는 아직 아무도 안 태어났고요."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "그 말이 맞는 말인지 모르겠네요. 태어날 사람들이 있는 건지, 있을 사람들이 있는 건지."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "슬롯이 주 1회로 배정된 것에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "열하나 중에 하나요. 처음엔 서운했는데, 표를 다시 보니까 산소가 열이잖아요. 산소는 지금 숨 쉬는 사람들 거고요. 저희 건 아직 숨 안 쉬는… (잠시 멈춤) 아직인 분들 거니까요. 순서가 그렇게 되는 거겠죠."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 순서에 동의하십니까."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "동의하고 말고가 있나요. 저는 목요일에 차가 오느냐만 봐요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "기증 문의는 어떻습니까."
        },
        {
          "b": "speech",
          "who": "운영자",
          "text": "전화가 줄었어요. 그것만 말씀드릴게요."
        }
      ]
    },
    {
