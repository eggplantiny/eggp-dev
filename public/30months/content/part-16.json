    {
      "kind": "record",
      "id": "0260",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 201",
      "provenance": "수집 Day 201 · C-2",
      "attribution": {
        "subject": "회랑 하역장 담당",
        "interviewer": "윤재경",
        "purpose": "공급 운영 기록수집",
        "testimonyTime": "Day 201 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "검수 대장을 봤습니다. 같은 공급지가 세 번 기준을 어겼습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "네. 제가 적은 겁니다. 세 번 다요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "적을 때 어떠셨습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "처음엔 별생각 없었어요. 부족하면 부족하다고 적는 거니까. 두 번째부터는 적으면서 위를 봤어요. 이걸 적으면 무슨 일이 일어나야 하는 거 아닌가. 세 번째는… 그냥 적었어요. 일어나는 일이 없다는 걸 아니까."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 뒤에 무엇이 달라졌습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아무것도요. 화요일에 배가 오고, 금요일에 배가 와요. 그대로예요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "보고는 하셨습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "했지요. 세 번 다 했어요. 두 번째 보고 올릴 때 위에 전화로 물어봤어요. 저기는 세 번이나 어겼는데 왜 배가 계속 옵니까?"
        },
        {
          "b": "speech",
          "who": "—",
          "text": "뭐라고 답하던가요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "대신 보낼 데가 없으니까요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "그 한마디였어요. 화내는 것도 아니고, 미안한 것도 아니고. 그냥 날씨 말하듯이요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 답을 듣고 어떠셨습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "다음 날 화요일이었어요. 배가 왔고, 저는 내렸어요. 내리면서 생각했지요. 저 배도 그 말을 아는 걸까. 알 것 같더라고요. 오는 폼이 그래요. 미안한 기색이 없어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "규약이라는 게 그러면 무엇입니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "글쎄요. 종이에는 기준이라고 적혀 있는데."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "저울추 같은 거 아닐까요. 어느 쪽이 무거운지 재는. 우리가 저쪽을 필요로 하는 무게랑, 저쪽이 우리를 필요로 하는 무게랑. 지금은 우리 쪽이 가벼운 거고요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "무게가 어디서 바뀌는지는 몰라요. 부두에서는 안 바뀌어요. 부두에서 보이는 건 배뿐이고, 배는 그대로니까요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아, 이건 적지 마세요. 그냥 하역장 아저씨 생각이에요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "적어도 되겠습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "…적으세요. 틀린 말은 아닌 것 같으니까."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0261",
      "type": "DX",
      "source": "항해 통신 채록 · 이관분",
      "time": "기록 Day 172 추정",
      "provenance": "수집 Day 202 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:08:12",
        "recovered": "00:00~01:45"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(무선 잡음)"
        },
        {
          "b": "speech",
          "who": "교신 1",
          "text": "위치 보고. 북서 항로 절반 지남. 도착 예정 내일 오전."
        },
        {
          "b": "speech",
          "who": "교신 2",
          "text": "수신. 접안 두 번 자리 비워 둔다."
        },
        {
          "b": "speech",
          "who": "교신 1",
          "text": "남쪽 소식 있나. 요즘 남쪽 배를 통 못 봤다."
        },
        {
          "b": "speech",
          "who": "교신 2",
          "text": "남쪽은 요즘 뜸하다. 이유는 몰라. 지난달에 두 번, 이달엔 아직이다."
        },
        {
          "b": "speech",
          "who": "교신 1",
          "text": "남쪽 애들 배가 좋았는데. 냉동칸도 있고."
        },
        {
          "b": "speech",
          "who": "교신 2",
          "text": "그러게. 뭐, 사정 있겠지."
        },
        {
          "b": "speech",
          "who": "교신 1",
          "text": "수신. 내일 보자."
        },
        {
          "b": "speech",
          "who": "교신 2",
          "text": "아, 그리고. 등대 불 어제부터 다시 들어왔다. 참고해라."
        },
        {
          "b": "speech",
          "who": "교신 1",
          "text": "반가운 소식이네. 수신."
        },
        {
          "b": "cue",
          "text": "(잡음. 복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
