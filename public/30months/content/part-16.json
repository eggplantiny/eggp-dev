    {
      "kind": "record",
      "id": "0254",
      "type": "AN",
      "source": "회랑 공급 운영 공지",
      "time": "Day 181 09:00",
      "provenance": "수집 Day 181 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 회랑 공급 운영 공지\n\n1. 정기 입항: 화·금 (북서 공급지), 수 (남부 공급지), 격주 월 (도서 공급지).\n2. 하역 후 검수는 당일 완료를 원칙으로 한다.\n3. 각 공급지는 공급 규약에 따른 수량·품질 기준을 준수하여 주시기 바랍니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0255",
      "type": "BR",
      "source": "통합 채널 정시 안내",
      "time": "Day 181 12:00",
      "provenance": "수집 Day 181 12:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음)"
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "열두 시 안내입니다. 회랑 공급 운영 공지가 게시되었습니다. 정기 입항 요일을 안내해 드립니다."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "화요일과 금요일, 수요일, 격주 월요일입니다. 자세한 내용은 게시대를 확인하십시오."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "이상입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0256",
      "type": "FR",
      "source": "회랑 하역장 · 상시 녹음",
      "time": "Day 183 08:30",
      "provenance": "수집 Day 184 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(부두. 크레인 구동음. 파도)"
        },
        {
          "b": "speech",
          "who": "검수",
          "text": "팔레트 스물넷… 스물다섯. 끝?"
        },
        {
          "b": "speech",
          "who": "하역",
          "text": "끝이요."
        },
        {
          "b": "speech",
          "who": "검수",
          "text": "명세엔 스물여덟인데."
        },
        {
          "b": "speech",
          "who": "하역",
          "text": "배에 더 없어요. 다 내렸어요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "검수",
          "text": "…그대로 내려요. 부족분은 대장에 적을 테니까."
        },
        {
          "b": "speech",
          "who": "하역",
          "text": "또요?"
        },
        {
          "b": "speech",
          "who": "검수",
          "text": "적는 게 내 일이야. 내리는 게 자네 일이고."
        },
        {
          "b": "cue",
          "text": "(팔레트 내려앉는 소리)"
        },
        {
          "b": "speech",
          "who": "하역",
          "text": "이번 촉매는 또 색이 달라요. 저번보다 연해요."
        },
        {
          "b": "speech",
          "who": "검수",
          "text": "등급 검사는 실험실에서 해. 우리는 수량."
        },
        {
          "b": "speech",
          "who": "하역",
          "text": "그래도 색이 다르다니까요. 삼 년을 내렸는데 이런 색은 처음이에요."
        },
        {
          "b": "speech",
          "who": "검수",
          "text": "…견본 하나 따로 빼놔. 색 다르다고 적을 칸은 없는데, 빼놓을 수는 있으니까."
        },
        {
          "b": "cue",
          "text": "(크레인 소리 계속)"
        }
      ]
    },
