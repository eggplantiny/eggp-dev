    {
      "kind": "record",
      "id": "0269",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 206 14:00",
      "provenance": "수집 Day 206 16:00 · C-2",
      "attribution": {
        "subject": "하역 자재 창고 담당",
        "interviewer": "윤재경",
        "purpose": "공급 운영 기록수집",
        "testimonyTime": "Day 206 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "요청서를 올리는 일을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "매달 스무날에 올려요. 품목, 수량, 지난달 사용량. 그 세 칸이에요. 십구 년째 같은 서식이에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이달 요청은 어떻게 되었습니까."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "서른여섯 올려서 스물셋 왔어요. 와이어가 반 왔고, 예비 펌프는 안 왔고. 와이어는 늘 주던 건데."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "회신에는 무엇이라고 적혀 있습니까."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "배정 조정에 따름. 그 한 줄."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "언제부터 그렇습니까."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "이달부터요. 지난달까진 서른넷 올리면 서른하나 왔어요. 세 개 빠지는 건 늘 있었고. 그건 서식을 잘못 썼거나 재고가 있어서 빼는 거였어요. 이번엔 열셋이 빠졌어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "왜 그렇다고 보십니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "모르겠어요. 요즘은 우리가 달라는 걸 전보다 안 들어줘요. 우리가 뭘 잘못했으면 알 텐데. 검수 다 통과했고, 보고 다 냈고. 사고도 없었어요. 사고가 있었으면 이해를 하겠어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "물어보셨습니까."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "배정과에 전화했죠. 조정이라고 해요. 조정이 왜 됐냐니까, 그건 통지가 그렇게 왔대요. 그 사람도 종이만 보는 거예요. 나처럼."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그러면 지금 창고는 어떻습니까."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "1호기 와이어를 못 갈아요. 한 가닥 일어난 게 삼 주째예요. 신호수가 매일 와서 물어요. 2호기 하나로 돌리는데, 2호기도 와이어예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다음 달 요청은 어떻게 쓰실 겁니까."
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "옆 부두 창고는 필요한 것보다 얹어서 쓴대요. 깎일 걸 계산해서. 나는 아직 그렇게 안 썼어요. 십구 년 동안 필요한 만큼 썼거든요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "자재 창고 담당",
          "text": "근데 다음 달엔 어떻게 쓸지 모르겠네요."
        }
      ]
    },
    {
      "kind": "record",
