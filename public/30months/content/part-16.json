    {
      "kind": "record",
      "id": "0268",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 206",
      "provenance": "수집 Day 206 · C-2",
      "attribution": {
        "subject": "회랑 하역장 담당",
        "interviewer": "윤재경",
        "purpose": "공급 운영 기록수집",
        "testimonyTime": "Day 206 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "지난번 이후의 부두를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "배는 그대로 와요. 화요일, 금요일. 그건 달력 같아요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아, 저번에 견본 빼놓으라고 한 촉매요. 실험실 회신이 왔어요. 등급 미달인데 사용 가능 범위라고. 그런 등급이 있는 줄 저도 처음 알았어요. 미달인데 가능한 거요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "달라진 게 있습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "있어요. 우리가 올리는 요청서요. 요즘은 우리가 달라는 걸 전보다 안 들어줘요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "구체적으로 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "지난달에 크레인 와이어 교체분을 올렸어요. 소모품이에요. 늘 주던 거예요. 이번에 반만 왔어요. 예비 펌프는 아예 안 왔고요. 회신엔 배정 조정에 따름."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "언제부터입니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "이삼 주 됐나. 처음엔 서류를 잘못 썼나 했어요. 다시 써서 올렸는데 똑같아요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "짚이는 이유가 있으십니까."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "없어요. 그게 이상해요. 우리가 뭘 잘못했으면 알 텐데, 잘못한 게 없어요. 검수도 다 통과했고, 회신도 밀린 거 없고."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "사고가 났으면 이해를 하겠어요. 사고가 없었어요. 아무 일도 없었는데 뭐가 달라졌어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "위에 물어보셨습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "물어봤지요. 배정 조정에 따름, 이라고 와요. 조정이 왜 됐냐고 물으면 답이 없고요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "지난번엔 그래도 답은 왔잖아요. 대신 보낼 데가 없다고. 그건 답이었어요. 이번엔 답이 없어요. 답이 없는 게 답인가 싶기도 하고."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "부두 일 외의 변화가 있습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "우리 창고 재고가 예전보다 오래 앉아 있어요. 도는 속도가 줄었달까. 배는 오는데 도는 게 줄어요. 이 말이 앞뒤가 안 맞는 거 저도 아는데, 대장 수치가 그래요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "다음 주 예정을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "화, 금요. 그건 안 변해요. 그거 하나는 안 변하네요. 요즘은 그게 고마워요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0269",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 207",
      "provenance": "수집 Day 207 · C-2",
      "attribution": {
        "subject": "하역 작업자",
        "interviewer": "기록수집 4반",
        "purpose": "공급 운영 기록수집",
        "testimonyTime": "Day 207 11:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "작업량의 변화를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "내리는 양은 비슷해요. 배가 같으니까. 근데 가는 데가 달라졌어요. 예전엔 열에 일곱이 창고행이었는데, 요즘은 절반이 바로 차에 실려서 나가요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "어디로 갑니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "송장에 코드만 있어요. 우리는 코드까지만 알아요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 변화를 어떻게 이해하십니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "이해요? (웃음) 허리로 이해하죠. 두 번 드는 짐이 많아졌다, 그게 제 이해예요. 이유는 사무실이 알겠죠. 사무실도 모르면… 뭐, 그건 그쪽 사정이고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "부두에서 오래 일하셨습니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "재난 전부터요. 그때는 컨테이너였죠. 기계가 다 했어요. 우리는 신호수였고. 지금은 팔레트에 로프에, 몸으로 해요. 이십 년 전으로 돌아간 거죠."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "어느 쪽이 낫습니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "그때가 낫죠. 당연히. 근데 이상하게 지금이 기억엔 더 남을 것 같아요. 몸으로 한 건 안 잊어버리거든요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0270",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 207",
      "provenance": "수집 Day 207 · C-2",
      "attribution": {
        "subject": "배급소 창고 직원",
        "interviewer": "기록수집 4반",
        "purpose": "배급 운영 기록수집",
        "testimonyTime": "Day 207 16:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "요청서 작성 업무를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "매달 올려요. 품목이랑 수량 적어서요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "작성 요령이 달라졌다고 들었습니다."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "예전엔 필요한 만큼 적었어요. 백이 필요하면 백. 요즘은 백이 필요하면 백삼십을 적어요. 깎이니까요. 깎일 걸 계산해서 적는 거예요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 요령은 어디서 배우셨습니까."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "배운 게 아니고… 다들 그렇게 해요. 옆 배급소도 그렇게 하고. 어느 날부터 다 그렇게 하고 있더라고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그러면 배정하는 쪽도 그걸 알지 않겠습니까."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "알겠지요. 알고 더 깎겠지요. 그럼 우리는 더 얹고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 결과 서류의 숫자는 무엇을 뜻하게 됩니까."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "…좋은 질문이네요. 모르겠어요. 숫자가 숫자가 아니게 된 지는 좀 됐어요. 저희끼리는 환율이라고 불러요. 요청 환율."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "이게 어디까지 가나 싶을 때가 있는데, 생각하면 머리 아파서 그냥 백삼십 적어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그렇게 적어서 얼마나 받으셨습니까."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "이번 달에요? 백삼십 적어서 아흔둘 받았어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "필요하신 건 백이라고 하셨습니다."
        },
        {
          "b": "speech",
          "who": "직원",
          "text": "네. 여덟 모자라요. 다음 달엔 백오십을 적을 거예요. 이 얘기를 하고 있으면 제가 이상한 사람 같은데, 서류만 보면 다 맞는 서류예요. 그게 제일 이상해요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0271",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 208 15:00",
      "provenance": "수집 Day 208 15:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0271.jpg",
          "alt": "빈 접안 자리. 계선주와 걷힌 밧줄. 예정판의 흐린 글자.",
          "caption": "회랑 하역 부두 · Day 208"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 파도와 바람)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 부두. 열다섯 시."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "접안 자리 다섯. 배 셋. 빈 자리 둘."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하역 중인 배 하나. 크레인 두 번에 팔레트 하나. 세다 보니 스물여섯에서 끝났다. 지난번 명세들은 스물여덟이었다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "빈 자리 계선주에 밧줄이 걷혀 있다. 오래 걷혀 있던 모양은 아니다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "입항 예정판. 화, 금, 수. 다음 주도 같다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "예정판 아래 분필 글씨가 반쯤 지워져 있다. 지난 계절 것 같다. 격주 월요일이라고 적혀 있었던 자리다. 이번 예정판에 월요일은 없다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하역장 담당이 지나가다 멈춰서, 찍을 게 있느냐고 물었다. 빈 자리를 찍는다고 했더니, 그는 잠깐 빈 자리를 보고 갔다. 아무 말 없이."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 빈 자리 쪽."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
  ]
}
