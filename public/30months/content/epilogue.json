  "items": [
    {
      "kind": "record",
      "id": "0503",
      "type": "IV",
      "source": "인터뷰",
      "time": "Month 100",
      "provenance": "수집 Month 100 · C-2",
      "attribution": {
        "subject": "마을 주민 · 다섯 살 아이의 어머니",
        "interviewer": "윤재경",
        "purpose": "생활 기록수집",
        "testimonyTime": "Month 100"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0503.jpg",
          "alt": "마을 끝 밭과 철길. 먼 지평선에 기계 단지의 옅은 윤곽.",
          "caption": "면 외곽 · Month 100"
        }
      ],
      "blocks": [
        {
          "b": "speech",
          "who": "주민",
          "text": "문 열어 놔도 돼요? 애들 소리 많이 날 텐데."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네. 아이가 몇 살입니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "다섯 살이에요. 지금 물통 들고 가는 애요. 안에 아무것도 없는데 저렇게 둘이 들어요."
        },
        {
          "b": "cue",
          "text": "(멀리서 아이들 웃는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "학교에서 돌아온 겁니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "점심 먹고 왔어요. 학교에 작은 반이 있어요. 큰 애들 끝날 때까지는 못 있고요. 아직 낮잠 자는 애들도 있어서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "데리러 가십니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "돌아가면서요. 오늘은 제가 갔어요. 데리고 오면 한 집으로 다 들어가요. 자기 집이 저 건넌데도."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "늘 여기서 놉니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "옆집에 모래 갖다 놓으면 옆집으로 가요. 여기는 물이 잘 나와서 오는 것 같고. 수도꼭지에 끈 묶어 놨어요. 이만큼만 돌리라고. 안 그러면 종일 흘려요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "저 아이들이 다 비슷한 나이입니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "네. 이 동네 그 또래 사내애가 우리 애까지 아홉이에요. 오늘은 다 왔네요. 다른 애들도 있고요. 신발이 자꾸 바뀌어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "바뀐 걸 어떻게 찾습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "바닥에 이름을 써요. 위에 쓰면 싫어해서. 밑창이 닳으면 또 써야 하고요."
        },
        {
          "b": "cue",
          "text": "(문 가까이 뛰어왔다가 멀어지는 발소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "안 들어오네."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아이들이 나간 동안은 무엇을 하십니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "밭에 가요. 멀지는 않아요. 지금은 감자 걷은 자리 정리하고, 콩밭 보고. 학교에서 전화 오면 들어올 수는 있어요. 손에 흙 묻었을 때 오면 받을 때까지 오래 걸리지만."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "기계도 빌려 쓰십니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "밭 뒤집을 때요. 순번 써놨다가 오는 날 맞춰서 해요. 지난번에는 비 와서 하루 밀렸어요. 전날 감자 자루를 길에 내놨다가 도로 들였죠."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "혼자 옮기기에는 무겁지 않습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "자루를 덜 채워요. 저기 작은 것 보이죠? 저만큼씩. 빨리 옮기려면 많이 담아야 할 것 같은데, 많이 담으면 못 들어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "빌린 기계가 고장 나면요?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "면에 수리하는 데가 있어요. 벨트는 거기서 갈아요. 큰 건 보내야 하고. 기계 쪽 큰 단지는 기차로 두 시간 걸려요. 그쪽까지 제가 들고 가는 건 아니고요. 접수만 여기서 해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "기다리는 동안 다른 기계를 빌릴 수 있습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "있으면요. 없으면 손으로 되는 데까지만 해요. 빌리는 표에 고장 났다고 표시해 달랬어요. 말로만 해두니까 다음 사람이 또 기다리더라고요."
        },
        {
          "b": "cue",
          "text": "(봉투 뒤지는 소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "아, 여기 있었네. 장에서 사 와서 다른 데 넣은 줄 알았어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "고무줄입니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "네. 바지에 넣으려고. 흰 것만 있었어요. 안에 넣을 건데 상관없죠."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "장이 가까이 있습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "역 앞이요. 닷새마다 서요. 밭에서 나온 것 조금 가져가고, 필요한 것 사 오고."
        },
        {
          "b": "cue",
          "text": "(천 부스럭거리는 소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "이것 좀 보세요. 길이는 남는데 허리가 안 맞아요. 고무줄만 바꾸면 더 입혀요. 바늘을 어디다 뒀지."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수선하는 곳도 장에 있습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "있어요. 이 정도는 제가 하고요. 지퍼는 갖다줘요. 새 옷은 치수 맞는 게 잘 없어요. 좀 크다고 사면, 입을 만해질 때 애가 그 색 싫다고 하고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "기차로 다녀오십니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "장터는 걸어가요. 기차는 시내 갈 때. 지난번엔 애가 팔이 아프다고 해서 병원에 갔어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금은 괜찮습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "네. 면 진료소에서 사진 한번 찍어 보라고 해서 갔는데, 괜찮대요. 오는 기차에서 벌써 창문에 매달려서. 아까 물통 들던 팔이에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "많이 기다리셨습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "병원보다 돌아오는 걸 오래 기다렸어요. 식당이 닫혀서 가져간 감자 먹고. 물은 역에서 받았어요. 올 때는 한 정거장 전에 잠들었어요. 더 일찍 자면 좋은데 꼭 그때 자요."
        },
        {
          "b": "cue",
          "text": "(사이)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "잠깐만요."
        },
        {
          "b": "cue",
          "text": "(의자 밀리는 소리. 문 여는 소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "물은 거기까지만. 바닥에 붓지 말고."
        },
        {
          "b": "cue",
          "text": "(물 흐르는 소리가 그친다)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "어디까지 얘기했죠?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "기차에서 잠들었다고 하셨습니다."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "아, 그래서 그날 저녁밥을 늦게 먹었어요. 낮잠 잤다고 밤에도 안 자고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "평소에는 몇 시에 잡니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "아홉 시쯤 눕혀요. 자는 건 좀 뒤고. 요즘 더워서 문을 조금 열어두는데 불빛 보이면 자꾸 일어나요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "전기는 밤에도 들어옵니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "네. 낮에 끄는 날은 미리 알려줘요. 물통 채워두고 세탁 먼저 해요. 한번은 빨래 들어 있는 채로 멈춰서 저녁까지 못 꺼냈어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "세탁기를 오래 쓰셨습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "여기 들어올 때부터 있던 거예요. 탈수할 때 뚜껑을 눌러줘야 해요. 수리하는 분이 부품 오면 연락 준댔어요. 아직 전화는 없고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아이가 자면 하시는 일이 있습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "이런 거요. 고무줄 갈고. 라디오 켜놓고. 하다가 그냥 잘 때도 있어요. 바늘만 치우면 돼요."
        },
        {
          "b": "cue",
          "text": "(작게 라디오 잡음. 집게 내려놓는 소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "다이얼이 없어서 집게로 돌려요. 한번 맞춰놓으면 괜찮아요. 애가 만지면 다시 못 찾고. 어디 붙여 놓을까 봐요."
        },
        {
          "b": "cue",
          "text": "(바깥에서 연달아 뛰는 소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "저 신발을 또."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "바뀌었습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "아니요. 거꾸로 신었어요. 지금 부르면 더 빨리 뛰어요."
        },
        {
          "b": "cue",
          "text": "(사이. 웃음소리가 멀어진다)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "학교에 갈 때도 저렇게 서두릅니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "그럴 리가요. 아침에는 양말 한 짝 신는 데도 한참이에요. 밥 다 먹으면 나가자고 해놓고 숟가락만 보고 있어요. 늦었다고 하면 입에 있는 걸 안 씹고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아침에 무엇을 먹습니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "밥하고 달걀. 감자도 먹고요. 껍질을 한 줄로 까달라고 해서, 급한데 끊어지면 다시는 못 붙이잖아요. 그냥 먹으라고 하면 먹기는 해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "내일도 데리러 가십니까?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "내일은 아니에요. 아, 학교에서 수건 보내라고 했는데. 말 나온 김에 꺼내놔야겠어요."
        },
        {
          "b": "cue",
          "text": "(서랍 여닫는 소리)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "이것도 이름 써야 해요. 안 쓰면 다 같은 수건이라서."
        },
        {
          "b": "cue",
          "text": "(주민이 아이의 이름을 부른다. 가까워지는 발소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이름은 언제 지으셨어요?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "태어나기 전에요."
        }
      ]
    }
  ]
}
