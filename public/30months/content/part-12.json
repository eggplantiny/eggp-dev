    {
      "kind": "record",
      "id": "0198",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 91 23:30",
      "provenance": "수집 Day 91 23:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 종이 상자 끄는 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 구십일일째. 정리."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "서고 이관분 상자 아홉. 상자마다 목록. 목록에 안 들어가는 것은 봉투. 번호표 셋. 접수증 넷. 명함 한 장."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문자 한 통. 세 문장. 도착. 장비 받음. 밥 먹음. 답장 두 문장. 시차를 계산하다가 그만뒀다. 거기도 밤이면 됐다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수첩 여섯 권을 상자에 넣다가 첫 권을 폈다. 첫 장 글씨가 지금 글씨보다 크다. 그때는 종이가 모자랄 생각을 안 했다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수집 이관 백사십일 건. 촬영 삼백스물여섯 장. 녹음 쉰아홉. 수첩 여섯 권째."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "처음 나흘 만에 받던 것이 지금은 몇십 일씩 걸려서 온다. 오늘 온 우편물 두 통. 하나는 두 달 전 소인."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "소인 날짜를 적어 둔다. 계산은 안 한다."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오늘 이관 상자에서 일지 사본이 나왔다. 두 달 전 것. 내일 등록하고 서고로."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "내일부터는 달로 센다. 날로 세는 게 이제 안 맞는다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
