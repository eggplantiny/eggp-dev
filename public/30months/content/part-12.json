    {
      "kind": "record",
      "id": "0188",
      "type": "AN",
      "source": "회랑 안내도 게시 공고",
      "time": "Day 84 09:00",
      "provenance": "수집 Day 84 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 회랑 안내도 게시 공고\n\n회랑 안내도를 각 행정복지센터 게시대에 게시한다.\n\n1. 안내도는 게시용이며 배부하지 않는다.\n2. 촬영은 제한하지 않는다."
        }
      ]
    },
    {
      "personas": {
        "A": "동네빵집",
        "B": "보통사람입니다",
        "G": "라떼한잔",
        "C": "겨울준비",
        "D": "저녁노을",
        "E": "늘감사하며",
        "F": "수요일이좋다"
      },
      "kind": "record",
      "id": "0189",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 85 22:00",
      "provenance": "수집 Day 86 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "22:00",
          "who": "A",
          "text": "남쪽 삼거리 동네가 나간다는 얘기 들으신 분 계신가요. 사돈이 거기 삽니다"
        },
        {
          "b": "post",
          "ts": "22:05",
          "who": "B",
          "text": "저도 들었습니다. 공고는 아직 없고요",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:08",
          "who": "G",
          "text": "저희 큰집도 그 동네입니다. 지난 주말에 가서 마늘이랑 고추장 받아왔습니다. 어째 많이 주시더라니요"
        },
        {
          "b": "post",
          "ts": "22:11",
          "who": "C",
          "text": "나간다는 게 어디로 나간다는 건가요"
        },
        {
          "b": "post",
          "ts": "22:15",
          "who": "B",
          "text": "회랑 안으로요. 그렇게들 말합니다",
          "re": "C"
        },
        {
          "b": "post",
          "ts": "22:24",
          "who": "D",
          "text": "이상한 게, 그 동네 옆 공장은 남는답니다. 공장만요"
        },
        {
          "b": "post",
          "ts": "22:31",
          "who": "E",
          "text": "공장에는 사람이 출퇴근을 해야 할 텐데, 동네가 나가면 누가 다니나요",
          "re": "D"
        },
        {
          "b": "post",
          "ts": "22:38",
          "who": "D",
          "text": "그러게요. 그 질문을 사돈도 하더랍니다. 답은 못 들었고요",
          "re": "E"
        },
        {
          "b": "post",
          "ts": "22:46",
          "who": "G",
          "text": "사돈어른들은 뭐라고 하시나요"
        },
        {
          "b": "post",
          "ts": "22:53",
          "who": "A",
          "text": "갈 거면 겨울 오기 전에 갔으면 좋겠다고요. 그 말씀만 하십니다",
          "re": "G"
        },
        {
          "b": "post",
          "ts": "22:56",
          "who": "C",
          "text": "지금이 겨울인데요",
          "re": "A"
        },
        {
          "b": "post",
          "ts": "22:59",
          "who": "A",
          "text": "다음 겨울요",
          "re": "C"
        },
        {
          "b": "post",
          "ts": "23:01",
          "who": "F",
          "text": "짐은 얼마나 가져갈 수 있는지부터 알려줬으면 좋겠습니다. 집이 통째로 못 가는 건 알겠으니까요"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0190",
      "type": "AN",
      "source": "이주 사전 안내",
      "time": "Day 86 09:00",
      "provenance": "수집 Day 86 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 거주지 이전 사전 안내\n\n회랑 재편에 따른 거주지 이전에 대하여 미리 안내한다.\n\n1. 대상 지역과 일정은 추후 공고한다.\n2. 휴대 물품 기준: 1인 40kg.\n3. 기준 초과분의 처리는 대상 지역 공고에 포함한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0191",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 87",
      "provenance": "수집 Day 87 · C-2",
      "attribution": {
        "subject": "이전 예정 지역 주민",
        "interviewer": "윤재경",
        "purpose": "거주지 이전 기록수집",
        "testimonyTime": "Day 87 15:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이 동네에서 얼마나 사셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "나는 태어나서 쭉이고. 집사람이 시집온 지 삼십일 년. 애들은 나가 살고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "동네 분위기를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "조용해요. 다들 조용히 짐을 싸요. 떠들어서 될 일이 아니니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사전 안내를 보셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "봤어요. 사십 킬로라고 적혀 있대요. 우리 집 김치냉장고가 사십 킬로가 넘어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "옆 공장에 대해 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "원래 우리 동네 사람들이 다니던 공장이에요. 지금은 회랑 쪽에서 버스로 출퇴근한대요. 하루 두 번. 그 버스는 남고 우리 버스는 없어지고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이전에 대해 어떻게 생각하시는지 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "생각이랄 게 있나. 셈이 그렇잖아요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "우리 동네 사람이 팔천 명이에요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "옆 공장은 삼백 명 일해요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "근데 우리가 나가요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "셈이 안 맞는 것 같은데, 어느 쪽 셈이 맞는 건지는 나도 몰라요. 팔천 명한테 들어가는 거랑 삼백 명이 만드는 거랑, 그걸 어디서 어떻게 재는 건지."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "준비는 하고 계십니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "저울을 샀어요. 집에 저울이 없더라고요. 살면서 뭐가 몇 킬로인지 잴 일이 없었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "무엇부터 재보셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "앨범요. 사진 앨범 네 권에 육 킬로 반. 이불이 사 킬로. 밥솥이 오 킬로."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "밥솥은 거기 가면 있겠지요? 있다고 해야 앨범을 넣지."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "마지막으로 하실 말씀이 있습니까."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "마당에 감나무가 있어요. 그건 몇 킬로인지 안 재봤어요."
        }
      ]
    },
