    },
    {
      "kind": "record",
      "id": "0249",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 174 11:00",
      "provenance": "수집 Day 174 12:30 · C-2",
      "attribution": {
        "subject": "폐쇄 구역 2 옛 주민",
        "interviewer": "윤재경",
        "purpose": "거주지 이전 후속 기록수집",
        "testimonyTime": "Day 174 11:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "트럭을 보셨다고 들었습니다."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "다리 위에서요. 우리 나올 때도 그 다리였어요. 버스로. 이번엔 트럭이 그쪽에서 나오데요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "몇 대나 보셨습니까."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "안 셌어요. 다 지나갈 때까지 서 있었어요. 덮개가 덮여서 뭔지 몰라요. 몰라서 오래 봤어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "무엇을 보고 싶으셨습니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "우리 집 게 있나. 그거요. 보일러를 삼 년 전에 바꿨거든요. 제일 좋은 걸로. 영감 아플 때. 그건 목록에 있을 거예요. 펌프도 있고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "있다면 어떠십니까."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "어떻고 말고가 있나요. 가는 거지."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "주소는 적힌다면서요. 라벨에."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "원소재지 주소가 기재됩니다."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "그러면 됐어요. 누가 언젠가 읽겠지. 읽어봤자 주소인데. 그래도 적혀는 있는 거니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금 계신 곳은 어떻습니까."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "물은 잘 나와요. 방은 좁고. 보일러는 여기 것도 오래됐어요. 소리가 우리 거랑 달라요. 밤에 그 소리로 알아요. 여기가 우리 집이 아닌 걸."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0250",
      "type": "AN",
      "source": "회수 구역 확대 공고 · 게시 사본",
      "time": "Day 175 09:00",
      "provenance": "수집 Day 175 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 회수 구역 확대 공고\n\n회수 구역을 다음과 같이 확대한다.\n\n1. 확대 구역: 폐쇄 구역 3 전역 및 임시 시설 부지(전시관·접수동 포함).\n2. 임시 시설 부지의 잔존 구조물은 회수 후 철거한다.\n3. 작업반 배정은 반별로 통지한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0251",
      "type": "FR",
      "source": "옛 임시 시설 접수동 · 작업 녹음",
      "time": "Day 176 10:30",
      "provenance": "수집 Day 177 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내. 넓은 공간의 잔향. 벽체 두드리는 소리.)"
        },
        {
          "b": "speech",
          "who": "전기",
          "text": "이 벽. 배선이 이 뒤로 가요. 분전반에서 여기까지."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "그럼 여기서부터 까요?"
        },
        {
          "b": "cue",
          "text": "(공구 내려놓는 소리. 발소리 멈춤.)"
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님. 여기 이름 있는데요."
        },
        {
          "b": "silence",
          "sec": 11
        },
        {
          "b": "cue",
          "text": "(다가오는 발소리. 멈춤.)"
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "찍어두고 뜯읍시다."
        },
        {
          "b": "cue",
          "text": "(사진 촬영음. 간격을 두고 여섯 번.)"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "위에서부터. 천천히."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "(작게) 위에서부터요."
        },
        {
          "b": "cue",
          "text": "(철거음 시작.)"
        },
        {
          "b": "silence",
          "sec": 240,
          "note": "철거음"
        },
        {
          "b": "cue",
          "text": "(철거음 멈춤.)"
        },
        {
          "b": "speech",
          "who": "전기",
          "text": "배선 나왔어요. 피복 멀쩡해요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "감아요."
        },
        {
          "b": "silence",
          "sec": 30,
          "note": "케이블 감는 소리"
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "라벨 주소는요. 여기 동이 없는데."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "접수동."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "비고는요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "벽체 철거 포함."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "그것만요?"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "그것만."
        },
        {
          "b": "cue",
          "text": "(사인펜 소리. 케이블 감는 소리 계속.)"
        }
      ]
    },
    {
