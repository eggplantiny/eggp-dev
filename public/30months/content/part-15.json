    {
      "kind": "record",
      "id": "0247",
      "type": "FR",
      "source": "부품 상차장 · 상시 녹음",
      "time": "Day 171 08:50",
      "provenance": "수집 Day 172 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(옥외. 지게차 후진음. 결박 끈 조이는 소리)"
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "모터 여섯. 다 실었어요. 오늘 짐은 가볍네요."
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "무게는 가벼운데. (결박 확인하는 소리) 이런 짐이 안 가벼운 짐이에요."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "네?"
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "됐어요. 이쪽 마저 조입시다."
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "결박 이쪽 한 번 더. 모터는 구르면 답 없어요."
        },
        {
          "b": "cue",
          "text": "(끈 조이는 소리)"
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "(무전) 3172. 상차 완료. 창고로 출발합니다."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "(혼잣말) 사람은 나갔는데 물건은 계속 나오네요."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "네?"
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "아니에요. 얘 밸브 잠근 거 확인한 거예요. 갑시다."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "오후에 두 탕 더 있어요. 식사는요."
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "차에서 먹어요. 김밥 쌌어요. 지게차분도 하나 드릴까."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "…주시면 감사하죠."
        },
        {
          "b": "speech",
          "who": "운전자",
          "text": "받아요. 혼자 먹으면 소화가 안 돼서 그래요."
        },
        {
          "b": "cue",
          "text": "(시동음. 출발음)"
        }
      ]
    },
    {
      "kind": "record",
