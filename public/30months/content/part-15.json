    {
      "kind": "record",
      "id": "0249",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 174",
      "provenance": "수집 Day 174 · C-2",
      "attribution": {
        "subject": "폐쇄 구역 2 옛 주민",
        "interviewer": "윤재경",
        "purpose": "거주지 이전 후속 기록수집",
        "testimonyTime": "Day 174 11:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "트럭 행렬을 보셨다고 들었습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "다리 위에서요. 이주 때는 우리가 저 다리로 나왔는데, 이번엔 물건들이 나오더라고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "무슨 생각을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "저 안에 우리 집 게 있나, 그 생각요. 덮개가 덮여 있으니 알 수가 없잖아요. 알 수 없어서 오래 봤어요. 다 지나갈 때까지."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "있었으면 좋겠어요. 우리 집 모터가 어디 가서 물이라도 퍼올리고 있으면, 그 집은 아직 일하는 거잖아요. 집도 퇴직이라는 게 있다면, 우리 집은 아직 현역인 거고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "옛집에 두고 오신 것 중에 회수 목록에 있을 만한 것이 있습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "보일러요. 삼 년 전에 바꿨어요. 제일 좋은 걸로. 그건 목록에 있겠지요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "있다면, 어떠십니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "잘 갔으면 좋겠어요. 근데 라벨에 우리 주소가 적혀 있을 거 아니에요. 언젠가 누가 그 라벨을 읽겠지요. 읽어봤자 주소일 뿐인데, 그래도 누가 읽는다는 게, 그게 뭐라고 마음이 놓여요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0250",
      "type": "AN",
      "source": "회수 구역 확대 공고",
      "time": "Day 175 09:00",
      "provenance": "수집 Day 175 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 회수 구역 확대 공고\n\n회수 구역을 다음과 같이 확대한다.\n\n1. 확대 구역: 폐쇄 구역 3 전역 및 임시 시설 부지 (전시관·접수동 포함).\n2. 임시 시설 부지의 잔존 구조물은 회수 후 철거한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0251",
      "type": "FR",
      "source": "옛 임시 시설 접수동 · 작업 녹음",
      "time": "Day 176 10:30",
      "provenance": "수집 Day 177 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내. 넓은 공간의 잔향. 벽체 두드리는 소리)"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "이 벽이에요. 배선이 이 뒤로 지나가요."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "그럼 여기부터 까요."
        },
        {
          "b": "cue",
          "text": "(공구 내려놓는 소리. 발소리 멈춤)"
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "…반장님. 여기 이름 있는데요."
        },
        {
          "b": "silence",
          "sec": 11
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "(다가오는 발소리) …많네."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "찍어두고 뜯읍시다."
        },
        {
          "b": "cue",
          "text": "(사진 촬영음. 여러 번. 간격을 두고)"
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "다 찍었어요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "위에서부터. 천천히 해."
        },
        {
          "b": "silence",
          "sec": 14
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "(작게) 반장님, 이거 그… 뉴스에 나왔던 데 아니에요? 옛날에. 안치소 하던."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "…일해."
        },
        {
          "b": "cue",
          "text": "(철거음 시작)"
        },
        {
          "b": "silence",
          "sec": 240,
          "note": "철거음"
        },
        {
          "b": "cue",
          "text": "(철거음 멈춤)"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "배선 나왔어요. 상태 좋아요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "…그래. 감아."
        },
        {
          "b": "cue",
          "text": "(케이블 감는 소리)"
        },
        {
          "b": "silence",
          "sec": 30
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "라벨 주소, 접수동이라고만 적어요?"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "접수동. 그리고 비고 칸에… (사이) 벽체 철거 포함이라고 적어."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "그것만요?"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "그것만."
        },
        {
          "b": "cue",
          "text": "(사인펜 소리. 케이블 감는 소리 계속)"
        }
      ]
    },
