    {
      "kind": "record",
      "id": "0247",
      "type": "FR",
      "source": "부품 상차장 · 상시 녹음",
      "time": "Day 171 08:50",
      "provenance": "수집 Day 172 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(옥외 상차장. 지게차 후진 경고음. 결박 끈 조이는 소리.)"
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "모터 여섯 다 올렸어요. 팔레트 셋. 오늘 짐은 가볍네요."
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "무게는 가볍지. (끈 당기는 소리) 얘가 이런 짐 실어본 지 얼마 안 돼서 그렇지."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "네?"
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "모터는 구르면 답이 없어요. 이쪽 한 번 더 감아요. 두 번."
        },
        {
          "b": "cue",
          "text": "(끈 조이는 소리. 라쳇.)"
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "(무전) 3172. 상차 끝. 창고로."
        },
        {
          "b": "cue",
          "text": "(무전 잡음. 짧은 답.)"
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "(혼잣말) 사람은 나갔는데 물건은 계속 나오네요."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "뭐라고요?"
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "아니, 얘 밸브. 밸브 잠갔나 본 거예요."
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "오후에 두 탕 더지?"
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "네. 한 시하고 세 시."
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "김밥 쌌는데 하나 먹어요. 혼자 먹으면 체해서."
        },
        {
          "b": "speech",
          "who": "지게차",
          "text": "아… 네. 감사합니다."
        },
        {
          "b": "speech",
          "who": "오미영",
          "text": "받았으면 됐고. (차 문) 야, 가자."
        },
        {
          "b": "cue",
          "text": "(시동. 출발음.)"
        }
      ]
    },
    {
      "kind": "record",
