        }
      ]
    },
    {
      "kind": "record",
      "id": "0136",
      "type": "FR",
      "source": "○○ 발전소 급수펌프동 · 상시 녹음",
      "time": "Day 41 10:20",
      "provenance": "수집 Day 42 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(펌프동 잔향. 발소리 하나. 노트북 여는 소리)"
        },
        {
          "b": "silence",
          "sec": 14,
          "note": "가방 지퍼. 종이 넘기는 소리"
        },
        {
          "b": "cue",
          "text": "(영상 재생음 시작. 스피커를 통한 남자 목소리)"
        },
        {
          "b": "speech",
          "who": "영상",
          "text": "…그 다음에 여기. 이 볼트부터 잡는 거요. 순서가 있어요. 하나, 여기. 둘, 맞은편."
        },
        {
          "b": "cue",
          "text": "(재생 정지음. 발소리. 공구 소리)"
        },
        {
          "b": "cue",
          "text": "(재생음. 같은 구간)"
        },
        {
          "b": "speech",
          "who": "영상",
          "text": "…순서가 있어요. 하나, 여기. 둘, 맞은편."
        },
        {
          "b": "cue",
          "text": "(정지음)"
        },
        {
          "b": "silence",
          "sec": 18,
          "note": "공구 소리와 호흡"
        },
        {
          "b": "cue",
          "text": "(재생음. 같은 구간 세 번째)"
        },
        {
          "b": "speech",
          "who": "영상",
          "text": "하나, 여기. 둘, 맞은편."
        },
        {
          "b": "cue",
          "text": "(정지음. 볼트에 분필 긋는 소리)"
        },
        {
          "b": "silence",
          "sec": 40,
          "note": "작업음"
        },
        {
          "b": "cue",
          "text": "(재생음. 다음 구간)"
        },
        {
          "b": "speech",
          "who": "영상",
          "text": "조이는 건 반대야. 맞은편부터. 아까랑 순서가 달라요. 헷갈리면 안 돼요."
        },
        {
          "b": "cue",
          "text": "(정지음)"
        },
        {
          "b": "silence",
          "sec": 26,
          "note": "공구 소리. 라쳇 돌아가는 소리"
        },
        {
          "b": "cue",
          "text": "(재생음. 같은 구간)"
        },
        {
          "b": "speech",
          "who": "영상",
          "text": "헷갈리면 안 돼요."
        },
        {
          "b": "cue",
          "text": "(정지음)"
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "cue",
          "text": "(재생음 계속)"
        }
      ]
    },
    {
      "personas": {
        "A": "아침형인간",
        "B": "단골손님",
        "C": "밤낚시꾼",
        "D": "새벽운동",
