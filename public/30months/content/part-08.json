    {
      "kind": "record",
      "id": "0144",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 50 23:20",
      "provenance": "수집 Day 50 23:20 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "partial",
      "damage": {
        "duration": "00:04:12",
