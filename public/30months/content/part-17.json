    {
      "kind": "record",
      "id": "0281",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 260",
      "provenance": "수집 Day 260 · C-2",
      "attribution": {
        "subject": "반복 투여 대상자",
        "interviewer": "윤재경",
        "purpose": "의료 운영 기록수집",
        "testimonyTime": "Day 260 15:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다시 뵙습니다. 요즘의 루틴을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "수요일마다 가요. 이제 통지서도 안 봐요. 수요일이면 가는 거예요. 병원 가듯이. 아니, 병원이지 참. (웃음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지난번엔 통지서를 모으고 계셨습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "모았지요. 클리어파일에. 요즘은 안 모아요. 열 몇 장까지 세다가, 어느 날 안 세게 되더라고요. 이가 아프면 치과 가잖아요. 치과 다녀온 영수증을 모으는 사람은 없잖아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이유는 여전히 모르시는 거고요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "모르지요. 근데 덜 궁금해요. 이게 좋은 건지는 모르겠는데, 사는 데는 편해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수요일 대기실 얘기를 들었습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "바둑요? 제가 둬요. 상대는 발전소 다니는 양반인데, 저보다 세요. 지난주엔 병원에서 바둑판을 내놨어요. 우리가 하도 종이에 그려서 두니까. 간호사 선생님이 어디서 구해왔는지 진짜 바둑판을요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "대기실의 대화는 어떤 것입니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "바둑 얘기, 밥 얘기. 약 얘기는 안 해요. 이상하죠. 같은 약 맞으러 온 사람들인데 약 얘기만 안 해요. 무슨 약인지 아무도 모르니까, 할 얘기가 없는 거예요. 모르는 건 얘기가 안 되잖아요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "하나 달라진 게 있긴 해요. 반에서 저를 대하는 게 달라졌어요. 뭐랄까, 조심해요. 무거운 걸 저한테 안 시켜요. 제가 제일 성한데요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 조심을 어떻게 받아들이십니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "처음엔 고마웠는데, 요즘은 좀 그래요. 아껴지는 기분이랄까. 사람이 아니라 뭐, 공구 같은 거요. 좋은 공구는 함부로 안 쓰잖아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 말씀을 반 분들께 하신 적 있습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "아니요. 그 사람들이 잘해주려고 그러는 건데 뭐라고 해요. 그리고 솔직히… 저도 저를 좀 아껴요, 요즘은. 계단도 난간 잡고 다니고. 왜 그러는지 모르면서 그래요. 다들 그래요, 저한테. 저까지도요."
        }
      ]
    },
