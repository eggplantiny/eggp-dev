    {
      "kind": "record",
      "id": "0283",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 268 22:00",
      "provenance": "수집 Day 268 22:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 주간 정리."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이번 주 수집 두 건. 지난달 같은 주는 아홉 건이었다. 그 전 달은 열넷."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수첩에 빈 날이 사흘 있다. 빈 날은 표시를 안 했더니 나중에 헷갈려서, 오늘부터 빈 날엔 줄을 긋기로 한다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "줄을 긋고 보니 이상하다. 아무 일도 없던 날이 기록이 있는 날처럼 보인다. 그래도 긋기로 한다. 없던 것도 있던 것이니까."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "화요일에 시장에서 국수를 먹었다. 취재가 아니었다. 그냥 먹었다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "보존소에서 서고 정리를 도왔다. 상자들이 요즘 천천히 온다. 정리할 시간이 생겼다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오래된 상자 하나를 열었다가 도로 닫았다. 초봄 것이었다. 정리는 다음에 하기로 했다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "적을 게 없는 주간이다. 적을 게 없다고 적는다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
