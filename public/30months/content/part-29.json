    {
      "kind": "record",
      "id": "0477",
      "type": "FR",
      "source": "생활권 수리 접수대 · 반출 확인 녹음",
      "time": "Day 784 20:30",
      "provenance": "수집 Day 785 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(창구 셔터 절반 내려오는 소리.)"
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "번호가요."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "십칠 번. 늦었죠."
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "십칠 번은 다 됐어요. 가져가실 거예요?"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "무거워요?"
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "모터 바꿔서 전 거보다 조금요."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "그럼 내일 수레 빌려 올게요. 오늘은 되는지만 보고."
        },
        {
          "b": "cue",
          "text": "(스위치. 기계 도는 소리.)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "소리가 달라졌네."
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "축도 맞췄어요. 흔들리던 건 없어졌고."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "집에서 틀면 옆집까지 울렸어요. 옆집 사람이 처음엔 두드리더니 나중엔 같이 가만있더라고."
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "그거 받침도 보셔야 돼요. 나무 조각 괴지 말고요."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "나무 조각 괸 건 어떻게 알았어요?"
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "밑에 붙어 왔어요. 여기. 떼 놨어요."
        },
        {
          "b": "cue",
          "text": "(작은 물건을 접수대에 놓는 소리.)"
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "이건 가져갈게요."
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "또 괴실 거면 안 드립니다."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "아니에요. 문 안 닫히게 끼우던 거예요. 원래는."
        },
        {
          "b": "cue",
          "text": "(기계 꺼짐.)"
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "내일 몇 시요."
        },
        {
          "b": "speech",
          "who": "주민",
          "text": "열 시요. 수레 못 빌리면 전화할게요."
        },
        {
          "b": "speech",
          "who": "수리 담당",
          "text": "번호는 그대로 두세요. 완료에 넣으면 내가 또 찾아야 돼."
        },
        {
          "b": "cue",
          "text": "(펜 소리. 셔터 내려옴.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0478",
      "type": "LG",
      "source": "권역 내 생산 부품 품목대장 · 개정분",
