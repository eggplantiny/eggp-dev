      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 종이 넘기는 소리.)"
        },
        {
          "b": "speech",
          "who": "진행",
          "text": "설비 교체 현황."
        },
        {
          "b": "speech",
          "who": "담당 1",
          "text": "이번 달 교체 대상 214대."
        },
        {
          "b": "speech",
          "who": "진행",
          "text": "신규 반입은?"
        },
        {
          "b": "speech",
          "who": "담당 1",
          "text": "219대."
        },
        {
          "b": "speech",
          "who": "진행",
          "text": "다음."
        },
        {
          "b": "speech",
          "who": "담당 2",
          "text": "창고 지붕 보수. 자재는 왔는데 작업일에 차량을 빼 주셔야 합니다."
        },
        {
          "b": "speech",
          "who": "진행",
          "text": "몇 번 칸이요."
        },
        {
          "b": "speech",
          "who": "담당 2",
          "text": "둘째하고 셋째. 표에는 셋째만 적혔습니다."
        },
        {
          "b": "cue",
          "text": "(종이 넘기는 소리.)"
        },
        {
          "b": "speech",
          "who": "진행",
          "text": "둘째 추가. 비 오면요."
        },
        {
          "b": "speech",
          "who": "담당 2",
          "text": "다음 건조일로 미룹니다. 물건은 안으로 먼저 넣어 주세요."
        },
        {
          "b": "speech",
          "who": "진행",
          "text": "담당자한테 전달하시고. 이어서 교육실 열쇠."
        },
        {
          "b": "cue",
          "text": "(의자 움직이는 소리. 복구 구간 종료.)"
