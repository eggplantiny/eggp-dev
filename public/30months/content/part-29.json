    {
      "kind": "record",
      "id": "0483",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 804 05:50",
      "provenance": "수집 Day 804 05:50 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 여러 엔진 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다섯 시 오십 분. 배차장 바깥. 출구 왼쪽. 사진 한 장."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "맨 앞 차가 움직였다 멈춤. 운전자가 내려 뒷문 한쪽을 다시 잠근다."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "둘째 차 뒤 상자에 분필 글씨. 빈 상자라고 적힘. 어느 공장 건지는 안 보인다."
        },
        {
          "b": "cue",
          "text": "(공회전 소리가 잠시 커짐.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "뒤에 차 한 대 더. 출구 쪽으로 안 오고 차고 옆에 선다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "첫 차 나감. 창구 안에서는 손만 보임. 종이 한 장을 뒤집는다."
        },
        {
          "b": "cue",
          "text": "(가까이 발소리. 마이크를 옮기는 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "길 비켜 달라고 해서 뒤로 나옴. 여기서는 번호판이 가린다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이 위치 사진은 더 안 찍음."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
    {
      "kind": "record",
