    {
      "kind": "record",
      "id": "0213",
      "type": "FR",
      "source": "권역 치료병동 3층 간호사실 · 상시 녹음",
      "time": "Day 111 15:00",
      "provenance": "수집 Day 112 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(간호사실. 침대 바퀴 소리가 복도에서 반복된다.)"
        },
        {
          "b": "speech",
          "who": "이관 담당",
          "text": "침상 사십, 시험 병동. 수액 거치대 스물둘, 시험 병동. 모니터 여덟, 시험 병동. 여기 서명이요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "모니터 여덟이요? 저희 층에 있는 게 아홉인데요."
        },
        {
          "b": "speech",
          "who": "이관 담당",
          "text": "목록엔 여덟이에요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "하나는 지금 사용 중이에요. 삼 호 침상. 산소 포화도 보고 있어요. 그건 못 드려요."
        },
        {
          "b": "speech",
          "who": "이관 담당",
          "text": "그럼 여덟 맞네요. 목록대로."
        },
        {
          "b": "cue",
          "text": "(펜 소리.)"
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "남는 침상은요."
        },
        {
          "b": "speech",
          "who": "이관 담당",
          "text": "스물다섯은 창고. 커튼하고 차폐는 일괄 창고. 이 층은 서른으로 운영. 그렇게 내려왔어요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "서른이면 지금 있는 분들은 다 있는 거고, 새로 오는 분은 없다는 거죠."
        },
        {
          "b": "speech",
          "who": "이관 담당",
          "text": "그건 제가 모르고요. 저는 물건만."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "알겠어요. 그건 제가 물을 데가 따로 있고요."
        },
        {
          "b": "cue",
          "text": "(침대 바퀴 소리. 멀어짐.)"
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "(다른 쪽으로) 선생님, 오 호 침상 오후 투약은 그대로예요. 명단 안 바뀌었어요. 명단은 아침에 내려오고 저는 이름 옆에 시간만 적어요. 왜 그 이름인지는 안 적혀 있고요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "간호사",
          "text": "어제 그 보호자분이 물으셨어요. 옆 침상은 받는데 왜 우리는 안 받냐고."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "옆 침상이 받는 건 제가 봤고, 왜 받는지는 저도 들은 게 없어요. 들은 게 없으면 없다고 해요. 그거밖에 못 해요."
        },
        {
          "b": "speech",
          "who": "간호사",
          "text": "그렇게 말씀드렸어요."
        },
        {
          "b": "speech",
          "who": "김민서",
          "text": "(짧게 웃음) 그 질문은 제가 여섯 시에 약 돌리고 나서도 답 못 해요. 라운딩 가요."
        },
        {
          "b": "cue",
          "text": "(발소리. 침대 바퀴 소리 계속.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0214",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 115 23:00",
      "provenance": "수집 Day 115 23:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0214.jpg",
          "alt": "책상 위에 나란히 놓인 통지서 두 장. 양식이 같고, 차수 숫자가 있는 자리만 다르다. 본문 글자는 흐리다.",
          "caption": "취재 자료 정리 중 · Day 115"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 종이 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 정리. 이번 주 폴더 둘."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하나. 문의인. 녹취 사십일 분. 회신문 사본 한 장. 접수 번호 삼백십일."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "둘. 반복 투여 대상자. 녹취 삼십팔 분. 통지서 사본 두 장. 삼 차, 사 차. 양식 같음. 숫자 한 자리 다름."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "두 장을 책상에 놓고 찍었다. 나란히. 글자는 흐리게."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "폴더 순서. 문의인, 대상자. 대상자, 문의인. 두 번 바꿨다. 어느 쪽을 먼저 놓아도 이상하다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "접수 순서대로 둔다. 그게 규칙이니까."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문의인 집에서 커피. 대상자 집에서 사과 두 알. 사과는 가방에 있다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기까지."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
