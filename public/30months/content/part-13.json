  "items": [
    {
      "kind": "record",
      "id": "0200",
      "type": "AN",
      "source": "의약품 중앙배분 전환 고시",
      "time": "Day 93 09:00",
      "provenance": "수집 Day 93 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 의약품 중앙배분 전환 고시\n\n금일부로 치료 후보 물질 및 별표 지정 의약품의 배분을 중앙배분으로 전환한다.\n\n1. 별표 품목의 시중 판매·개인 구매 경로를 폐지한다.\n2. 배분은 직무 분류·연령·관찰 적합 기준에 따른 배정 명단으로만 한다.\n3. 기존 처방 의약품은 종전 절차를 유지한다.\n4. 긴급한 사정이 있는 경우 응급 구매 신청을 할 수 있다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0201",
      "type": "BR",
      "source": "통합 채널 정시 안내",
      "time": "Day 93 12:00",
      "provenance": "수집 Day 93 12:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음)"
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "열두 시 안내입니다. 치료 후보 물질과 지정 의약품이 중앙배분으로 전환되었습니다."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "해당 품목은 배정 명단에 따라 공급되며, 개인 구매는 폐지됩니다."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "일반 처방약은 기존과 같이 약국에서 받으실 수 있습니다."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "이상입니다."
        }
      ]
    },
    {
      "personas": {
        "A": "길찾는중",
        "B": "동네주민",
        "C": "화분에물주기",
        "D": "조용히살래요",
        "E": "두아이아빠",
        "F": "손난로",
        "G": "집앞편의점"
      },
      "kind": "record",
      "id": "0202",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 94 21:00",
      "provenance": "수집 Day 95 07:00 · C-2",
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0202.jpg",
          "alt": "약국 진열대. 한 칸이 비어 있고 안내 쪽지가 붙어 있다. 글자 흐림.",
          "caption": "게시판 첨부 · Day 94"
        }
      ],
      "blocks": [
        {
          "b": "post",
          "ts": "21:00",
          "who": "A",
          "text": "아버지 드시던 약이 약국에서 사라졌습니다. 어제까지 있던 칸이 비었어요. 사진 올립니다"
        },
        {
          "b": "post",
          "ts": "21:05",
          "who": "B",
          "text": "저희 동네도요. 약사님이 이제 그 계열은 안 들어온답니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "21:09",
          "who": "C",
          "text": "안 들어오는 게 아니라 못 들어온다고 하던데요. 도매에서 아예 안 준다고요"
        },
        {
          "b": "post",
          "ts": "21:16",
          "who": "D",
          "text": "어제 고시 보셨나요. 중앙배분이라고, 명단으로만 준답니다"
        },
        {
          "b": "post",
          "ts": "21:22",
          "who": "A",
          "text": "명단에는 어떻게 오르나요",
          "re": "D"
        },
        {
          "b": "post",
          "ts": "21:26",
          "who": "D",
          "text": "그게 안 나와 있습니다. 신청하는 게 아니라 배정된다고만요",
          "re": "A"
        },
        {
          "b": "post",
          "ts": "21:38",
          "who": "E",
          "text": "응급 구매 신청이라는 게 있답니다. 행정복지센터에서 서식 받았습니다"
        },
        {
          "b": "post",
          "ts": "21:44",
          "who": "F",
          "text": "서식에 뭘 적으라고 하나요",
          "re": "E"
        },
        {
          "b": "post",
          "ts": "21:51",
          "who": "E",
          "text": "병명이랑 처방 이력이요. 그게 다예요. 적을 게 생각보다 없습니다",
          "re": "F"
        },
        {
          "b": "post",
          "ts": "22:03",
          "who": "G",
          "text": "시골 계신 부모님 약은 어떻게 되는 건가요. 거기는 약국도 하나뿐인데요"
        },
        {
          "b": "post",
          "ts": "22:11",
          "who": "B",
          "text": "배분은 권역 단위라고 합니다. 회랑 안이면 받으실 수 있을 겁니다. 안이면요",
          "re": "G"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0203",
      "type": "AN",
      "source": "구매 문의 회신 · 수신자 사본",
      "time": "Day 96 10:00",
      "provenance": "수집 Day 96 10:00 · C-1",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "회신\n\n문의 요지: 별표 품목의 가격 및 구매 가능 여부. 수량 무관. 조건 무관.\n\n회신: 본 품목은 판매 대상이 아닙니다.\n\n이의가 있는 경우 30일 이내에 서면으로 제출할 수 있습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0204",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 99",
      "provenance": "수집 Day 99 · C-2",
      "attribution": {
        "subject": "구매 문의인",
        "interviewer": "윤재경",
        "purpose": "의약 배분 전환 기록수집",
        "testimonyTime": "Day 99 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문의를 넣으신 경위부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "저는 평생 필요한 걸 사 왔습니다. 좋은 의사, 좋은 약, 좋은 병원. 초기에는 그게 됐어요. 안 되는 게 없었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "언제부터 안 됐습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "전환 고시 나오고요. 늘 하던 대로 사람을 통해서 알아봤는데, 이번엔 통할 사람이 없다는 답이 왔어요. 그래서 정식으로 문의를 넣었습니다. 조건 무관이라고 썼어요. 무슨 뜻인지 아시겠지요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "회신을 받으셨습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "한 줄이요. 판매 대상이 아닙니다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "담당자를 찾아가서 재산 전부를 내놓겠다고 했습니다. 진심이었어요. 그분이 미안한 얼굴로 그러더군요. 파는 물건이 아니라서 받을 돈이 없다고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 말을 어떻게 들으셨습니까."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "화가 나야 하는데, 이상하게 화가 안 났습니다. 계산이 안 서는 게 처음이라서요. 평생 모든 게 계산이 섰거든요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "지금도 이해는 안 됩니다. 세상에 값이 없는 물건이 어디 있습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "있더군요. 이제 압니다. 이해가 안 될 뿐이에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "초기에는 어떠셨는지 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "초기에는 다 됐지요. 병상이 없다길래 병상을 만들었습니다. 의료진이 지쳤다길래 수당을 얹었고요. 그때는 제가 쓸모가 있었어요. 돈이 일을 했으니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금은요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "지금은… 통장에 숫자가 있는데, 그 숫자가 아무 데도 연결이 안 돼요. 전화기가 있는데 불통인 것처럼요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "요즘은 아침에 마당을 씁니다. 마당 쓰는 건 아직 제 마음대로 되거든요. 기사도 경비도 다 보내고 나니까 마당이 넓더군요. 그걸 이제 알았습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0205",
      "type": "LG",
      "source": "중앙배분 주간 대장",
