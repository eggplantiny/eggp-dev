    },
    {
      "kind": "record",
      "id": "0327",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 377",
      "provenance": "수집 Day 377 · C-2",
      "attribution": {
        "subject": "타 회랑 정비사",
        "interviewer": "윤재경",
        "purpose": "설비 운영 기록수집",
        "testimonyTime": "Day 377 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그쪽 회랑의 겨울을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "우리는 큰 걸 세 개 부쉈어요. 재작년에 하나, 작년에 둘. 압축기 계열요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어떻게 부서졌습니까."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "순서를 몰랐어요. 겨울 기동 순서요. 매뉴얼대로 했는데 매뉴얼이 겨울을 몰랐던 거예요. 아는 사람들은… 그때 이미 없었고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "첫 번째가 부서졌을 때를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "그때는 불량인 줄 알았어요. 기계 탓을 했지요. 두 번째 부서지고 나서야 우리 탓인가 했고. 기계는 두 번 같은 방식으로 안 죽어요. 같은 방식으로 두 번 죽으면 그건 기계가 아니라 사람 문제예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 순서를 지금은 아십니까."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "알아요. 우리가 이걸 배운 방식은 세 번 부수고 나서예요."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "세 번요. 한 번 부수고 몰랐고, 두 번 부수고 짐작했고, 세 번째에 확실해졌어요. 수업료로 압축기 세 대. 비싸죠."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "왜 미리 알 수 없었는지를 여쭙겠습니다."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "그걸 저도 생각해요. 아무도 못 봤던 건지. 누가 알고도 말을 안 했던 건지. 아니면 물어볼 사람이 그때 이미 없었던 건지."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "셋 중 뭔지 지금도 몰라요. 구분이 안 돼요. 결과가 똑같아서요. 셋 다, 아무도 말해주지 않았다는 점에서는 같아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금은 그 순서를 어떻게 관리하십니까."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "벽에 적어놨어요. 크게. 그리고 매년 첫 한파 전날, 전원 모아서 소리 내서 읽어요. 한 명씩 돌아가면서요. 유난이라는 거 알아요. 근데 우리는 세 대 값을 냈잖아요. 유난할 자격이 있어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 순서를 다른 회랑에 전하셨습니까."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "전했어요. 이관 문서로도 보내고, 사람이 갈 일 있으면 입으로도 전하고. 받는 쪽이 믿는지는 몰라요. 안 부숴본 데는 순서가 왜 중요한지 몰라요. 우리도 몰랐으니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "마지막으로 하실 말씀이 있습니까."
        },
        {
          "b": "speech",
          "who": "정비사",
          "text": "여기는 아직 안 부순 것 같던데. 그럼 여기 어딘가에 아는 사람이 아직 있는 거예요. 있을 때 물어보세요. 그 말 하러 온 거예요, 사실은."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0328",
      "type": "FR",
      "source": "운휴 기계실 · 상시 녹음",
      "time": "Day 379 10:20",
      "provenance": "수집 Day 380 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(기계실. 구동음 없음)"
        },
        {
          "b": "silence",
          "sec": 120,
          "note": "바람 소리. 함석 우는 소리"
        },
        {
          "b": "cue",
          "text": "(물 떨어지는 소리. 간격을 두고)"
        },
        {
          "b": "silence",
          "sec": 90
        },
        {
          "b": "cue",
          "text": "(발소리. 손전등 스위치 소리)"
        },
        {
          "b": "speech",
          "who": "순찰",
          "text": "(혼잣말, 작게) 이상 무. …이상이 없긴 뭐가 없어. 서 있는 게 이상인데."
        },
        {
          "b": "cue",
          "text": "(수첩에 적는 소리. 발소리 두어 걸음. 멈춤)"
        },
        {
          "b": "speech",
          "who": "순찰",
          "text": "(혼잣말) …물받이나 갈아줘야겠다. 떨어지는 자리가 파이겠어."
        },
        {
          "b": "cue",
          "text": "(발소리 멀어짐)"
        },
        {
          "b": "silence",
          "sec": 200,
          "note": "물 떨어지는 소리"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0329",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 381 15:00",
      "provenance": "수집 Day 381 15:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0329.jpg",
          "alt": "방수포 덮인 압축기들. 끈이 바람에 흔들린다.",
          "caption": "운휴 설비 야적장 · Day 381"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 바람)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 운휴 야적장. 열다섯 시."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "방수포 덮인 것 열넷. 덮이지 않은 것 셋."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "방수포 끈이 바람에 운다. 열넷이 다 같이 우니까 소리가 크다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "라벨을 읽는다. 압축기 C-4. 권역 산소. 지난주 명단에서 본 이름이다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "야적장 구석에 새로 온 것 둘. 방수포가 아직 안 덮였다. 눈이 먼저 덮는 중이다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "관리인이 방수포가 모자란다고 했다. 다음 주에 온다고 했다. 오는 것과 있는 것 — 적다가 만다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 열넷이 다 들어가게."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
