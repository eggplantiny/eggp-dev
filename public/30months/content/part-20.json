    {
      "kind": "record",
      "id": "0337",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 398 22:00",
      "provenance": "수집 Day 398 22:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0337.jpg",
          "alt": "눈 내린 밤거리. 가로등 하나 건너 하나.",
          "caption": "두 번째 겨울 · Day 398"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 창문 여는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 눈. 첫눈은 아니고, 많이 오는 건 오늘이 처음이다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "첫해 수첩을 꺼냈다. 삼백육십몇 일 전 오늘 자리를 폈다. 읽었다. 도로 덮었다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그때 글씨가 지금 글씨보다 크고, 그때 문장이 지금 문장보다 길다. 그것만 적는다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "올해 수첩에 적는다. 눈. 조용함. 보일러 소리 정상."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "가로등이 하나 건너 하나만 켜져 있다. 절전 공고대로다. 눈 위에 불빛이 반씩 떨어진다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "골목 끝 보일러 연통들이 김을 낸다. 세어 본다. 여섯 집 중 여섯. 다 돈다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 창문에서."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
  ]
