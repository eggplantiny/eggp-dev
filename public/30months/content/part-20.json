      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "설비 정지 명단",
          "rows": "압축기 C-4        권역 산소     361일 05:40\n펌프 P-11         정수 2계통    362일 06:10\n펌프 P-3          난방 순환     362일 21:35\n인버터 V-7        배수장       363일 14:00\n펌프 P-19         정수 1계통    364일 05:55\n제어기 K-2        광산 권상     364일 11:20\n압축기 C-1        산업가스     364일 16:45",
          "note": "계 7기. 원인 칸: 베어링 4 · 씰 2 · 소자 1."
        }
