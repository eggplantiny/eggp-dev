    {
      "kind": "record",
      "id": "0335",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 394",
      "provenance": "수집 Day 394 · C-2",
      "attribution": {
        "subject": "시민 (권역 북부 단지)",
        "interviewer": "기록수집 4반",
        "purpose": "생활 기록수집",
        "testimonyTime": "Day 394 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "올겨울을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "작년보다 나아요. 물 나오고, 배급 있고. 근데 무서운 게 하나 있는데, 소리예요."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "어떤 소리입니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "보일러 소리요. 작년 겨울엔 사람이 무서웠어요. 올해는 보일러가 이상한 소리를 내면 심장이 내려앉아요. 이게 서면 큰일이라는 걸 이제 아니까."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "소리가 이상하면 어떻게 하십니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "옆집 불러요. 옆집 아저씨가 소리를 좀 알아요. 서로 봐줘요. 우리 라인 여섯 집이 보일러 소리 품앗이를 해요. 이런 품앗이가 생길 줄 몰랐지요."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "그 아저씨는 어떤 분입니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "원래 공장 다니시던 분이에요. 지금도 다니시고. 저녁에 퇴근하고 오시면 라인을 한 바퀴 돌아요. 문 앞에서 귀만 대보고 가요. 초인종도 안 눌러요. 이상 있으면 그때만 눌러요."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "답례는 어떻게 하십니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "김치요. 그리고 그 집 애 숙제를 우리 큰애가 봐줘요. 품앗이는 물레방아처럼 돌아야 오래가요. 어른들이 그러셨는데 맞는 말이에요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "그 아저씨가 그래요. 소리 봐주는 건 어렵지 않다고. 어려운 건 자기가 없을 때래요. 그래서 요즘 우리 큰애한테 소리를 가르쳐요. 열네 살짜리가 보일러 소리를 배워요."
        }
      ]
    },
