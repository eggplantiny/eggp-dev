      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 멀리 번호 부르는 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 반환 창구 복도. 열다섯 시 사십 분. 긴 의자 하나. 사진 둘."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "봉투 든 사람 열하나. 전화기 보는 사람 셋. 둘 다인 사람 둘."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "옆자리. 봉투를 두 번 열었다 닫음. 종이 그대로 있음. 손만 찍음."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "번호 불림. 한 사람 일어나고, 옆 사람도 따라 일어났다 앉음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "전화기 보던 사람 하나. 화면에 부고 문자. 읽고 닫고 봉투 만짐. 번호 불려서 일어남."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "같은 의자. 봉투 하나, 전화기 하나."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오늘 자료. 이력 대장 사본 한 장. 서명란 빔. 따로 접음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기까지."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
