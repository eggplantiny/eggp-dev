        }
      ]
    },
    {
      "kind": "record",
      "id": "0401",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 558 11:20",
      "provenance": "수집 Day 558 11:20 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 시장 소음.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 열한 시 이십 분. 창구 뒷골목."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "손수레 하나. 보냉 상자 넷. 끈 두 번. 사진 한 장."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "창구 앞 줄. 셌다. 열하나. 남자 열하나. 말 없음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오는 길에 남자 둘 지나침. 창구 방향. 시계를 봤다. 열한 시 십 분."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "시계를 본 이유. 적어 둔다. 월요일이라서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다음. 반장 면담 목요일 세 시. 질문지에서 뺀 것 하나. 집."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기까지."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0402",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 562 15:00",
      "provenance": "수집 Day 562 17:10 · C-2",
      "attribution": {
        "subject": "○○석유화학 반장",
        "interviewer": "윤재경",
        "purpose": "산업 운영 기록수집",
        "testimonyTime": "Day 562 15:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그때 여기서는 무엇이 끊겼는지부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "열세 달째요."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "촉매가 늦었고요. 그다음은 안 끊겼어요. 늦은 거하고 끊긴 거는 다르니까요. 늦으면 돌리는 걸 줄이고, 끊기면 세우고. 세운 적은 없어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "줄인 동안은 어떻게 하셨습니까."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "사 호기만 돌렸어요. 삼 호기는 제가 세 번 잘못 잠근 자리가 있는데, 그 자리를 그때 다시 봤어요. 세운 김에요. 네 번째부터는 안 틀렸고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금 맡고 계신 범위를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "우리 반 여덟. 옆 반 일곱. 옆 반은 반장이 새로 서서, 제가 옆에 서 있는 거예요. 물어보면 답하고요. 안 물어보면 안 해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "반의 구성을 여쭤도 되겠습니까."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "구성이요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "열다섯이에요. 제일 어린 애가 스물둘. 걔가 이번 달부터 새로 온 애를 봐요. 그게 다예요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하루가 몇 시에 시작합니까."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "다섯 시 반요. 아버지 약 챙기고, 할머니 앉혀 드리고, 여섯 시 십 분 버스. 야간 주간에는 낮에 두 분 점심을 해 놓고 자요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아버님은요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "월요일에 창구 가세요. 혼자 가세요. 제가 같이 간 건 처음 한 번이고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 뒤로는 혼자 가시는군요."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "네. 가시는 동안은 제가 안 물어요. 오시면 수령증만 봐요. 도장 찍혔나. 그것만."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "물어볼 게 더 있으세요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "전임자에 대해 한 가지 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "잘해 주셨어요."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "정혜원",
          "text": "그 어른이 커피 타 주던 컵이 아직 제어실에 있어요. 아무도 안 써요. 그건 적어도 돼요."
        }
      ]
    },
