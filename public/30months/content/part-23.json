      "media": [
        {
          "type": "image",
          "src": "/30months/m/0388.jpg",
          "alt": "회관 큰 솥과 제각각인 그릇 열둘. 상 한쪽 끝에 아이들 공책이 포개져 있다. 사람은 등과 팔만 걸린다.",
          "caption": "수집 방문 촬영 · 마을회관 · Day 478"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 실내. 솥뚜껑 소리.)"
        },
        {
          "b": "speech",
          "who": "총무",
          "text": "오늘 열둘. 상 하나 더."
        },
        {
          "b": "speech",
          "who": "학부모",
          "text": "공책 저쪽으로 밀어. 먹고 나서 마저 해."
        },
        {
          "b": "cue",
          "text": "(아이들 소리. 공책 미는 소리.)"
        },
        {
          "b": "speech",
          "who": "총무",
          "text": "호박은 샘골 밭. 된장은 작년 거 마지막. 콩 되면 새로 담가야 돼."
        },
        {
          "b": "speech",
          "who": "학부모",
          "text": "이번 콩은 몇 집이 심었어."
        },
        {
          "b": "speech",
          "who": "총무",
          "text": "셋. 새로 온 집 하나 포함."
        },
        {
          "b": "cue",
          "text": "(그릇 놓는 소리. 숟가락 소리.)"
        },
        {
          "b": "speech",
          "who": "학부모",
          "text": "다음 주 지붕 이는 집, 셋만 더 있으면 하루에 끝나."
        },
        {
          "b": "speech",
          "who": "총무",
          "text": "우리 집 둘. 나절로 달아 놔."
        },
        {
          "b": "speech",
          "who": "학부모",
          "text": "반 나절 아니고?"
        },
        {
          "b": "speech",
          "who": "총무",
          "text": "두 달 지났어. 한 나절이야."
        },
        {
          "b": "cue",
          "text": "(웃음. 아이가 외치는 소리.)"
        },
        {
          "b": "speech",
          "who": "학부모",
          "text": "뛰지 말고. 먹고 뛰어."
        },
        {
          "b": "silence",
          "sec": 30,
          "note": "숟가락 소리. 아이들 소리"
        },
        {
          "b": "speech",
          "who": "총무",
          "text": "보건소 다음 오는 날 게시판에 붙였어. 열흘 뒤."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료.)"
        },
        {
          "b": "cut"
        }
      ]
    },
