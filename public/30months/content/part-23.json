  "items": [
    {
      "kind": "record",
      "id": "0374",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 455",
      "provenance": "수집 Day 455 · C-2",
      "attribution": {
        "subject": "통합 보존고 운영 담당",
        "interviewer": "윤재경",
        "purpose": "보존망 운영 기록수집",
        "testimonyTime": "Day 455 10:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "어느 날요?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "반입이 끝난 날요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "검수를 했어요. 목록하고 실물하고. 이틀 걸렸어요. 하나하나 번호 대조하고, 온도 이력 확인하고. 밤에 퇴근하는데 다리가 후들거리더라고요. 안 맞을까 봐요. 다 맞았어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금의 하루를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아침에 잔량 재고, 계기 돌아보고. 예전엔 시설마다 하던 일을 이제 한 지붕에서 해요. 동선은 짧아졌는데 책임은 넓어졌지요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "반입 목록에서 한 곳이 비어 있습니다. 미이송 한 곳. 사유 칸이 비어 있는데요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "네. 저희도 그 칸은 빈 채로 받았어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "누가 채울 수 있는 칸입니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "저희가 답할 자리가 아닙니다. 저희는 온 것을 지키는 데예요. 안 온 것에 대해서는… 저희 장부엔 칸이 없어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 빈 칸이 채워지기를 바라십니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "바라죠. 장부 하는 사람은 빈 칸을 못 견뎌요. 근데 제가 채우면 그건 장부가 아니라 소설이에요. 아는 사람이 채워야죠. 어딘가에 있겠죠, 아는 사람이."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0375",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 455",
      "provenance": "수집 Day 455 · C-2",
      "attribution": {
        "subject": "통합 보존고 충전 담당",
        "interviewer": "윤재경",
        "purpose": "보존망 운영 기록수집",
        "testimonyTime": "Day 455 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "충전은 어떻게 돌아가고 있습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "열흘에 한 번요. 공급이 돌아온 뒤로는 밀린 적 없어요. 저번 겨울 같은 일은, 당분간은 없을 거라고들 해요. 당분간이라는 말이 붙는 게 요즘 말버릇이에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "잔량 관리를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아침저녁으로 재요. 수치가 예정선 위에 있으면 그날은 좋은 날이에요. 좋은 날이 두 달째 이어지고 있어요. 이런 것도 기록에 남겨 주세요. 좋은 날도요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "남기겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "고맙습니다. 나쁜 날만 남으면, 나중에 보는 사람들이 우리가 늘 지고만 있었다고 알 거 아니에요. 이기는 날도 있었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이기는 날은 어떤 날입니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "아무 일 없는 날요. 계기 보고, 적고, 퇴근하는 날. 그게 이기는 거예요, 이 일은. 지는 날은 하루면 다 무너지는데, 이기는 날은 하루씩밖에 못 이겨요. 그래서 매일 나와요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0376",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 456 21:30",
      "provenance": "수집 Day 456 21:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "두 건 정리 끝. 녹취 풀고 파일 번호 붙였다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "내일은 농촌. 자전거로 한 시간. 여섯 시 반 출발. 질문지는 만들어 둔 것 그대로 쓴다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0377",
      "type": "AN",
      "source": "귀농·귀촌 임시 배정 안내",
      "time": "Day 457 09:00",
      "provenance": "수집 Day 457 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 귀농·귀촌 임시 배정 안내\n\n1. 정비된 빈집과 휴경 농지를 희망자에게 임시 배정한다.\n2. 신청은 읍면 창구에서 받는다. 기한 없음.\n3. 배정 후 두 계절 경작 시 연장을 우선한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0378",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 458",
      "provenance": "수집 Day 458 · C-2",
      "attribution": {
        "subject": "마을 촌로",
        "interviewer": "윤재경",
        "purpose": "농촌 생활 기록수집",
        "testimonyTime": "Day 458 11:00"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0378.jpg",
          "alt": "돌우물과 수동 펌프. 펌프 손잡이가 닳아 반질하다.",
          "caption": "마을 공동 우물 · Day 458"
        }
      ],
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "어느 날?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "우물을 다시 연 날요."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "아침에 두레박부터 내렸지. 삼십 년 만에. 물이 올라오는데, 냄새를 맡아 보니까 옛날 그 물이야. 쇠 냄새 조금 나고, 차고. 동네 사람들이 다 한 모금씩 마셨어. 검사는 나중에 받았고. 합격했어."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수도가 끊긴 뒤의 일입니까."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "끊긴 게 아니고, 오다 말다 해. 오다 말다 하는 물은 못 믿어. 우물은 늘 있어. 전기도 기름도 안 들고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "요즘 마을의 형편을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "여긴 오히려 전보다 좀 낫습니다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "낫다는 것은 어떤 뜻입니까."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "물이 다시 나오고. 밭이 남아돌고. 집도 남고. 도시서 몇 집 내려왔어. 애 소리도 나고. 우리야 원래 없이 살던 사람들이라, 없는 게 늘어난 건지 있는 게 늘어난 건지… 헷갈리는데, 살기는 나아. 그건 맞아."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "없이 살던 방식이 도움이 되었습니까."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "도움이 아니라 그게 전부지. 소 부리는 법, 종자 받는 법, 두레 도는 법. 그거 다 버린 동네들은 지금 배우러 다녀. 우리는 안 버렸어. 게을러서 안 버린 건데, 지금 와서는 잘한 게 됐어. (웃음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어려운 점은 없으십니까."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "왜 없어. 약이 없지. 무릎 약, 혈압 약. 보건소가 한 달에 두 번 와. 오는 날은 잔칫날이야. 그리고 부고가 와도 갈 수가 없어. 먼 데 부고는 편지로만 받아. 가서 곡도 못 하고. 그게 어렵지. 사는 건 살아져. 못 가는 게 어려워."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "마지막으로 하실 말씀이 있습니까."
        },
        {
          "b": "speech",
          "who": "촌로",
          "text": "우물 물 한 모금 마시고 가. 기록하는 사람이면 물맛도 기록해야지. 글로 어떻게 쓸지는 모르겠는데. (웃음)"
        }
      ]
    },
