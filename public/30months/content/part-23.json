  "items": [
    {
      "kind": "record",
      "id": "0374",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 455 10:00",
      "provenance": "수집 Day 455 12:30 · C-2",
      "attribution": {
        "subject": "한지연 · 권역 통합 보존고 운영",
        "interviewer": "윤재경",
        "purpose": "보존망 운영 기록수집",
        "testimonyTime": "Day 455 10:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "어느 날요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "반입이 끝난 날요."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "검수요. 용기 다섯. 번호 다섯 대조. 온도 이력 다섯 장. 봉인 다섯. 이틀 걸렸어요. 하나에 반나절."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이틀은 긴 편입니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "짧으면 안 되는 일이에요. 하나, 둘, 셋, 넷, ~5  …다섯. 다 맞았어요. 그날 저녁에 일지에 맞았다고 적었어요. 맞았다는 칸이 원래는 없는데, 비고에 적었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금의 하루를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "여덟 시 잔량. 큰 탱크 넷, 반입 용기 다섯. 아홉이요. 전에는 넷이었어요. 계기 아홉 개 읽고, 아홉 줄 적고. 그다음 전화."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "전화는 그대로입니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "같은 번호, 같은 시간이요. 다음 차가 며칠입니까. 지금은 답이 날짜로 와요. 그러면 날짜를 적어요. 열흘 뒤면 열흘 뒤라고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "반입 목록에서 한 곳이 비어 있습니다. 미이송 한 곳. 사유 칸이 공란인데요."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "네. 저희도 공란으로 받았어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 칸은 누가 채울 수 있는 칸입니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "저희가 답할 자리가 아닙니다."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "저희 장부엔 온 것만 있어요. 용기 다섯, 번호 다섯. 안 온 건 줄이 없어요. 줄이 없는 건 못 세요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그러면 그 시설은 어디에 적힙니까."
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "목록에요. 목록은 저희 게 아니에요. 저희는 목록을 받는 쪽이에요."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "한지연",
          "text": "여섯 곳이었고, 다섯이 왔어요. 다섯은 셌어요. 하나는, ~5  …하나는 안 셌어요. 셀 게 안 왔으니까요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0375",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 455 14:00",
      "provenance": "수집 Day 455 16:00 · C-2",
      "attribution": {
        "subject": "권역 통합 보존고 충전·계기 담당",
        "interviewer": "윤재경",
        "purpose": "보존망 운영 기록수집",
        "testimonyTime": "Day 455 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "충전 담당",
          "text": "7일요? 충전차 사일칠삼이 열 시 이십 분에 들어왔어요. 호스 연결, 밸브, 계기. 천팔백 들어갔고요. 열한 시에 잔량 천구백십이. 기사님이 서명하고 갔어요. 그게 다예요. 그날은 그게 다였어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 뒤로는요."
        },
        {
          "b": "speech",
          "who": "충전 담당",
          "text": "열흘에 한 번. 17일, 27일, 이번 달 7일. 다 왔어요. 세 번 다 사일칠삼이었어요. 기사님도 같은 분. 저는 차 번호로 외워요. 사람 이름은 잘 못 외우고 차 번호는 한 번 보면 안 잊어요. 전에 충전소에서 팔 년 그 일을 해서요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "잔량 관리를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "충전 담당",
          "text": "아침저녁 두 번 재요. 예정선이 있어요. 일지에 줄 하나 그어 놓고, 그 위면 동그라미, 아래면 세모. 지난달부터 동그라미만이에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "세모였던 때를 기억하십니까."
        },
        {
          "b": "speech",
          "who": "충전 담당",
          "text": "그때는 제가 없었어요. 저는 반입 다음 주에 왔어요. 일지에 세모가 쭉 있는 걸 봤어요. 그건 제 글씨가 아니에요. 운영 담당님 글씨예요. 세모 그리는 손이 어땠는지는 제가 몰라요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다음 충전은요."
        },
        {
          "b": "speech",
          "who": "충전 담당",
          "text": "17일. 사일칠삼. 열 시. 전화로 확인했어요. 확인한 건 확인했다고 적어요. 안 오면 그때 세모 그리면 되고요."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "충전 담당",
          "text": "동그라미 그리는 날은 할 일이 없는 날이에요. 계기 읽고, 적고, 문 잠그고 가는 날. 그 날들도 적히는 거죠? 세모만 적히면 안 되잖아요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0376",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 456 21:30",
      "provenance": "수집 Day 456 21:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 스물한 시 삼십 분."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "두 건 정리. 녹취 사십일 분, 이십육 분. 파일 번호 붙임."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "질문지 두 장. 마지막 질문 둘 다 사유 칸. 답 하나. 답할 자리가 아니라는 답."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "내일 농촌. 여섯 시 반 출발. 자전거. 한 시간. 질문지 그대로."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "첫 질문 같음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기까지."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0377",
      "type": "AN",
      "source": "귀농·귀촌 임시 배정 안내 · 읍면 게시분",
      "time": "Day 457 09:00",
      "provenance": "수집 Day 457 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 귀농·귀촌 임시 배정 안내\n\n정비된 빈집과 휴경 농지를 희망자에게 임시 배정한다.\n\n1. 신청은 읍면 창구에서 받는다. 기한을 두지 않는다.\n2. 배정 후 두 계절 경작한 세대는 연장을 우선한다.\n3. 농지 배정은 마을 경작 배정 대장에 따른다.\n4. 빈집 배정은 정비 완료 호수 공고 후 별도로 한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0378",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 458",
      "provenance": "수집 Day 458 · C-2",
      "attribution": {
        "subject": "마을 이장",
        "interviewer": "윤재경",
        "purpose": "농촌 생활 기록수집",
        "testimonyTime": "Day 458 11:00"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0378.jpg",
          "alt": "돌우물과 그 옆 수동 펌프. 펌프 손잡이가 잡는 자리만 닳아 반질하다. 덮개는 닫혀 있다.",
          "caption": "면담 대상 제공 · 마을 공동 우물 · Day 458"
        }
      ],
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "어느 날 말이오."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "우물을 다시 연 날요."
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "두레박 내렸지요. 아침에. 물이 올라왔어요. 냄새 맡았지요. 쇠 냄새 조금. 차고. 한 모금씩 돌렸어요. 열둘이 마셨어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "검사는요."
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "나중에 받았어요. 됐다고 종이 왔어요. 8일 자로."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수도는 어떻습니까."
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "오다 말다 해요. 오다 말다 하는 건 물이 아니지요. 우물은 늘 있어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "요즘 마을 형편을 여쭙겠습니다."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "여긴 오히려 전보다 좀 낫습니다."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "물이 나고. 밭이 남고. 집이 남고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "남는다는 것은요."
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "사람이 적으니께."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "그 말이 좋은 말은 아니지요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "우물이 셋이오. 안말, 샘골, 회관 앞. 셋 다 물이 나요. 펌프는 둘. 하나는 손잡이를 갈았고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "마을 대장은 이장님이 적으십니까."
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "서기가 적어요. 세대하고 밭하고 집. 그것만 적어요. 작년에 적던 대로."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다른 것은 적지 않으십니까."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "이장",
          "text": "물 한 모금 하고 가시오. 지금 뜬 거요."
        },
        {
          "b": "cue",
          "text": "(두레박 소리. 물 따르는 소리.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0379",
      "type": "LG",
      "source": "마을 우물 사용 대장",
      "time": "Day 458 15:00",
      "provenance": "수집 Day 458 16:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "우물 사용 대장",
          "rows": "재개 우물        3곳 (안말 · 샘골 · 회관 앞)\n수동 펌프        2대 (회관 앞 · 손잡이 교체 1)\n수질 확인        8일 · 적합\n다음 확인        다음 달 8일",
          "note": "두레박 사용 후 덮개를 닫을 것.\n회관 앞 펌프는 스무 번 이상 연속으로 젓지 말 것."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0380",
      "type": "FR",
      "source": "안말 감자밭 · 현장 녹음",
      "time": "Day 460 06:40",
      "provenance": "수집 Day 461 10:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실외. 새소리. 흙 파는 소리 여럿.)"
        },
        {
          "b": "speech",
          "who": "밭 주인",
          "text": "그 두둑은 소가 터요. 손 대지 말고. 소 오면 뒤에서 줍기만 해요."
        },
        {
          "b": "speech",
          "who": "새 일손",
          "text": "이건요."
        },
        {
          "b": "speech",
          "who": "밭 주인",
          "text": "그건 상처 난 거. 따로. 그건 오늘 먹어요."
        },
        {
          "b": "cue",
          "text": "(워낭 소리. 쟁기가 흙을 가르는 소리. 감자가 굴러 나오는 소리.)"
        },
        {
          "b": "speech",
          "who": "소 모는 이",
          "text": "비켜요. 서지 말고 비켜요."
        },
        {
          "b": "speech",
          "who": "밭 주인",
          "text": "줍는 사람은 소 뒤로. 앞으로 가면 안 돼요."
        },
        {
          "b": "silence",
          "sec": 40,
          "note": "감자 줍는 소리. 자루에 넣는 소리"
        },
        {
          "b": "speech",
          "who": "새 일손",
          "text": "이 자루 다 찼어요."
        },
        {
          "b": "speech",
          "who": "밭 주인",
          "text": "그럼 저쪽. 캔 데는 오후에 들깨 모 넣어요. 물 주고 넣어요. 물부터."
        },
        {
          "b": "speech",
          "who": "새 일손",
          "text": "물은 어디서요."
        },
        {
          "b": "speech",
          "who": "밭 주인",
          "text": "안말 우물. 스무 번 넘게 젓지 말고. 스물 세고 쉬고."
        },
        {
          "b": "speech",
          "who": "소 모는 이",
          "text": "다음 두둑."
        },
        {
          "b": "cue",
          "text": "(워낭 소리. 흙 가르는 소리. 멀리 닭 우는 소리.)"
        },
        {
          "b": "speech",
          "who": "밭 주인",
          "text": "새참은 아홉 시. 회관에서 가져와요. 그때까지 두 두둑."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0381",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 461 13:00",
      "provenance": "수집 Day 461 15:00 · C-2",
      "attribution": {
        "subject": "마을 이장",
