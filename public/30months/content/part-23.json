    {
      "kind": "record",
      "id": "0387",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 475 14:00",
      "provenance": "수집 Day 475 16:00 · C-2",
      "attribution": {
        "subject": "농기구 수리 · 안말",
        "interviewer": "윤재경",
        "purpose": "농촌 기술 기록수집",
        "testimonyTime": "Day 475 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "요즘 고치시는 것을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "호미, 쟁기 날, 리어카 바퀴, 펌프. 경운기는 안 고쳐. 기름이 없는데 고쳐서 뭐 해."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "원래 하시던 일입니까."
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "영감이 했어. 나는 옆에서 봤고. 오십 년. 손이 기억하는 게 아니고 눈이 기억해. 영감 손이 어디부터 갔는지."
        },
        {
          "b": "cue",
          "text": "(연장 집는 소리.)"
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "이거. 쟁기 날은 여기부터 갈아. 끝부터 갈면 날이 죽어. 도시서 온 색시가 끝부터 사흘을 갈았어. 반이 됐어."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 뒤에는요."
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "다시 가르쳤지. 지금은 나보다 나아. 팔이 젊으니께."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "고칠 수 없는 것은 무엇입니까."
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "용수철. 펌프에 하나 들어가. 강이 달라서 여기선 못 만들어. 그게 나가면 펌프가 끝이야. 그래서 스무 번 넘게 젓지 말라고 써 붙였어. 내가 쓴 거야, 그거."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "소는요."
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "소는 안 고쳐. 고장이 없어. 배고프고 아플 뿐이지. 배고픈 건 먹이고 아픈 건 쉬게 하고."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "수리공",
          "text": "영감 연장이 창고에 그대로 있어. 하나씩 꺼내 써. 다 꺼내면 끝인데, 아직 반 남았어."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0388",
      "type": "FR",
      "source": "마을회관 · 저녁 녹음",
      "time": "Day 478 18:30",
      "provenance": "수집 Day 479 10:00 · C-2",
      "preservation": "partial",
      "damage": {
