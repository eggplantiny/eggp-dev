    {
      "kind": "record",
      "id": "0445",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 674",
      "provenance": "수집 Day 674 · C-2",
      "attribution": {
        "subject": "재배치 엔지니어",
        "interviewer": "윤재경",
        "purpose": "산업 기록수집",
        "testimonyTime": "Day 674 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "옮기신 지 얼마나 되셨습니까."
        },
        {
          "b": "speech",
          "who": "엔지니어",
          "text": "두 계절요. 첨단 쪽에서 표준 모터 라인으로 왔어요. 처음엔 솔직히, 유배 같았어요. 제가 하던 게 백이라면 여기는 이십쯤 되는 기술이라고 생각했으니까요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "지금은 어떻습니까."
        },
        {
          "b": "speech",
          "who": "엔지니어",
          "text": "생각이 바뀌었어요. 여기 기계는 제가 끝까지 이해해요. 축부터 권선까지, 어디서 왜 죽는지, 어떻게 살리는지, 전부요. 전에 하던 건 제가 백 중에 여섯을 알았어요. 나머지 아흔넷은 장비랑 소프트웨어랑 외국 어딘가를 믿는 거였고요. 지금 저는 이십을 다 알아요. 여섯보다 이십이 커요. 산수가 그래요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "아쉬움은 없습니까."
        },
        {
          "b": "speech",
          "who": "엔지니어",
          "text": "있죠. 제가 배운 제일 예쁜 수학은 이제 쓸 데가 없어요. 가끔 종이에 끄적여요. 잊어버리지 않게. 쓸 데없는 걸 잊지 않는 것도 일이라고, 문서고 쪽 분이 그러더라고요. 그 말이 위로가 됐어요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0446",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 678",
      "provenance": "수집 Day 678 · C-2",
      "attribution": {
        "subject": "권역 문서고 보존 담당",
        "interviewer": "윤재경",
        "purpose": "기록 보존 기록수집",
        "testimonyTime": "Day 678 10:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "문서고에서 하시는 일을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "들어오는 상자를 열고, 목록 만들고, 서가에 꽂아요. 지금까지 삼백마흔한 상자요. 도면, 공정서, 교육 영상, 실험 일지. 만들 수 없게 된 것들의 종이만 여기 다 모여요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "만들 수 없는 것을 왜 보존합니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "그 질문을 자주 받아요. 제 대답은 정해져 있어요. 못 만드는 건 지금이지, 영원이 아니에요. 그리고 설령 영원히 못 만들어도, 우리가 뭘 할 수 있었는지는 남아야 해요. 그건 만들 수 있냐 없냐하고 다른 문제예요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "서가를 찾는 사람이 있습니까."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "있어요. 생각보다요. 표준 공정 쪽 사람들이 와요. 옛 도면에서 부분만 떼서 써요. 통째로는 못 만들어도 모서리는 쓸모가 있거든요. 저는 그럴 때 제일 기뻐요. 죽은 종이가 아니라는 증거니까요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "보존 담당으로 마지막 말씀이 있다면요."
        },
        {
          "b": "speech",
          "who": "담당",
          "text": "여기는 무덤이 아니에요. 씨앗 창고에 가까워요. 심을 땅이 지금 없을 뿐이에요. 저는 습도만 지켜요. 땅은 다음 사람들 몫이고요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0447",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 681",
      "provenance": "수집 Day 681 · C-2",
      "attribution": {
        "subject": "원로 설계자",
        "interviewer": "윤재경",
        "purpose": "기술 기록수집",
        "testimonyTime": "Day 681 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "오늘 도면을 직접 가져오셨습니다."
        },
        {
          "b": "speech",
          "who": "설계자",
          "text": "마지막 상자예요. 사십 년 치 중에 이게 마지막. 남한테 맡기면 순서가 엉켜요. 도면은 순서가 반이에요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "상자를 넣으실 때 어떠셨습니까."
        },
        {
          "b": "speech",
          "who": "설계자",
          "text": "시원섭섭이라는 말이 있는데, 오늘은 시원이 조금 더 컸어요. 얘들이 갈 데가 생긴 거잖아요. 집에 두면 저 죽고 나서 폐지가 될 종이들이, 여기서는 목록에 오르고 습도 관리를 받아요. 종이 팔자로는 출세지요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "도면이 다시 읽힐 날이 올 거라고 보십니까."
        },
        {
          "b": "speech",
          "who": "설계자",
          "text": "모르지요. 근데 저는 도면을 그릴 때부터 그 생각으로 그렸어요. 도면은 편지 같은 거예요. 받는 사람이 아직 안 태어났을 뿐이지. 제가 못 볼 답장을 기다리는 거고요. 편지는 원래 그래요. 부치고 나면 제 일은 끝이에요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "마지막으로 하실 말씀이 있습니까."
        },
        {
          "b": "speech",
          "who": "설계자",
          "text": "문서고 습도 잘 지켜 달라고 써 주세요. 그거 하나면 됩니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0448",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 685 16:00",
      "provenance": "수집 Day 685 16:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0448.jpg",
          "alt": "문서고 서가. 도면 통들이 줄지어 꽂혀 있다.",
          "caption": "권역 문서고 · Day 685"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 조용함)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문서고 서가 사이에 서 있다. 도면 통들이 줄지어 있다. 사진 한 장."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이번 취재에서 받아 적은 것. 도면은 있고 만들 수는 없다는 것. 잠근 자물쇠에 기름칠을 한다는 것. 못 만드는 건 지금이지 영원이 아니라는 것. 도면은 받는 사람이 안 태어난 편지라는 것."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "버린 것들의 회차를 정리하며 알았다. 버려진 것은 없다. 잠기고, 덮이고, 꽂혔을 뿐이다. 버림과 보존이 같은 손동작인 시대다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "습도계가 벽에 걸려 있다. 바늘이 가운데에 있다. 오늘 이 방은 답장을 기다리기에 알맞다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
  ]
