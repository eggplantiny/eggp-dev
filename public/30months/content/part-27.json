      "blocks": [
        {
          "b": "ledger",
          "name": "도면 이관 · Day 678",
          "rows": "전일 반입 누계    320상자\n금일 반입          17상자\n누계              337상자\n\n337번 상자: 표지 수량 26매 / 실물 27매\n추가 1매: 도면 사이에 접힌 정정표. 표지 수량만 수정함.\n도면 순서 변경 없음.\n\n미반입 통지분       4상자\n반입 예정일         Day 681"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0447",
      "type": "FR",
      "source": "권역 문서고 반입대 · 구술 인계 녹음",
      "time": "Day 681 14:00",
      "provenance": "수집 Day 682 09:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:12:30",
        "recovered": "02:05~05:40"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 상자 끄는 소리)"
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "네 개 맞습니다. 목록 여기까지요."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "저 얇은 상자를 밑에 놓으면 안 돼요. 밑판이 꺼졌어."
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "위에 올릴게요."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "그 안에 긴 종이는 접지 마세요. 원래 접힌 자리가 있긴 한데, 펴 놓은 지 오래돼서 거기로 다시 접으면 끊어져요."
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "인계 주의 사항에 적겠습니다."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "말은 했는데 자꾸 잊어버려서. 그래서 써 오려고 했는데 종이를 집에 놓고 왔어요."
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "지금 녹음되고 있어요. 제가 옮겨 적을게요."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "그래요? 그럼 파란 끈 묶은 거. 그건 그 순서대로예요. 큰 종이 밑에 작은 종이 들어 있다고 빼지 말고."
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "파란 끈, 순서 유지."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "그리고 도장이 안 찍힌 건 안 쓴 거예요. 만들어 본 거라고 적으면 안 돼요."
        },
        {
          "b": "cue",
          "text": "(말소리 식별 불가)"
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "이 칸은 연락처입니다."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "집 번호 적으면 돼요?"
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "받으실 수 있는 번호요."
        },
        {
          "b": "speech",
          "who": "인계자",
          "text": "저녁에만 있어요. 낮에는 여기 온다고 쓰면 이상하겠네."
        },
        {
          "b": "speech",
          "who": "보존 담당",
          "text": "저녁에 연락. 그렇게 적을게요."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
