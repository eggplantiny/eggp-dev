    {
      "kind": "record",
      "id": "0440",
      "type": "FR",
      "source": "봉인 작업 현장 녹취",
      "time": "Day 650 10:20",
      "provenance": "수집 Day 651 10:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:26:15",
        "recovered": "04:40~19:02"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 실내. 넓은 공간의 울림)"
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "방청유 도포 끝. 다음 축."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "다음 축 확인. 여기 명판은 어떻게 해요?"
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "명판은 닦아서 그대로 둬. 떼지 마. 나중에 여는 사람이 뭔지 알아야지."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "확인. 닦아서 둔다."
        },
        {
          "b": "cue",
          "text": "(천 씌우는 소리. 끈 묶는 소리)"
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "덮개 모서리 접어. 물 고이면 안 돼."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "접었습니다. 이쪽 열은 끝."
        },
        {
          "b": "speech",
          "who": "작업 1",
          "text": "그럼 조명 내리고 나간다. 마지막에 사진 한 장 찍어. 대장에 붙이게."
        },
        {
          "b": "speech",
          "who": "작업 2",
          "text": "찍었습니다. …불 끕니다."
        },
        {
          "b": "cue",
          "text": "(스위치 소리. 발소리가 멀어진다)"
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0441",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 655",
      "provenance": "수집 Day 655 · C-2",
      "attribution": {
        "subject": "복구 심의 실무자",
        "interviewer": "윤재경",
        "purpose": "심의 절차 기록수집",
        "testimonyTime": "Day 655 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "심의표는 어떻게 생겼습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "항목마다 칸이 여섯이에요. 지금 돌릴 수 있나. 부품이 나오나. 고칠 사람이 있나. 가르칠 수 있나. 대체가 있나. 없으면 어떻게 되나. 여섯 칸에 답을 채우면 판정은 거의 자동이에요. 저희가 정하는 게 아니라 칸이 정해요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "제외 판정을 내릴 때의 마음을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "처음엔 힘들었어요. 항목 하나가 누군가의 평생인 걸 아니까요. 지금은 이렇게 생각해요. 저희는 버리는 게 아니라, 안 돌아가는 것에 사람을 묶지 않는 겁니다. 묶여 있던 사람들이 풀려나서 돌아가는 데로 가요. 그게 심의가 하는 일이에요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "보류 57건은 무엇입니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "여섯 칸 중에 두세 개만 빈 것들요. 사람이 나타나거나 부품 길이 열리면 유지로 갈 수 있는 것들. 보류는 희망 칸이에요. 매 분기 다시 봐요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "심의에 이의는 없습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "있어요. 받고 있어요. 이의가 제일 많은 항목이 뭔지 아세요? 자기 물건이 아니라 자기 기술이에요. 내 기계를 살려 달라가 아니라, 내가 하던 일이 표에서 지워지는 게 맞느냐. 그 이의에는 저희도 답이 짧아요. 표가 하는 일이 아니라서요."
        }
      ]
    },
