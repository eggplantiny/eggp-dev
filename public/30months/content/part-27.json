  "items": [
    {
      "kind": "record",
      "id": "0431",
      "type": "AN",
      "source": "설비·공정 복구 심의 개시 공고",
      "time": "Day 605 09:00",
      "provenance": "수집 Day 605 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 정지 설비·공정 복구 심의\n\n접수 대상: 정지 상태의 설비 및 공정\n제출 자료: 현황표, 도면 목록, 부품·소재 확보 내역, 작업 가능 인원\n판정 구분: 유지 / 제외 / 보류\n\n도면 원본은 보내지 마십시오. 현황표에는 현재 보관 장소를 적으십시오.\n이전 현황표를 다시 제출할 때에는 변경된 칸에만 표시하십시오."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0432",
      "type": "LG",
      "source": "복구 심의 접수 대장 · 마감면",
      "time": "Day 610 17:00",
      "provenance": "수집 Day 611 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "접수 마감",
          "rows": "대상 항목                         412\n도면 보관처 기재                  412\n도면 보관처와 설비 소재지 불일치    86\n\n판정 집계\n유지                              —\n제외                              —\n보류                              —\n",
          "note": "도면 원본 동봉 2건은 제출처로 반송. 목록 사본만 편철."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0433",
      "type": "FR",
      "source": "동아시아 공동 기술 점검 · 정밀 공정 자료 대조 녹음",
      "time": "Day 615 14:00",
      "provenance": "수집 Day 616 10:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:18:42",
        "recovered": "06:11~09:28"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 종이 넘기는 소리)"
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "세 번째 첨부요. 화면에 도면이 안 뜹니다."
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "도면은 있어요."
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "목록만 온 줄 알았습니다. 다시 열겠습니다."
        },
        {
          "b": "cue",
          "text": "(잠시 뒤)"
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "됐습니다. 그럼 제작 가능 칸은요."
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "만들 수는 없어요."
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "자료 미비로 둘까요?"
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "아니요. 자료는 받았습니다. 도면 오른쪽 아래, 참조 장비 번호가 있습니다."
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "그 장비의 현황표를 같이 열어 주세요."
        },
        {
          "b": "cue",
          "text": "(키 입력 소리)"
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "구동부가 빠져 있습니다. 반출 확인서는 뒤에 있고요."
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "소재 쪽은요."
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "이건 제가 받은 게 없는데. 잠깐만요. 다른 폴더일 수 있습니다."
        },
        {
          "b": "cue",
          "text": "(통역 음성 일부 식별 불가)"
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "없습니다. 없다고 적겠습니다."
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "안 받은 것인지, 공급이 안 되는 것인지 확인해 주세요. 지금은 미확인입니다."
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "네. 도면 확인, 장비 확인, 소재 미확인."
        },
        {
          "b": "speech",
          "who": "린웨이전 / 자동통역",
          "text": "장비는 확인만 적지 말고 구동부 없음까지 적어 주세요."
        },
        {
          "b": "speech",
          "who": "접속 담당",
          "text": "칸이 좁아서요. 비고로 넘기겠습니다."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0434",
      "type": "LG",
      "source": "정밀 공정 복구 필요 조건 대장 · 보완 접수본",
      "time": "Day 620 10:00",
      "provenance": "수집 Day 621 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "필요 조건 대조",
          "rows": "대상: 정밀 공정 접수 031\n\n전용 장비    · 보유 장비 구동부 반출 확인서 첨부\n고순도 소재  · 공급처 회신 없음. 확보 수량 기재 없음\n공정 숙련자 · 확인 0명\n작업 기록    · 도면 1철, 조건표 2철\n보정 작업    · 교육 영상 3편 (손이 화면 밖)\n\n영상 대조 비고\n2번 파일 04:18 전후: 압력계 지시값 변동. 조작부는 촬영 범위 밖.\n담당자 목록의 연락처 조회를 마쳤음. 작업 재현 확인란은 비워 둠.\n",
          "note": "필요 조건 확인용. 판정 원본 별도."
        }
      ]
    },
    {
      "personas": {
        "A": "줄무늬",
        "B": "우동사리"
      },
      "kind": "record",
      "id": "0435",
      "type": "WA",
      "source": "생활 게시판 · 수리 문의 저장본",
      "time": "Day 625 21:00",
      "provenance": "수집 Day 626 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "21:00",
          "who": "A",
          "text": "제외 목록 나오기 전에 맡긴 것도 못 고치나요? 탈수기요. 수리표는 62번인데 종이에 물이 닿아서 전화번호가 지워졌어요"
        },
        {
          "b": "post",
          "ts": "21:16",
          "who": "B",
          "text": "수리실입니다. 기계 뒤에 붙은 번호 말고 맡길 때 받은 종이의 번호 맞습니까"
        },
        {
          "b": "post",
          "ts": "21:19",
          "who": "A",
          "text": "네. 뒤 번호는 모르겠어요. 지금 거기 있으니까"
        },
        {
          "b": "post",
          "ts": "21:27",
          "who": "B",
          "text": "62번 벨트 주문 들어가 있습니다. 심의 목록과는 별개입니다. 오시기 전에 여기 다시 물어 주세요"
        },
        {
          "b": "post",
          "ts": "21:31",
          "who": "A",
          "text": "내일 가져와도 되는 건 아니죠?"
        },
        {
          "b": "post",
          "ts": "21:36",
          "who": "B",
          "text": "아직 안 들어왔습니다"
        },
        {
          "b": "post",
          "ts": "21:41",
          "who": "A",
          "text": "알겠습니다. 전화번호도 다시 주세요"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0436",
      "type": "AN",
      "source": "복구 제외 목록 1차 공고",
      "time": "Day 630 09:00",
      "provenance": "수집 Day 630 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 복구 제외 목록\n\n심의 대상 가운데 147개 항목을 복구 대상에서 제외한다.\n\n정밀 공정           31\n특수 제어기         44\n고정밀 등급 재료    39\n기타                33\n\n제외 항목의 도면·공정 기록은 권역 문서고로 이관한다.\n반입 일정은 보관처별로 통지한다. 설비의 봉인·해체 구분은 별도 대장을 따른다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0437",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 636 11:00",
      "provenance": "수집 Day 636 12:00 · C-2",
      "attribution": {
        "subject": "제외 항목 112 · 치구 제작 작업자",
        "interviewer": "윤재경",
        "purpose": "이관 도면의 사용 이력 확인",
        "testimonyTime": "Day 636 11:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이 줄은 선생님이 고치신 겁니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "이거요? 치수는 아니고, 공구 바꾸는 데 표시한 거예요. 원래는 다음 장에 있는데 넘기다가 놓쳐서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "옮겨 적어도 됩니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "그 옆에 적어요. 덮어 쓰지 말고. 원래대로 하다가 바꾼 건지 처음부터 그랬는지 나중에 모르잖아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "판정 통지서도 같이 주셨습니다."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "두 군데 다 보내라더라고요. 여기는 도면, 저쪽은 인력. 종이는 제가 두 장 복사했어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이의 신청은 안 하셨습니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "저라도 같은 칸에 동그라미 쳤을 거예요."
        },
        {
          "b": "cue",
          "text": "(잠시 침묵)"
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "그렇다고 이거까지 가져가라는 건 아닌데."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어느 것을요."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "저 받침. 도면은 여기 얹어야 다 펴져요. 반출하러 온 사람이 받침에도 종이를 붙였길래 뗐어요. 상자 싸기 전에는 못 준다고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "도면을 정리하실 때 도움이 필요하십니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "묶는 건 괜찮아요. 이 종이 사이에 먹지 들어 있어요. 그거 빼 주면 돼요. 손 시커매져도 괜찮겠어요?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "녹음기부터 저쪽에 놔요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0438",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 640 15:30",
      "provenance": "수집 Day 640 15:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "동문. 잠겨 있음. 어제 받은 출입 안내에는 정문으로 돼 있다."
        },
        {
          "b": "cue",
          "text": "(종이 펴는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "담당 번호 끝자리 육인지 팔인지. 다시 물어볼 것."
        },
        {
          "b": "cue",
          "text": "(통화 연결음. 응답 없음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "도면 인수 서명 오늘 못 받음. 봉인 완료 여부도 확인 못 함."
        },
        {
          "b": "cue",
          "text": "(발소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지도에 문 두 개 표시해 두기. 차 들어가는 문 말고 사람이 들어가는 문."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0439",
      "type": "LG",
      "source": "설비 봉인·보존 대장 · 작업지시 배부면",
      "time": "Day 645 17:00",
      "provenance": "수집 Day 646 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "작업지시 집계",
          "rows": "봉인 완료    78\n해체 예정    12\n\n봉인 후 보존\n명판 존치 / 가동부 방청 / 개구부 덮개 / 출입 열쇠 인계\n상태 점검 주기: 연 1회\n\n미완료 인계\n동문 열쇠 1개 · 현장 보관자에게 수령 요청\n인수 확인 서명: —\n",
          "note": "본 대장에 문서고 반입 수량을 합산하지 않음."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0440",
      "type": "FR",
      "source": "봉인 작업 인계용 녹음",
      "time": "Day 650 10:20",
      "provenance": "수집 Day 651 10:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:26:15",
        "recovered": "14:40~17:02"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 비닐 마찰음)"
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "덮지 마. 명판을 먼저."
        },
        {
          "b": "speech",
          "who": "보조",
          "text": "적었어요. 이 번호."
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "끝에 칠이 아니고 일이야. 칠이면 옆 기계야."
        },
        {
          "b": "speech",
          "who": "보조",
          "text": "이거 벗겨져서 그렇게 보였구나."
        },
        {
          "b": "cue",
          "text": "(긁는 소리)"
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "긁지 말고. 옆으로 불 비춰 봐."
        },
        {
          "b": "speech",
          "who": "보조",
          "text": "네. 일 맞아요."
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "대장도 고쳐."
        },
        {
          "b": "cue",
          "text": "(기침. 발소리)"
        },
        {
          "b": "speech",
          "who": "보조",
          "text": "이쪽 천은 모자라요."
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "뒤에서 당기지 마. 거기 배관 나와 있어."
        },
        {
          "b": "speech",
          "who": "보조",
          "text": "그럼 하나 더 써요?"
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "작은 거 남은 거 줘 봐."
        },
        {
          "b": "cue",
          "text": "(말소리 겹침. 내용 불명)"
        },
        {
          "b": "speech",
          "who": "보조",
          "text": "열쇠는요. 제가 사무실로 가져가요?"
        },
        {
          "b": "speech",
          "who": "미경",
          "text": "봉투에 넣고 문 이름 써. 어느 문인지 아는 사람 있을 때."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0441",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 655 14:00",
      "provenance": "수집 Day 655 15:00 · C-2",
      "attribution": {
        "subject": "복구 심의 서류 접수 담당",
        "interviewer": "윤재경",
        "purpose": "판정 통지서 정정 절차 확인",
        "testimonyTime": "Day 655 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "서류가 돌아온다고 하셨는데, 어디서 돌아옵니까."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "보낸 데서요. 사업장 이름만 적으면 못 받는 데가 있어요. 사람이 옮겼는데 우편은 옛날 자리로 가니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "결과를 못 받은 사람이 있겠네요."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "못 받았는지, 받고 답을 안 했는지 몰라요. 반송 봉투 있는 것부터 다시 적어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 통지서는 판정을 바꾼 겁니까."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "아니요. 같은 설비가 두 이름으로 들어왔어요. 항목 두 개로 센 건 아니고, 통지만 양쪽에 갔어요. 한쪽에서 자기 것은 그대로 있다면서 전화를 한 거예요."
        },
        {
          "b": "cue",
          "text": "(책상 위 전화가 울린다)"
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "잠깐만요."
        },
        {
          "b": "cue",
          "text": "(통화. 수화기 쪽 말소리 식별 불가)"
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "아니, 사인하지 마시고요. 받는 분 이름을 먼저. …네. 성함을요."
        },
        {
          "b": "cue",
          "text": "(수화기 내려놓는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "계속해도 됩니까."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "제가 어디까지 했죠?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "두 이름으로 들어온 설비요."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "아. 그 사람 주소도 고쳐야 돼요. 지금 적을게요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0442",
      "type": "AN",
      "source": "복구 유지 목록 공고",
      "time": "Day 660 09:00",
      "provenance": "수집 Day 660 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 복구 유지 목록\n\n208개 항목을 유지 대상으로 확정한다.\n유지 항목의 부품 계보 정리 및 교육 과정 배정은 별도 일정으로 통지한다.\n보류 57개 항목은 분기별 재심의한다.\n\n목록의 품목명만으로 부품을 신청하지 마십시오.\n설비 명판 번호와 설치처를 함께 적으십시오."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0443",
      "type": "FR",
      "source": "정비 접수대 · 명판 번호 확인 녹음",
      "time": "Day 665 16:30",
      "provenance": "수집 Day 666 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "방문자",
          "text": "목록에 있길래 왔는데, 이게 그거죠?"
        },
        {
          "b": "speech",
          "who": "정비 담당",
          "text": "펌프라는 이름은 같아요. 이 사진으로는 밑줄이 안 보여요."
        },
        {
          "b": "speech",
          "who": "방문자",
          "text": "밑줄에 뭐가 있는데요."
        },
        {
          "b": "speech",
          "who": "정비 담당",
          "text": "형식 번호요. 위에 회사 이름 말고."
        },
        {
          "b": "speech",
          "who": "방문자",
          "text": "또 가서 찍어 와야 돼요?"
        },
        {
          "b": "speech",
          "who": "정비 담당",
          "text": "가까우세요?"
        },
        {
          "b": "speech",
          "who": "방문자",
          "text": "어제 갔다 왔는데요."
        },
        {
          "b": "cue",
          "text": "(잠시 침묵)"
        },
        {
          "b": "speech",
          "who": "정비 담당",
          "text": "사진 다음 장 있어요?"
        },
        {
          "b": "speech",
          "who": "방문자",
          "text": "옆에서 찍은 거. 흔들려서 지우려다가."
        },
        {
          "b": "speech",
          "who": "정비 담당",
          "text": "잠깐. 넘기지 마세요. 이거 확대해 볼게요."
        },
        {
          "b": "cue",
          "text": "(접수대 서랍 여닫는 소리)"
        },
        {
          "b": "speech",
          "who": "정비 담당",
          "text": "마지막 두 자만 적어 놨어요? 안 보이네."
        },
        {
          "b": "speech",
          "who": "방문자",
          "text": "수첩에 뭐 적었는데. 잠깐만요. 장 보는 거랑 같이 적어서."
        }
      ]
    },
    {
