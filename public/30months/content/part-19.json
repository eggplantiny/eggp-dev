    {
      "kind": "record",
      "id": "0317",
      "type": "FR",
      "source": "권역 공공 생산선 2호 전실 · 상시 녹음",
      "time": "Day 355 09:40",
      "provenance": "수집 Day 356 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(클린룸 전실. 에어샤워 소리. 문 열림. 발소리 둘.)"
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "필터 얘기부터 해요. 규격 필터 마지막 로트가 이번 배치에서 끝나요. 다음 배치는 없어요."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "로트 번호 불러 주세요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "이공삼, 사일칠. 아까 화면에서 보셨잖아요."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "압니다. 한 번 더요. 이공삼, 사일칠. 유효기한은요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "다음 달 초하루."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "초하루. 그럼 이번 배치는 그걸로 돌리고요. 다음 배치부터가 문제인데, 대체 필터는 뭐가 있습니까."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "한 등급 굵은 게 있어요. 창고에 두 상자. 저는 그걸로 돌리자는 쪽이에요. 안 돌리면 라인이 서니까."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "돌립니다. 다만 그걸로 한 번 돌린 건 생산이 아니에요. 한 번 같게 나온 건 아직 재현이 아니고, 두 번째가 첫 번째하고 같게 나와야 생산이라고 부를 겁니다. 그전까진 시험 배치로 표기하고요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "위에서는 나오면 바로 가져갈 텐데요. 지난번에도 그랬고."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "가져가는 건 위에서 정하고요. 표기는 여기서 정합니다. 시험이라고 써서 내보내면 받는 쪽도 알아요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "대체 필터 로트는 안 물어보세요?"
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "물어봅니다. 불러 주세요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "팔일일, 공이육. 두 상자 다 같은 로트."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "팔일일, 공이육. 같은 로트 두 상자. 됐어요. 그러면 첫 시험 배치 오늘 오후, 두 번째는 다음 주. 사이에 규격 필터 남은 거 있으면 그걸로 한 번 더 돌려서 대조하고요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "규격은 이번 배치로 끝이라니까요."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "압니다. 그러니까 이번 배치 기록을 잘 남겨 두자는 겁니다. 그게 대조 기준이니까. 다음에 규격 필터가 다시 오면 그때 또 대조하고요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "다시 와요?"
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "모릅니다. 신청은 들어가 있고요."
        },
        {
          "b": "cue",
          "text": "(종이 넘기는 소리.)"
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "규격 필터 로트, 한 번만 더요."
        },
        {
          "b": "speech",
          "who": "생산선 반장",
          "text": "…이공삼, 사일칠."
        },
        {
          "b": "speech",
          "who": "공정 담당",
          "text": "됐습니다. 들어가시죠."
        },
        {
          "b": "cue",
          "text": "(에어샤워 소리. 문 닫힘.)"
        }
      ]
