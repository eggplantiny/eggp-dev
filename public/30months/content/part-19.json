    {
      "kind": "record",
      "id": "0313",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 346 14:00",
      "provenance": "수집 Day 346 16:00 · C-2",
      "attribution": {
        "subject": "권역 정비 자재 발주 담당",
        "interviewer": "윤재경",
        "purpose": "자재 운영 기록수집",
        "testimonyTime": "Day 346 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "회신 사본을 주셔서 감사합니다. 이 회신을 받으신 날부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "화면에 먼저 떴어요. 초록불로. 재고 있음. 그리고 도착일 칸이 비어 있었어요. 종이는 이틀 뒤에 왔고요. 종이도 똑같아요. 두 줄."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "두 줄을 어떻게 읽으셨습니까."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "있음은 있음이고 옴은 아니구나, 하고요. 우리끼리 그렇게 불러요. 있음하고 옴. 신입 오면 제일 먼저 가르치는 거예요. 초록불 믿지 마라, 도착일 뜬 것만 믿어라."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 구분은 왜 생겼습니까."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "초록불인데 안 오는 게 하나 생기고, 둘 생기고. 처음엔 화면 오류인 줄 알고 문의 넣었어요. 오류 아니래요. 재고는 진짜로 있대요. 있는 데가 멀 뿐이라고. 그래서 그다음부터는 안 물어요. 물어도 같은 답이니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어디에 있다고 합니까."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "타 회랑이요. 회신에 그렇게만 써요. 어느 회랑인지는 안 써요. 물어보면 배로 두 번 갈아탄대요. 그러면 됐어요. 어디든 여기가 아닌 거니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "화가 나실 때는 없습니까."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "화낼 데가 없어요. 화면한테요? 화면은 거짓말을 안 했어요. 있긴 있대잖아요. 저는 전에 쇼핑몰 상담을 했는데요. 그때는 고객이 저한테 화를 냈어요. 배송이 왜 안 오냐고. 저는 창고에 있다고 했고요. 지금은 제가 그 고객이에요. 근데 저는 화를 안 내요. 그 말이 무슨 말인지 아니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "도착일이 뜨면 어떻게 하십니까."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "뽑아요. 종이로. 벽에 붙여요. 도착일 뜬 것만 붙이는 벽이 있어요. 오는 벽이라고 불러요. 도착하면 떼고요. 떼는 날이 제일 좋은 날이에요. 이번 달에 한 장 뗐어요. 그날 커피를 새로 내렸어요."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "오는 벽이 요즘 헐렁해요. 그건… 적으세요. 헐렁한 것도 사실이니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이 씰은 어떻게 하실 예정입니까."
        },
        {
          "b": "speech",
          "who": "발주 담당",
          "text": "회신을 파일에 꽂았어요. 도착일 없는 것들 파일. 그 파일이 두꺼워요. 두께는 안 재요. 재면 자꾸 재게 되니까요."
        }
      ]
    },
