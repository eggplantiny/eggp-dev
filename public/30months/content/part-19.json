    {
      "kind": "record",
      "id": "0317",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 355",
      "provenance": "수집 Day 355 · C-2",
      "attribution": {
        "subject": "부품창고 관리인",
        "interviewer": "윤재경",
        "purpose": "자재 운영 기록수집",
        "testimonyTime": "Day 355 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "창고의 요즘을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "빈 선반이 늘어요. 큰 것부터 비어요. 큰 부품이 먼저 나가고 늦게 들어오니까요. 작은 선반은 그럭저럭 돌아요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "창고 일을 얼마나 하셨습니까."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "여기서만 이 년요. 그 전엔 마트 물류였어요. 마트 물류랑 여기랑 같은 일인데 반대예요. 마트는 나가는 게 좋은 일이었는데, 여기는 나가면 걱정부터 해요. 이게 나가면 언제 다시 들어오나."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "채워지는 쪽은 무엇입니까."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "도시광산 입고분요. 회수품이 요즘 입고의 반이 넘어요. 라벨에 주소 달고 오는 애들요. 검사해서 쓸 만하면 선반에 올라가요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "빈 선반의 라벨은 어떻게 하십니까."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "안 떼요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "이유를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "떼면 그 자리가 없어지는 거잖아요. 라벨이 있으면 빈 거고, 없으면 없는 거고. 빈 거는 다시 차요. 없는 거는 못 차요. 그래서 안 떼요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "창고에서 가장 오래 빈 선반은 어디입니까."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "대형 씰 칸요. 여덟 달째 비어 있어요. 그 앞을 지날 때마다 라벨을 한 번 봐요. 인사하듯이."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "지난주에 발주 담당이 와서 그 칸을 한참 보고 갔어요. 서로 아무 말 안 했어요. 할 말이 같으니까요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "회수품 검사는 어떻게 하십니까."
        },
        {
          "b": "speech",
          "who": "관리인",
          "text": "닦고, 재고, 돌려보고. 합격이면 초록 딱지, 불합격이면 빨간 딱지. 빨간 딱지도 안 버려요. 부품의 부품으로 쓰니까. 요즘 창고엔 버리는 문이 없어요. 들어오는 문만 있어요."
        }
      ]
    },
