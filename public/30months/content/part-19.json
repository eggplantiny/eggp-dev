    {
      "kind": "record",
      "id": "0308",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 333 14:00",
      "provenance": "수집 Day 333 16:30 · C-2",
      "attribution": {
        "subject": "특수화물 하역장비 운전자 (부산항)",
        "interviewer": "윤재경",
        "purpose": "항만 운영 기록수집",
        "testimonyTime": "Day 333 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "장비의 요즘을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "일 호기만 돌려요. 이 호기는 서 있어요. 지난달에 이 호기 인버터 판을 빼서 일 호기에 넣었거든요. 그래서 이 호기는 이제 못 돌아요. 판이 없으니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "왜 이 호기 쪽을 빼기로 하셨습니까."
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "제가 정한 건 아니고요. 정비반에서 그랬어요. 하나라도 돌리자고. 둘 다 반쯤 고장 난 것보다 하나 멀쩡한 게 낫다고. 맞는 말이에요. 근데 이 호기 앞을 지나갈 때마다 좀 그래요. 걔도 멀쩡한 데가 많거든요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "일 호기는 혼자 운전하십니까."
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "네. 전임자 계실 땐 둘이 했어요. 한 대씩. 지금은 저 혼자 한 대."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "전임자분에 대해 여쭤도 되겠습니까."
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "이제 안 계세요. 그 얘기는 짧게 할게요."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "가르쳐 주긴 하셨어요. 근데 딱 옆에 계실 때까지만요. 위험물 컨테이너 인칭 걸 때 그거, 훅이 걸리기 직전에 반 박자 멈추는 거. 그건 내가 옆에 있을 때 해, 하셨어요. 혼자 하지 말라고. 그래서 저는 한 번도 혼자 안 해봤어요. 그러다 안 계시게 됐고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금은 어떻게 하십니까."
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "혼자 해요. 처음엔 손이 떨렸어요. 반 박자가 얼마인지 몰라서. 그분은 얼마냐고 물으면 그날 바람하고 하중 봐서, 그러셨거든요. 그게 답이 아닌 줄 알면서 물었고, 답이 아닌 줄 알면서 답하셨고. 지금은 제가 정했어요. 훅 소리 나기 전에 하나. 그게 제 반 박자예요. 맞는지는 몰라요. 아직 안 떨어뜨렸어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "물어볼 분이 없어진 뒤에 달라진 것이 있습니까."
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "적어요. 그분이 안 알려준 거를 제가 해보고 적어요. 다음 사람한테는 옆에 있을 때만 해, 안 하려고요. 그 말이 얼마나 무서운 말인지 그분은 몰랐을 거예요. 알았나. 모르겠어요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "하역기사",
          "text": "이 호기 판이 다시 오면 둘이 돌릴 수 있어요. 오냐고요? 신청은 돼 있대요. 그 말을 세 번 들었어요."
        }
      ]
    },
