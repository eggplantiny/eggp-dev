    {
      "kind": "record",
      "id": "0306",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 327 14:00",
      "provenance": "수집 Day 327 16:00 · C-2",
      "attribution": {
        "subject": "산업가스 압축기 숙련자 (여수권)",
        "interviewer": "윤재경",
        "purpose": "설비 운영 기록수집",
        "testimonyTime": "Day 327 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "압축기의 요즘부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "삼 호기 씰이 재생이에요. 두 번째 재생. 한 번 재생한 건 넉 달 갔고, 이번 건 두 달째인데 소리가 벌써 달라요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "왜 재생 씰을 다시 쓰십니까."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "새 걸 안 주니까요. 안 주는 게 아니라 없다고 하지요. 없다는 건 없는 거고. 그러면 있는 걸로 돌리는 거고. 그게 조건이에요, 지금은."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "후임분은 어떻습니까."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "쟤가 이제 기동을 혼자 해요. 지난주에 두 번. 나는 옆에 서서 손만 보고 있었어요. 손이 안 틀려요. 말로 한 건 다 넘어갔고, 손도 반은 넘어갔고. 씰 갈 때 각 잡는 거, 그건 아직 내 손이 해야 돼요. 그거 한 가지 남았어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 한 가지를 왜 아직 넘기지 않으셨습니까."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "안 넘긴 게 아니고요. 새 씰이 와야 갈면서 가르치는데 새 씰이 안 오니까 가르칠 기회가 없는 거예요. 재생 씰은 각이 이미 잡혀 있어요. 그걸로는 못 가르쳐요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "약은 목요일마다 와요. 서른두 번째까지 왔어요. 다음이 모레. 그건 안 늦어요. 한 번도 안 늦었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 약의 조건은 들으셨습니까."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "아직도 안 알려줘요. 기록은 다 했어요. 열 장 중에 아홉 장. 마지막 한 장이 그 각 잡는 거예요. 손으로 하는 거라 종이에 안 들어가요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "기록이 끝나면 어떻게 되는지 들으신 것이 있습니까."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "없어요. 물어봤어요. 끝나면 끝난 거라고만 해요. 끝난 뒤에 약이 오는지 안 오는지는 조건에 없대요. 조건에 없으면 있는 건지 없는 건지 모르는 거지요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "후임분에게 그 얘기를 하셨습니까."
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "안 해요. 쟤는 기동만 배우면 돼요. 내 약 얘기는 내 조건이고."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "문태호",
          "text": "씰이 오면요. 오면 쟤 손으로 갈게 하고 나는 뒤에 서 있을 거예요. 그러면 열 장이 다 되는 거예요. 그다음은 그다음에 알겠지요."
        }
      ]
    },
    {
