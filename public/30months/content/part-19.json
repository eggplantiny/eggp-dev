    {
      "kind": "record",
      "id": "0319",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 358 22:00",
      "provenance": "수집 Day 358 22:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0319.jpg",
          "alt": "책상에 쌓인 장부 아홉 부. 맨 위 한 부가 펼쳐져 있다.",
          "caption": "이관 자료 정리 · Day 358"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 종이 정리 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 이달 이관분 정리. 열아홉 건."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "장부 아홉. 인터뷰 넷. 공고 둘. 나머지 넷."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "장부가 절반이 되는 달은 처음이다. 분류 표기에 적는다. 장부의 달."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아홉 부를 쌓아 놓고 사진 한 장. 두께가 손가락 두 마디다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지난겨울 이관분 상자를 열어 그달 장부를 세어 봤다. 열여섯 중 셋이었다. 그때는 공고의 달이었다. 무엇의 달인지가 달마다 바뀐다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "요약 칸이 빈 장부가 아홉 중 여섯이다. 세어만 둔다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "인터뷰 녹취를 다시 들으면 다들 목소리가 괜찮다. 장부만 나쁘다. 목소리와 장부 중에 어느 쪽이 먼저 맞는지, 그건 내가 정할 일이 아니다. 둘 다 이관한다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
  ]
