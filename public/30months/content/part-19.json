    {
      "kind": "record",
      "id": "0308",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 333",
      "provenance": "수집 Day 333 · C-2",
      "attribution": {
        "subject": "광산 운전원",
        "interviewer": "윤재경",
        "purpose": "산업 운영 기록수집",
        "testimonyTime": "Day 333 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "운전석에 다시 앉으신 경위를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "이 광산이 원격이었어요. 사무실에서 화면 보고 돌리는 거였는데, 제어반 부품이 하나둘 결번이 나더니, 어느 날 유인으로 전환한다고 하더라고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "사람이 다시 필요해진 거군요."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "사람이 필요해진 게 아니라 부품이 없어졌어요."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "그게 달라요. 우리를 다시 부른 게 아니라, 기계를 돌릴 다른 방법이 없어진 거예요. 기분이 좋지도 나쁘지도 않아요. 일은 일이니까."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "운전석은 어떻습니까."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "십 년 만인데 손이 기억해요. 이상하죠. 머리는 절차서를 다시 봤는데 손은 안 봐도 되더라고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "원격 전환 때 그만두셨던 겁니까."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "배차로 옮겼었어요. 화면 보는 일로. 그때는 운전이 없어지는 직업이라고들 했어요. 애들한테도 그렇게 말했고요. 이제 아들이 그래요. 아빠 직업이 다시 생겼네, 하고. 뭐라고 답할지 아직 못 정했어요."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "생긴 게 아니라 돌아온 거고, 돌아온 이유가 좋은 이유가 아니니까요. 그걸 애한테 어떻게 말해요. 그냥 그러네, 했어요. 그러네, 가 제일 정확했어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "원격 시절과 지금, 광산은 어느 쪽이 낫습니까."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "광산한테 물어보면… 지금이래요. 기계 소리가 그래요. 사람이 타면 기계가 좀 살살 돌아요. 원격은 수치로만 돌리니까 기계를 끝까지 밀거든요. 사람은 소리 들으면서 봐주고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "함께 운전석에 돌아온 분들은 어떤 분들입니까."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "나 같은 퇴역들 반, 새로 배운 사람들 반. 새로 배운 쪽에 여자분이 셋 있어요. 그중 한 분은 석 달 만에 야간 단독을 타요. 빠르죠. 빠를 수밖에 없고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "빠를 수밖에 없다는 말씀을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "천천히 배울 시간표가 없어요. 옛날엔 조수 이 년 하고 운전대 잡았는데, 지금 그 이 년이 어딨어요. 대신 옆에 꼭 태워요. 석 달을 타도 백 시간은 옆에서 본 거니까. 시간은 못 줘도 눈은 주는 거예요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "교육은 누가 합니까."
        },
        {
          "b": "speech",
          "who": "운전원",
          "text": "내가 해요. 십 년 전 지식으로요. (웃음) 근데 광산이 십 년 전으로 돌아가 있어서 얼추 맞아요. 세상이 뒤로 가서 내 지식이 다시 신품이 된 거예요. 웃긴 일이에요."
        }
      ]
    },
