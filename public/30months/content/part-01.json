    {
      "kind": "record",
      "id": "0013",
      "type": "FR",
      "source": "북부체육관 외부 물품 인계대 · 현장취재 녹음",
      "time": "Day 4 21:10",
      "provenance": "수집 Day 5 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(셔터가 절반 내려온 인계대. 형광등 한 줄과 휴대용 스탠드 하나가 켜져 있다. 접수표에는 16:47이 찍혀 있다.)"
        },
        {
          "b": "speech",
          "who": "북부체육관 입소자의 딸",
          "text": "명부에는 아버지가 계세요. 그런데 저녁 인계표에는 구역이 없다고 하셨잖아요."
        },
        {
          "b": "speech",
          "who": "인계 담당",
          "text": "성함 다시 적어 주세요."
        },
        {
          "b": "speech",
          "who": "북부체육관 입소자의 딸",
          "text": "아까도 적었어요. 여기, 이 종이요."
        },
        {
          "b": "cue",
          "text": "(종이 두 장을 넘기는 소리)"
        },
        {
          "b": "speech",
          "who": "인계 담당",
          "text": "명부 번호는 있는데 숙소 칸이 비어 있네요. 안쪽에 한 번 더 물어볼게요."
        },
        {
          "b": "speech",
          "who": "북부체육관 입소자의 딸",
          "text": "이 약은 오늘 들어가야 해요. 저녁 약이에요."
        },
        {
          "b": "speech",
          "who": "인계 담당",
          "text": "냉장 약입니까."
        },
        {
          "b": "speech",
          "who": "북부체육관 입소자의 딸",
          "text": "아니요. 아침하고 저녁, 봉투에 써 있어요."
        },
        {
          "b": "speech",
          "who": "인계 담당",
          "text": "성함 확인 전에는 물품 접수가 안 됩니다. 여기 옆에서 잠깐만 기다리세요."
        },
        {
          "b": "speech",
          "who": "북부체육관 입소자의 딸",
          "text": "몇 시까지 기다리면 돼요?"
        },
        {
          "b": "speech",
          "who": "인계 담당",
          "text": "확인될 때까지요."
        },
        {
          "b": "silence",
          "sec": 8,
          "note": "셔터 너머에서 무전 호출. 답신은 녹음되지 않음."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0014",
      "type": "KR",
      "source": "절차 기록 세션 · 4호기 정비1반",
