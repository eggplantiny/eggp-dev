  "items": [
    {
      "kind": "record",
      "id": "0001",
      "type": "BR",
      "source": "공영방송 총선 개표방송 · 1부",
      "time": "Day 0 19:58",
      "provenance": "수집 Day 0 20:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(개표방송 주화면. 지역별 개표 현황 자막)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "투표는 모두 종료됐고 전국에서 개표가 진행되고 있습니다. 아직 초반 집계입니다."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "첫 집계가 들어온 지역부터 선두 후보가 여러 차례 바뀌고 있습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "각 후보 선거사무소 상황도 차례로 연결하겠습니다."
        },
        {
          "b": "cue",
          "text": "(현장 화면 점검 슬레이트. 영상취재: 이형규)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "현장에서 보내온 화면이 들어와 있습니다. 현장 연결은 잠시 뒤 이어가겠습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0002",
      "type": "BR",
      "source": "공영방송 총선 개표방송 · 선거사무소 연결",
      "time": "Day 0 20:17",
      "provenance": "수집 Day 0 20:22 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(선거사무소 원격 연결. 박수와 구호가 겹침)"
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "임태섭 후보 연결돼 있습니다. 후보님, 현재 개표 상황 어떻게 보고 계십니까."
        },
        {
          "b": "speech",
          "who": "임태섭",
          "text": "네, 아직 초반이고요. 끝까지 지켜봐야 합니다. 와 주신 분들께 먼저—"
        },
        {
          "b": "cue",
          "text": "(마이크 접촉음)"
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "구호가 멎고 의자 끄는 소리"
        },
        {
          "b": "speech",
          "who": "미상 (마이크 밖)",
          "text": "의자 좀 주세요."
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "현장 연결이 원활하지 않습니다."
        },
        {
          "b": "cue",
          "text": "(스튜디오 전환음)"
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "다음 지역구 보겠습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0003",
      "type": "WA",
      "source": "개표방송 영상 게시 공간 · 댓글 저장본",
      "time": "Day 0 20:31",
      "provenance": "수집 Day 0 22:10 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "20:31",
          "text": "방금 임태섭 후보 인터뷰 본 사람?"
        },
        {
          "b": "post",
          "ts": "20:32",
          "text": "마이크 떨어뜨린 줄 알았는데 뒤에서 의자 달라고 했음."
        },
        {
          "b": "post",
          "ts": "20:33",
          "text": "6초 동안 아무도 말을 안 하더라."
        },
        {
          "b": "post",
          "ts": "20:34",
          "text": "사람 많고 더워서 그런 거겠지. 개표방송 때 가끔 저럼."
        },
        {
          "b": "post",
          "ts": "20:36",
          "text": "원본 클립 내려가기 전에 저장한 사람 있나요."
        },
        {
          "b": "post",
          "ts": "20:39",
          "text": "다음 지역구로 너무 빨리 넘어갔다는 생각은 듦."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0004",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 0 23:12",
      "provenance": "수집 Day 0 23:12 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "부장 지시. 오늘 들어온 자료는 자르지 말고 원본으로 보관. 요약이나 논평은 붙이지 말고 시각과 출처만 기록할 것."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "연결본은 연결본대로. 댓글은 화면째로."
        },
        {
          "b": "silence",
          "sec": 3,
          "note": "휴대전화 알림음"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "준서한테 사람 만나지 말고 바로 들어오라고 보냈다. 나도 오늘부터 집에서 할 수 있는 건 집에서 한다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "접촉만 줄이면 될 것 같다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0005",
      "type": "AN",
      "source": "권역응급의료센터 당직 공지",
      "time": "Day 1 06:40",
      "provenance": "수집 Day 1 07:15 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 응급실 진료 제한 안내\n\n현재 응급실 내원 환자 급증으로 진료 공간과 대기 구역이 수용 한계에 도달했습니다.\n\n- 보행 가능한 환자는 원외 임시 접수처에서 먼저 문진합니다.\n- 신규 보호자 출입은 환자 1명당 보호자 1명으로 제한합니다.\n- 외래 예약 환자는 병원 방문 전 진료 가능 여부를 확인하십시오.\n- 구급 이송 전 응급실 당직 조정실에 수용 가능 여부를 확인해 주십시오.\n\n이미 접수한 환자의 호출 순서는 현장 상황에 따라 변경될 수 있습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0006",
      "type": "BR",
      "source": "공영방송 재난보도 임시편성 · 1보",
      "time": "Day 1 09:00",
      "provenance": "수집 Day 1 09:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정규 편성 중단음)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "오늘 새벽부터 여러 지역 응급실에서 원인을 알 수 없는 급성 증상을 보이는 환자가 한꺼번에 늘고 있습니다."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "취재진이 확인한 권역응급의료센터 네 곳 모두 내원·대기 환자 수가 수용 능력을 넘어섰습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "환자들에게 공통점이 있습니까."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "입원 중이거나 이송을 기다리는 환자 가운데 남성이 대부분입니다. 다만 병원별 집계 기준이 달라 전체 통계로 보기는 어렵습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "보건 당국은 지역별 사례를 취합하고 있다고 밝혔습니다. 원인과 전파 경로는 아직 확인되지 않았습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0007",
      "type": "WA",
      "source": "권역응급의료센터 대기 정보 게시판",
      "time": "Day 1 13:22",
      "provenance": "수집 Day 1 16:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "13:22",
          "text": "아버지랑 아침부터 와 있는데 접수번호만 받고 아직 문진도 못 했습니다."
        },
        {
          "b": "post",
          "ts": "13:25",
          "text": "여기는 안쪽 의자 다 빼고 바닥에 앉혀요. 남자 환자 줄만 따로 생겼습니다."
        },
        {
          "b": "post",
          "ts": "13:29",
          "text": "보호자는 한 명만 남으라는데 혼자서는 아버지를 못 옮겨요."
        },
        {
          "b": "post",
          "ts": "13:34",
          "text": "구급차로 와도 바로 들어가는 것 아닙니다. 차 안에서 기다리는 분도 있어요."
        },
        {
          "b": "post",
          "ts": "13:41",
          "text": "직원한테 물어봤는데 어느 병동으로 갈지는 아직 모른다고 합니다."
        },
        {
          "b": "post",
          "ts": "13:48",
          "text": "다른 병원으로 가도 되는지 아시는 분 답 부탁드립니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0008",
      "type": "AN",
      "source": "권역 남성 임시보호시설 운영 안내",
      "time": "Day 1 18:00",
      "provenance": "수집 Day 1 18:20 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 남성 임시보호시설 입소 및 운영 안내\n\n가정과 의료기관 내 접촉을 줄이고 진료 부담을 분산하기 위해 권역별 임시보호시설을 운영합니다.\n\n1. 입소자는 배정된 시설로만 이동합니다.\n2. 입소 시각, 동행자, 현재 증상을 접수대에 기재합니다.\n3. 시설 안에서는 지정 구역을 벗어나지 않습니다.\n4. 가족 면회는 중단하며 물품은 외부 인계대에서 전달합니다.\n5. 증상 변화가 있을 경우 순회 인력에게 즉시 알립니다.\n6. 시설 간 임의 이동은 허용하지 않습니다.\n\n분리 운영 기간은 추가 안내 시까지입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0009",
      "type": "KR",
      "source": "개인 촬영본 · 4호기 정비1반",
      "time": "Day 2 06:50",
      "provenance": "수집 Day 5 11:20 · C-3",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(휴대전화 촬영 시작. 작업대 위의 격리·무압 상태 예비 스풀. 명판: DN150 / PN16 / EPDM)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "이거 켜진 거여?"
        },
        {
          "b": "cue",
          "text": "(카메라가 고무 아치, 분할 리테이닝 링, 컨트롤 로드와 여덟 체결점을 차례로 비춤)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "4호기 급수펌프 쪽 보조냉각수여. 본선 아니고 낮은 압력으로 따로 도는 물 계통. B계열 순환펌프 토출 쪽에 들어가는 거고."
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "고무 면끼리 닿아서 막는 풀페이스 형식이여."
        },
        {
          "b": "cue",
          "text": "(여덟 체결점 옆에 분필 숫자가 보임)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "체결점은 여덟 군데. 숫자는 위치 안 헷갈리게 적어둔 거여."
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "오늘은 이름하고 생긴 것부터 봐 둬."
        },
        {
          "b": "silence",
          "sec": 2,
          "note": "조성만이 짧게 웃음"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "애들이 나중에 볼 수도 있으니까."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0010",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 접촉 회피 글타래",
      "time": "Day 2 21:04",
      "provenance": "수집 Day 3 00:10 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "21:04",
          "text": "남편은 작은방 쓰고 아이랑 저는 안방 씁니다. 식사도 문 앞에 둬요."
        },
        {
          "b": "post",
          "ts": "21:08",
          "text": "회사도 전면 재택근무로 바뀌었습니다."
        },
        {
          "b": "post",
          "ts": "21:09",
          "text": "ㄴ 그럼 출근 안 하면 일단 괜찮은 거 아닌가요."
        },
        {
          "b": "post",
          "ts": "21:13",
          "text": "엘리베이터 같이 타지 말고 택배도 문 앞에서 받으세요."
        },
        {
          "b": "post",
          "ts": "21:21",
          "text": "보호시설 자리도 없대요. 일단 집에서 방 분리 중."
        },
        {
          "b": "post",
          "ts": "21:29",
          "text": "접촉만 끊으면 넘어갈 수 있을 거예요."
        },
        {
          "b": "post",
          "ts": "21:36",
          "text": "확실하다는 건 아님. 우리 집은 이렇게 함."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0011",
      "type": "BR",
      "source": "질병 대응 정례 브리핑",
      "time": "Day 3 11:00",
      "provenance": "수집 Day 3 11:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "사회자",
          "text": "지금부터 현재까지 확인된 사례를 말씀드리겠습니다."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "의료기관과 임시보호시설에서 보고된 급성 악화 사례는 남성에 뚜렷하게 집중돼 있습니다."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "연령대별·지역별로 구분해도 같은 경향이 관찰되며, 신규 악화 사례는 계속 보고되고 있습니다. 일별 증감과 공통 요인은 분석 중입니다."
        },
        {
          "b": "speech",
          "who": "기자 1",
          "text": "여성에게서 같은 양상의 중증 사례가 확인됐습니까."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "현재 같은 분류 기준에 해당하는 여성 중증 사례는 확인되지 않았습니다. 성별과의 연관성은 뚜렷하게 관찰되지만, 그 기전에 대해서는 아직 결론을 내리지 않았습니다."
        },
        {
          "b": "speech",
          "who": "기자 2",
          "text": "기존 격리 지침은 그대로 유지됩니까."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "현행 안내를 유지합니다. 변경 사항이 확인되면 별도로 공지하겠습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0012",
      "type": "LG",
      "source": "남성 임시보호시설 일일보고 · 6개소 취합",
      "time": "Day 4 18:00",
      "provenance": "수집 Day 4 19:15 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "북부체육관",
          "rows": "최초 명부        73\n현재 관찰        67\n상태악화 누계     6",
          "note": "교대 인계표 1장 누락."
        },
