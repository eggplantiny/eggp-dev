  "items": [
    {
      "kind": "record",
      "id": "0001",
      "type": "BR",
      "source": "공영방송 총선 개표방송 · 1부",
      "time": "Day 0 19:58",
      "provenance": "수집 Day 0 20:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(개표방송 주화면. 지역별 개표 현황 자막)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "투표는 모두 종료됐고, 전국 개표율은 지금 4.2퍼센트입니다. 아직 초반 집계입니다."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "네, 초반에는 순위가 여러 번 바뀝니다. 지금 화면에 나가는 지역만 해도 저녁 여덟 시 넘어서 세 차례 뒤집혔고요."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "최종 투표율은 잠정 67.4퍼센트로 집계됐습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "직전 총선보다 소폭 높은 수치입니다. 개표소 상황과 각 후보 선거사무소도 차례로 연결하겠습니다."
        },
        {
          "b": "cue",
          "text": "(현장 연결 대기 화면. 화면 점검 슬레이트. 영상취재: 이형규)"
        },
        {
          "b": "speech",
          "who": "이형규",
          "text": "(송출 겹침) 레벨 한 번만 봐 주세요. 하나, 둘, 셋. 스탠바이 몇 분 남았어요?"
        },
        {
          "b": "speech",
          "who": "미상 (스튜디오 회선)",
          "text": "사 분. 사 분 뒤에 갑니다."
        },
        {
          "b": "speech",
          "who": "이형규",
          "text": "알겠습니다. 아, 오늘 길어질 것 같은데 중계차에 컵라면 남은 거 있으면 좀 챙겨 놔 주세요."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "현장 준비 화면과 음성이 잠시 섞여 나갔습니다. 양해 바랍니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "현장 연결은 잠시 뒤 이어가겠습니다. 다음 지역 개표 현황 보시겠습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0002",
      "type": "BR",
      "source": "공영방송 총선 개표방송 · 선거사무소 연결",
      "time": "Day 0 20:17",
      "provenance": "수집 Day 0 20:22 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(선거사무소 원격 연결. 박수와 구호가 겹침)"
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "임태섭 후보 연결돼 있습니다. 후보님, 들리십니까. 현재 개표 상황 어떻게 보고 계십니까."
        },
        {
          "b": "speech",
          "who": "임태섭",
          "text": "네, 잘 들립니다. 아직 초반이고요, 끝까지 지켜봐야 합니다. 그보다 오늘 이 자리까지 와 주신 분들께 먼저—"
        },
        {
          "b": "cue",
          "text": "(마이크 접촉음)"
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "구호가 멎고 의자 끄는 소리"
        },
        {
          "b": "speech",
          "who": "미상 (마이크 밖)",
          "text": "의자 좀 주세요."
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "네, …네. 현장 연결 상태가 원활하지 않은 것 같습니다."
        },
        {
          "b": "cue",
          "text": "(스튜디오 전환음)"
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "연결 상태가 회복되는 대로 다시 이어가겠습니다. 다음 지역구 보겠습니다."
        }
      ]
    },
    {
      "personas": {
        "A": "별헤는밤",
        "B": "보통사람입니다",
        "C": "국밥한그릇",
        "D": "반차쓰고싶다",
        "E": "아침형인간",
        "F": "점심뭐먹지",
        "G": "햇살가득한집",
        "H": "라디오듣는밤"
      },
      "kind": "record",
      "id": "0003",
      "type": "WA",
      "source": "개표방송 영상 게시 공간 · 댓글 저장본",
      "time": "Day 0 20:31",
      "provenance": "수집 Day 0 22:10 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "20:31",
          "who": "A",
          "text": "방금 임태섭 인터뷰 본 사람 있음?"
        },
        {
          "b": "post",
          "ts": "20:32",
          "who": "B",
          "text": "뭐가",
          "reply": true
        },
        {
          "b": "post",
          "ts": "20:32",
          "who": "A",
          "text": "말하다가 뚝 끊김. 마이크 부딪히는 소리 나고 6초 정도 아무도 말을 안 함",
          "re": "B"
        },
        {
          "b": "post",
          "ts": "20:33",
          "who": "A",
          "text": "뒤에서 의자 달라고 하는 것만 들렸음. 2:41:00쯤부터 보면 됨",
          "re": "B"
        },
        {
          "b": "post",
          "ts": "20:34",
          "who": "C",
          "text": "사람 많고 더워서 그런 거임. 개표날 사무소에 사람을 몇 명을 밀어넣는데",
          "re": "A"
        },
        {
          "b": "post",
          "ts": "20:35",
          "who": "D",
          "text": "여기서 그거 말고 출구조사 얘기하면 안 됨? 3번 지역구 지금 재밌는데"
        },
        {
          "b": "post",
          "ts": "20:36",
          "who": "E",
          "text": "원본 내려가기 전에 클립 저장함. 필요하면 말"
        },
        {
          "b": "post",
          "ts": "20:37",
          "who": "F",
          "text": "저장 좀. 쪽지 보냄",
          "reply": true
        },
        {
          "b": "post",
          "ts": "20:38",
          "who": "G",
          "text": "다시 돌려보니까 2:41:20쯤 화면 오른쪽 끝에 사람들 몰리는 거 잠깐 나옴. 그러고 바로 스튜디오로 넘어감"
        },
        {
          "b": "post",
          "ts": "20:39",
          "who": "H",
          "text": "앵커가 너무 빨리 넘기지 않았나. 보통 정리 멘트는 치고 넘어가는데"
        },
        {
          "b": "post",
          "ts": "20:41",
          "who": "C",
          "text": "그건 맞음",
          "re": "H"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0004",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 0 23:12",
      "provenance": "수집 Day 0 23:12 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 첫 문장 앞부분이 잘림)"
        },
        {
          "b": "speech",
          "who": "김상진",
          "text": "—하지 말고. 요약하지 마. 논평 달지 마. 들어온 건 들어온 그대로 둬. 시각하고 출처만 붙여서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "연결본은요."
        },
        {
          "b": "speech",
          "who": "김상진",
          "text": "연결본은 연결본대로. 댓글은 화면째로 떠. 내일 아침에 다시 얘기하자."
        },
        {
          "b": "cue",
          "text": "(통화 종료음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이상, 부장 지시. 그대로 해 둔다."
        },
        {
          "b": "silence",
          "sec": 4,
          "note": "냉장고 문 여닫는 소리"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오늘 저장분. 연결본 20시 17분 것 하나. 댓글 화면 여덟 장. 원본 클립은 게시자가 내리기 전 것으로 받아 둠."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "임태섭 후보는 유세 피로로 보인다. 개표 당일 저녁까지 사람 만나는 일정이었고, 쓰러진 게 아니라 의자에 앉은 거다. 내일 사무소 쪽에 확인만 해 둘 것."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "준서한테는 사람 만나지 말고 바로 들어오라고 보냈다. 답 왔다. 라면 먹고 들어간다고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "접촉만 줄이면 될 것 같다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0005",
      "type": "AN",
      "source": "권역응급의료센터 당직 공지",
      "time": "Day 1 06:40",
      "provenance": "수집 Day 1 07:15 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 응급실 진료 제한 안내\n\n현재 응급실 내원 환자 급증으로 진료 공간과 대기 구역이 수용 한계에 도달했습니다.\n\n- 보행 가능한 환자는 원외 임시 접수처에서 먼저 문진합니다.\n- 신규 보호자 출입은 환자 1명당 보호자 1명으로 제한합니다.\n- 외래 예약 환자는 병원 방문 전 진료 가능 여부를 확인하십시오.\n- 구급 이송 전 응급실 당직 조정실에 수용 가능 여부를 확인해 주십시오.\n\n이미 접수한 환자의 호출 순서는 현장 상황에 따라 변경될 수 있습니다."
        },
        {
          "b": "hand",
          "text": "※ 원외 접수처는 주차장 천막입니다. 흰색 아니고 파란색 천막입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0006",
      "type": "BR",
      "source": "공영방송 재난보도 임시편성 · 1보",
      "time": "Day 1 09:00",
      "provenance": "수집 Day 1 09:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정규 편성 중단음)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "정규 방송을 중단하고 재난보도를 시작합니다. 오늘 새벽부터 여러 지역 응급실에서, 원인을 알 수 없는 급성 증상 환자가 한꺼번에 늘고 있습니다. 사회부 취재기자 연결합니다."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "(전화 연결음질) 네, 권역응급의료센터 앞입니다. 취재진이 직접 확인한 곳만 세 곳— 네 곳입니다. 방금 한 곳이 추가로 확인됐습니다. 네 곳 모두 내원·대기 환자가 수용 능력을 넘어섰습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "환자들에게 공통점이 있습니까."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "입원 중이거나 이송을 기다리는 환자 가운데 남성이 대부분입니다. 다만 병원마다 집계 기준이 달라서, 지금 단계에서 전체 통계로 말씀드리기는 어렵습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "현장 상황은 어떻습니까."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "접수처가 건물 밖으로 나와 있고, 지금도 제 뒤로 줄이 이어지고 있습니다. 병원 측은 인력을 추가 투입하고 있다고만 밝혔습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "보건 당국은 지역별 사례를 취합하고 있다고 밝혔습니다. 원인과 전파 경로는 아직 확인되지 않았습니다. 확인되는 대로 다시 전해 드리겠습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0007",
      "type": "FR",
      "source": "권역응급의료센터 원외 접수처 · 현장취재 녹음",
      "time": "Day 1 13:22",
      "provenance": "수집 Day 1 16:00 · C-2",
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0007-1.jpg",
          "alt": "병원 주차장의 파란 천막과 접수용 책상. 천막 밖으로 접힌 줄이 화면 오른쪽까지 이어진다.",
          "caption": "권역응급의료센터 주차장 · Day 1"
        },
        {
          "type": "image",
          "src": "/30months/m/0007-2.jpg",
          "alt": "구겨진 종이 접수번호표를 쥔 손. 굵은 숫자 214가 보인다.",
          "caption": "원외 접수처 · Day 1"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(주차장. 천막 천이 바람에 반복해서 울린다. 번호 호출은 휴대용 확성기를 쓴다.)"
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "백삼십일 번. 보호자 한 분만 오세요. 백삼십일 번."
        },
        {
          "b": "speech",
          "who": "187번 보호자",
          "text": "저기요. 아버지가 일어나질 못하세요. 제가 혼자서는 못 옮깁니다."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "번호가 몇 번이세요."
        },
        {
          "b": "speech",
          "who": "187번 보호자",
          "text": "백팔십칠 번이요. 아침 일곱 시에 받았습니다."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "아직 순서가 멀었는데요. 휠체어부터 가져다드릴게요. 환자분은 어디 계세요."
        },
        {
          "b": "speech",
          "who": "187번 보호자",
          "text": "흰 천막 옆, 차 세운 데요. 제가 같이 가야 찾습니다."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "여기 줄에서 빠지시면 다시 세우기가— 잠깐만요. 파란 조끼 선생님!"
        },
        {
          "b": "silence",
          "sec": 5,
          "note": "확성기에서 백삼십이 번을 부르는 소리"
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "저희 이백십사 번인데, 지금 백삼십 번대 맞죠?"
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "표 버리지 마시고 이 줄 그대로 계세요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "휠체어는 어디에서 나옵니까."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "기자분이면 통로부터 비켜 주세요. 지금 하나가 들어오고 있어요."
        },
        {
          "b": "cue",
          "text": "(금속 발판이 아스팔트 턱에 두 번 부딪힌다.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0008",
      "type": "AN",
      "source": "권역 남성 임시보호시설 운영 안내",
      "time": "Day 1 18:00",
      "provenance": "수집 Day 1 18:20 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 남성 임시보호시설 입소 및 운영 안내\n\n가정과 의료기관 내 접촉을 줄이고 진료 부담을 분산하기 위해 권역별 임시보호시설을 운영합니다.\n\n1. 입소자는 배정된 시설로만 이동합니다.\n2. 입소 시각, 동행자, 현재 증상을 접수대에 기재합니다.\n3. 시설 안에서는 지정 구역을 벗어나지 않습니다.\n4. 가족 면회는 중단하며 물품은 외부 인계대에서 전달합니다.\n5. 물품 인계대 운영시간은 09:00~17:00이며 품목 확인에 시간이 걸릴 수 있습니다.\n6. 증상 변화가 있을 경우 순회 인력에게 즉시 알립니다.\n7. 시설 간 임의 이동은 허용하지 않습니다.\n\n분리 운영 기간은 추가 안내 시까지입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0009",
      "type": "KR",
      "source": "개인 촬영본 · 4호기 정비1반",
      "time": "Day 2 06:50",
      "provenance": "수집 Day 5 11:20 · C-3",
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0009-1.jpg",
          "alt": "작업대 위 고무 팽창이음. 플랜지 구멍 옆 분필 숫자.",
          "caption": "촬영본 정지 화면 · Day 2"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(휴대전화 촬영. 화면이 한동안 바닥을 향함)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "이거 켜진 거여? …켜졌구먼."
        },
        {
          "b": "cue",
          "text": "(작업대 위의 격리·무압 상태 예비 스풀. 명판: DN150 / PN16 / EPDM)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "자. 오늘은 이름부터 봐 둬."
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "4호기 급수펌프 쪽 보조냉각수여. 본선 아니고, 낮은 압력으로 따로 도는 물이여. B계열 순환펌프 토출 쪽에 들어가는 거고."
        },
        {
          "b": "cue",
          "text": "(카메라가 고무 아치, 분할 리테이닝 링, 컨트롤 로드를 차례로 비춤. 초점이 두 번 나감)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "아, 이눔의 초점이."
        },
        {
          "b": "silence",
          "sec": 2,
          "note": "조성만이 짧게 웃음"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "고무 면끼리 닿아서 막는 풀페이스 형식이여. 여기 아치가 살아 있어야 되는 거고."
        },
        {
          "b": "cue",
          "text": "(여덟 체결점 옆에 분필 숫자가 보임)"
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "체결점은 여덟 군데. 숫자는 내가 적은 겨. 위치 안 헷갈리게."
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "소리를 들어야 되는데, 그건 찍어서 되는 게 아니고."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "됐고. 오늘은 이름허고 생긴 것만 봐 둬."
        },
        {
          "b": "speech",
          "who": "조성만",
          "text": "애들이 나중에 볼 수도 있으니께."
        },
        {
          "b": "cue",
          "text": "(촬영 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0010",
      "type": "FR",
      "source": "아파트 현관 문열림 카메라 · 주민 제공본",
      "time": "Day 2 21:04",
      "provenance": "수집 Day 3 00:10 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(현관 안쪽 카메라의 동작 감지 녹화. 복도 불은 켜져 있다.)"
        },
        {
          "b": "speech",
          "who": "미상 (여)",
          "text": "문 바로 앞에 놨어요. 국은 뚜껑 닫았고."
        },
        {
          "b": "speech",
          "who": "미상 (남, 문 안)",
          "text": "시설에서 연락 왔어요?"
        },
        {
          "b": "speech",
          "who": "미상 (여)",
          "text": "아직. 대기라고만 왔어요."
        },
        {
          "b": "cue",
          "text": "(접시가 바닥에 닿는다. 문 아래에 말아 둔 수건이 조금 움직인다.)"
        },
        {
          "b": "speech",
          "who": "미상 (남, 문 안)",
          "text": "컵은 어제 거 내놓으면 돼요?"
        },
        {
          "b": "speech",
          "who": "미상 (여)",
          "text": "내가 복도 비우고 나면 내놔요. 먼저 열지 말고."
        },
        {
          "b": "speech",
          "who": "미상 (아이)",
          "text": "아빠, 오늘은 안 나와?"
        },
        {
          "b": "speech",
          "who": "미상 (여)",
          "text": "방에 들어가 있어. 손 씻고."
        },
        {
          "b": "silence",
          "sec": 7,
          "note": "작은방 안쪽에서 기침 한 번. 현관 쪽에서는 물이 흐른다."
        },
        {
          "b": "speech",
          "who": "미상 (남, 문 안)",
          "text": "이렇게 하는 게 맞는 거겠지."
        },
        {
          "b": "speech",
          "who": "미상 (여)",
          "text": "연락 올 때까지만 하자."
        },
        {
          "b": "cue",
          "text": "(현관 센서등이 꺼지며 영상이 끝난다.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0011",
      "type": "BR",
      "source": "질병 대응 정례 브리핑",
      "time": "Day 3 11:00",
      "provenance": "수집 Day 3 11:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "사회자",
          "text": "정례 브리핑 시작하겠습니다. 발표 후 질의 받겠습니다."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "현재까지 확인된 사례를 말씀드리겠습니다. 의료기관과 임시보호시설에서 보고된 급성 악화 사례는 남성에 뚜렷하게 집중돼 있습니다. 연령대별, 지역별로 구분해도 같은 경향이 관찰되며, 신규 악화 사례는 계속 보고되고 있습니다. 일별 증감과 공통 요인은 분석 중입니다."
        },
        {
          "b": "speech",
          "who": "기자 1",
          "text": "여성에게서 같은 양상의 중증 사례가 확인됐습니까."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "현재 같은 분류 기준에 해당하는 여성 중증 사례는 확인되지 않았습니다."
        },
        {
          "b": "speech",
          "who": "기자 2",
          "text": "그러면 남성만 걸리는 병입니까."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "표현에 주의해 주시기 바랍니다. 지금 관찰된 것은 집중이지, 그 이상을 말씀드린 적 없습니다. 성별과의 연관은 뚜렷하게 관찰되지만 기전에 대해서는 결론을 내리지 않았습니다."
        },
        {
          "b": "speech",
          "who": "기자 3",
          "text": "기존 격리 지침은 유지됩니까."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "현행 안내를 유지합니다. 변경 사항이 확인되면 별도로 공지하겠습니다."
        },
        {
          "b": "speech",
          "who": "사회자",
          "text": "다음 브리핑은 내일 같은 시각입니다."
        }
      ]
    },
