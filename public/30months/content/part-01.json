  "items": [
    {
      "kind": "record",
      "id": "0001",
      "type": "BR",
      "source": "공영방송 총선 개표방송 · 1부",
      "time": "Day 0 19:58",
      "provenance": "수집 Day 0 20:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(개표방송 주화면. 지역별 개표 현황 자막)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "투표는 모두 종료됐고, 전국 개표율은 지금 4.2퍼센트입니다. 아직 초반 집계입니다."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "네, 초반에는 순위가 여러 번 바뀝니다. 지금 화면에 나가는 지역만 해도 저녁 여덟 시 넘어서 세 차례 뒤집혔고요."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "최종 투표율은 잠정 67.4퍼센트로 집계됐습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "직전 총선보다 소폭 높은 수치입니다. 개표소 상황과 각 후보 선거사무소도 차례로 연결하겠습니다."
        },
        {
          "b": "cue",
          "text": "(현장 연결 대기 화면. 화면 점검 슬레이트. 영상취재: 이형규)"
        },
        {
          "b": "speech",
          "who": "이형규",
          "text": "(송출 겹침) 레벨 한 번만 봐 주세요. 하나, 둘, 셋. 스탠바이 몇 분 남았어요?"
        },
        {
          "b": "speech",
          "who": "미상 (스튜디오 회선)",
          "text": "사 분. 사 분 뒤에 갑니다."
        },
        {
          "b": "speech",
          "who": "이형규",
          "text": "알겠습니다. 아, 오늘 길어질 것 같은데 중계차에 컵라면 남은 거 있으면 좀 챙겨 놔 주세요."
        },
        {
          "b": "speech",
          "who": "앵커 (남)",
          "text": "현장 준비 화면과 음성이 잠시 섞여 나갔습니다. 양해 바랍니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "현장 연결은 잠시 뒤 이어가겠습니다. 다음 지역 개표 현황 보시겠습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0002",
      "type": "BR",
      "source": "공영방송 총선 개표방송 · 선거사무소 연결",
      "time": "Day 0 20:17",
      "provenance": "수집 Day 0 20:22 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(선거사무소 원격 연결. 박수와 구호가 겹침)"
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "임태섭 후보 연결돼 있습니다. 후보님, 들리십니까. 현재 개표 상황 어떻게 보고 계십니까."
        },
        {
          "b": "speech",
          "who": "임태섭",
          "text": "네, 잘 들립니다. 아직 초반이고요, 끝까지 지켜봐야 합니다. 그보다 오늘 이 자리까지 와 주신 분들께 먼저—"
        },
        {
          "b": "cue",
          "text": "(마이크 접촉음)"
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "구호가 멎고 의자 끄는 소리"
        },
        {
          "b": "speech",
          "who": "미상 (마이크 밖)",
          "text": "의자 좀 주세요."
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "네, …네. 현장 연결 상태가 원활하지 않은 것 같습니다."
        },
        {
          "b": "cue",
          "text": "(스튜디오 전환음)"
        },
        {
          "b": "speech",
          "who": "개표방송 앵커",
          "text": "연결 상태가 회복되는 대로 다시 이어가겠습니다. 다음 지역구 보겠습니다."
        }
      ]
    },
    {
      "personas": {
        "A": "별헤는밤",
        "B": "보통사람입니다",
        "C": "국밥한그릇",
        "D": "반차쓰고싶다",
        "E": "아침형인간",
        "F": "점심뭐먹지",
        "G": "햇살가득한집",
        "H": "라디오듣는밤"
      },
      "kind": "record",
      "id": "0003",
      "type": "WA",
      "source": "개표방송 영상 게시 공간 · 댓글 저장본",
      "time": "Day 0 20:31",
      "provenance": "수집 Day 0 22:10 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "20:31",
          "who": "A",
          "text": "방금 임태섭 인터뷰 본 사람 있음?"
        },
        {
          "b": "post",
          "ts": "20:32",
          "who": "B",
          "text": "뭐가",
          "reply": true
        },
        {
          "b": "post",
          "ts": "20:32",
          "who": "A",
          "text": "말하다가 뚝 끊김. 마이크 부딪히는 소리 나고 6초 정도 아무도 말을 안 함",
          "re": "B"
        },
        {
          "b": "post",
          "ts": "20:33",
          "who": "A",
          "text": "뒤에서 의자 달라고 하는 것만 들렸음. 2:41:00쯤부터 보면 됨",
          "re": "B"
        },
        {
          "b": "post",
          "ts": "20:34",
          "who": "C",
          "text": "사람 많고 더워서 그런 거임. 개표날 사무소에 사람을 몇 명을 밀어넣는데",
          "re": "A"
        },
        {
          "b": "post",
          "ts": "20:35",
          "who": "D",
          "text": "여기서 그거 말고 출구조사 얘기하면 안 됨? 3번 지역구 지금 재밌는데"
        },
        {
          "b": "post",
          "ts": "20:36",
          "who": "E",
          "text": "원본 내려가기 전에 클립 저장함. 필요하면 말"
        },
        {
          "b": "post",
          "ts": "20:37",
          "who": "F",
          "text": "저장 좀. 쪽지 보냄",
          "reply": true
        },
        {
          "b": "post",
          "ts": "20:38",
          "who": "G",
          "text": "다시 돌려보니까 2:41:20쯤 화면 오른쪽 끝에 사람들 몰리는 거 잠깐 나옴. 그러고 바로 스튜디오로 넘어감"
        },
        {
          "b": "post",
          "ts": "20:39",
          "who": "H",
          "text": "앵커가 너무 빨리 넘기지 않았나. 보통 정리 멘트는 치고 넘어가는데"
        },
        {
          "b": "post",
          "ts": "20:41",
          "who": "C",
          "text": "그건 맞음",
          "re": "H"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0004",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 0 23:12",
      "provenance": "수집 Day 0 23:12 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 첫 문장 앞부분이 잘림)"
        },
        {
          "b": "speech",
          "who": "김상진",
          "text": "—하지 말고. 요약하지 마. 논평 달지 마. 들어온 건 들어온 그대로 둬. 시각하고 출처만 붙여서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "연결본은요."
        },
        {
          "b": "speech",
          "who": "김상진",
          "text": "연결본은 연결본대로. 댓글은 화면째로 떠. 내일 아침에 다시 얘기하자."
        },
        {
          "b": "cue",
          "text": "(통화 종료음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이상, 부장 지시. 그대로 해 둔다."
        },
        {
          "b": "silence",
          "sec": 4,
          "note": "냉장고 문 여닫는 소리"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오늘 저장분. 연결본 20시 17분 것 하나. 댓글 화면 여덟 장. 원본 클립은 게시자가 내리기 전 것으로 받아 둠."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "임태섭 후보는 유세 피로로 보인다. 개표 당일 저녁까지 사람 만나는 일정이었고, 쓰러진 게 아니라 의자에 앉은 거다. 내일 사무소 쪽에 확인만 해 둘 것."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "준서한테는 사람 만나지 말고 바로 들어오라고 보냈다. 답 왔다. 라면 먹고 들어간다고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "접촉만 줄이면 될 것 같다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0005",
      "type": "AN",
      "source": "권역응급의료센터 당직 공지",
      "time": "Day 1 06:40",
      "provenance": "수집 Day 1 07:15 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 응급실 진료 제한 안내\n\n현재 응급실 내원 환자 급증으로 진료 공간과 대기 구역이 수용 한계에 도달했습니다.\n\n- 보행 가능한 환자는 원외 임시 접수처에서 먼저 문진합니다.\n- 신규 보호자 출입은 환자 1명당 보호자 1명으로 제한합니다.\n- 외래 예약 환자는 병원 방문 전 진료 가능 여부를 확인하십시오.\n- 구급 이송 전 응급실 당직 조정실에 수용 가능 여부를 확인해 주십시오.\n\n이미 접수한 환자의 호출 순서는 현장 상황에 따라 변경될 수 있습니다."
        },
        {
          "b": "hand",
          "text": "※ 원외 접수처는 주차장 천막입니다. 흰색 아니고 파란색 천막입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0006",
      "type": "BR",
      "source": "공영방송 재난보도 임시편성 · 1보",
      "time": "Day 1 09:00",
      "provenance": "수집 Day 1 09:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정규 편성 중단음)"
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "정규 방송을 중단하고 재난보도를 시작합니다. 오늘 새벽부터 여러 지역 응급실에서, 원인을 알 수 없는 급성 증상 환자가 한꺼번에 늘고 있습니다. 사회부 취재기자 연결합니다."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "(전화 연결음질) 네, 권역응급의료센터 앞입니다. 취재진이 직접 확인한 곳만 세 곳— 네 곳입니다. 방금 한 곳이 추가로 확인됐습니다. 네 곳 모두 내원·대기 환자가 수용 능력을 넘어섰습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "환자들에게 공통점이 있습니까."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "입원 중이거나 이송을 기다리는 환자 가운데 남성이 대부분입니다. 다만 병원마다 집계 기준이 달라서, 지금 단계에서 전체 통계로 말씀드리기는 어렵습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "현장 상황은 어떻습니까."
        },
        {
          "b": "speech",
          "who": "사회부 기자",
          "text": "접수처가 건물 밖으로 나와 있고, 지금도 제 뒤로 줄이 이어지고 있습니다. 병원 측은 인력을 추가 투입하고 있다고만 밝혔습니다."
        },
        {
          "b": "speech",
          "who": "앵커 (여)",
          "text": "보건 당국은 지역별 사례를 취합하고 있다고 밝혔습니다. 원인과 전파 경로는 아직 확인되지 않았습니다. 확인되는 대로 다시 전해 드리겠습니다."
        }
      ]
    },
    {
      "personas": {
        "A": "밥은먹고다니자",
        "B": "막내삼촌",
        "C": "천천히걷는중",
        "D": "비오는날좋아",
        "E": "주말농장",
        "F": "내일은맑음",
        "G": "건강이최고",
        "H": "손난로",
        "I": "무소식이희소식",
        "J": "느린우체통",
        "K": "초록불",
        "L": "감기조심하세요"
      },
      "kind": "record",
      "id": "0007",
      "type": "WA",
      "source": "권역응급의료센터 대기 정보 게시판",
      "time": "Day 1 13:22",
      "provenance": "수집 Day 1 16:00 · C-2",
      "preservation": "full",
      "media": [
        {
