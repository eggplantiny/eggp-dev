    {
      "kind": "record",
      "id": "0117",
      "type": "KR",
      "source": "조선소 도장부 · 수집 세션 녹음",
      "time": "Day 30 09:30",
      "provenance": "수집 Day 36 · C-3",
      "preservation": "partial",
      "damage": {
        "duration": "02:04:55",
        "recovered": "00:00~03:08"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(옥외. 컨테이너 문 닫히는 소리.)"
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "멀리서 고생이 많소. 커피 한 잔 타 줄까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "괜찮습니다. 시작 전에 편하게 말씀 나누셔도 됩니다."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "편하게라. 요즘 배식이 열한 시 반으로 당겨졌어요. 줄이 길어서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그렇습니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "장갑도 치수가 안 맞는 것만 남았고. 내 손이 커요. 이거 봐요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(웃음) 크시네요."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "우리 집사람이 그래요. 그 손으로 어떻게 그 얇은 데를 칠하냐고."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "근데 이 일은 손 크기가 아니에요. 손목이지. 다들 손끝인 줄 아는데."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 얘기를 오늘 여쭤보려고 합니다. 얇은 데 칠하는 거요."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "그거 얘기하려면 기니까 커피부터 타고."
        },
        {
          "b": "cue",
          "text": "(물 끓는 소리.)"
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "아 그게, 그건 말이지."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료.)"
        },
        {
          "b": "cut"
        }
      ]
    },
