    {
      "kind": "record",
      "id": "0119",
      "type": "KR",
      "source": "금형 다듬기 작업대 · 수집 세션 녹음",
      "time": "Day 32 10:00",
      "provenance": "수집 Day 37 · C-3",
      "preservation": "partial",
      "damage": {
        "duration": "00:41:18",
        "recovered": "00:00~09:14"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(작업대. 연마기 도는 소리가 멈춘다.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사십칠 번. 다듬기 공정에서 어디까지가 기계고 어디부터가 손입니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "기계가 구십구를 하고 내가 일을 해요. 그런데 그 일이 없으면 안 팔리는 물건이 돼요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 일 퍼센트를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "마지막에 면을 이렇게, 이렇게 쓸어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금 손동작을 말로 설명해 주실 수 있습니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "이게 말로 하면…"
        },
        {
          "b": "silence",
          "sec": 14
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "이게 말로 하면 그냥 문지른다인데, 문지르는 게 아니에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "문지르는 게 아닌데 문지른다는 말밖에 없네."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "쓸어내리면서 듣는 거예요. 소리를. 아니다, 듣는 것도 아니고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "손끝으로 느끼시는 겁니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "그것도 아니고. 아이 참."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "우리 애들이 그러는데 이런 걸 결이라고 한다면서요. 결. 그 말이 제일 가깝네."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "결을 어떻게 아는지 여쭤도 되겠습니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "그걸 알면 내가 벌써 가르쳤지."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다음 문항으로 넘어가겠습니다. 그 방법을 아는 분이 지금 몇 분이십니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "나."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "한 분이십니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "하나 더 있었는데. 그 사람은 손이 이제 안 돼요. 떨려서."
        },
        {
          "b": "cue",
          "text": "(연마기 다시 도는 소리. 복구 구간 종료.)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0120",
      "type": "KR",
      "source": "정유 공정 제어실 · 수집 세션 녹음",
      "time": "Day 33 15:00",
      "provenance": "수집 Day 38 · C-3",
      "preservation": "partial",
      "damage": {
        "duration": "01:22:03",
        "recovered": "00:00~05:40"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(제어실 환풍음. 무전 잡음 간헐.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사십팔 번. 교대 인계 때 말로 못 넘기는 것들이 있다고 답하셨습니다."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "인계장에 쓰는 칸이 없는 것들이오. 적어 봅시다. 하나, 삼호 펌프는 기동하고 이 분은 소리가 커요. 고장 아니에요. 후임이 그거 듣고 세 번을 세웠어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "둘, 물청소 한 날 B동 계단 셋째 칸. 미끄러워요. 도색을 세 번 했는데 세 번 다 그래요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "셋, 야간에 육번 계기는 반 눈금 높게 봐요. 조명이 그래요. 그렇게 보이는 거니까 놀라지 말고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그건 인계장에 적으면 되지 않습니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "적었어요. 세 번. 세 번 다 다음 사람이 지웠어. 매뉴얼에 없는 말이라고."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "넷째도 있습니까."
        },
        {
          "b": "speech",
          "who": "숙련자",
          "text": "있지요. 넷,"
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료.)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "personas": {
        "A": "밤낚시꾼",
