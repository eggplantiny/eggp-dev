        }
      ]
    },
    {
      "kind": "record",
      "id": "0044",
      "type": "FR",
      "source": "임시 안치소 설치 현장 · 작업 녹음",
      "time": "Day 15 14:40",
      "provenance": "수집 Day 16 11:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:58:16",
        "recovered": "00:00~08:31"
      },
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0044.jpg",
          "alt": "전시관 내부. 흰 냉장 컨테이너 여러 대와 검은 전원 케이블이 중앙 통로 양쪽에 놓여 있다.",
          "caption": "제2전시관 임시 안치소 설치 현장 · Day 15"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(실내. 넓은 공간의 잔향. 지게차 후진 경고음)"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "컨테이너 다섯 번째. 왼쪽 벽에 붙여요."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "바닥 배수구 위치 보고. 호스 지나가게 한 뼘 띄우고."
        },
        {
          "b": "cue",
          "text": "(금속 접지음. 전선 릴 풀리는 소리)"
        },
        {
          "b": "speech",
          "who": "작업자 3",
          "text": "발전기 두 대 다 돌려요?"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "한 대는 예비로. 냉각 먼저 확인하고."
        },
        {
          "b": "cue",
          "text": "(발전기 시동음. 잠시 뒤 두 번째 시동음)"
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "표지판은요."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "표지판은 아직 안 왔어요. 종이로 뽑아 붙여요."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "침상은 어디로 가요."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "침상은 접수동. 전시관 정문 쪽."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "냉각기 가동음이 겹쳐서 커짐"
        },
        {
          "b": "speech",
          "who": "작업자 3",
          "text": "여기 원래 뭐 하던 데예요?"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "몰라요. 넓으면 됐지."
        },
        {
          "b": "cue",
          "text": "(지게차 경고음 계속)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
