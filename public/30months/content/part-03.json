  "items": [
    {
      "kind": "record",
      "id": "0037",
      "type": "AN",
      "source": "권역 장례식장 안내 계통",
      "time": "Day 10 09:00",
      "provenance": "수집 Day 10 10:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 안치 가능 여부를 사전 확인 후 방문해 주십시오\n\n현재 안치 접수가 일시적으로 지연되고 있습니다.\n\n- 방문 전 대표번호로 안치 가능 여부를 확인해 주시기 바랍니다.\n- 접수 순서에 따라 안내되며, 대기가 발생할 수 있습니다.\n- 빈소 배정은 안치 접수 후 순차 진행됩니다.\n\n이용에 불편을 드려 죄송합니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0038",
      "type": "FR",
      "source": "권역 장례식장 접수 창구 · 현장 녹음",
      "time": "Day 10 22:10",
      "provenance": "수집 Day 11 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(접수 창구 셔터는 한 칸만 열려 있다. 서류를 미는 얕은 틈.)"
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "사망진단서하고 인도 확인서 주세요."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "병원에서는 먼저 모셔가라고 했습니다. 차가 기다리고 있어요."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "지금 안치 자리가 없습니다. 연락처 남기시면 순서대로 연락드립니다."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "그동안은 어디에 계셔야 합니까."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "병원에 다시 말씀해 보셔야 합니다."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "병원에서는 여기로 오라고 했는데요."
        },
        {
          "b": "cue",
          "text": "(서류 봉투가 창구 틈에 그대로 놓인다.)"
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "성함하고 번호는 받아둘게요."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "오늘 밤에는 어디에 계시는지만 알려 주세요."
        },
        {
          "b": "speech",
          "who": "접수 담당",
          "text": "배정되면 연락드립니다."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "배정 전에는요."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "뒤에서 다음 번호를 묻는 목소리. 접수 담당이 같은 양식을 한 장 더 꺼낸다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0039",
      "type": "BR",
      "source": "라디오 정시 방송 · 명단 낭독",
      "time": "Day 11 18:00",
      "provenance": "수집 Day 11 18:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음)"
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "오늘 접수된 명단을 읽어 드리겠습니다."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "김영배 님, 예순여덟, 북부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "박정호 님, 쉰셋, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "이만수 님, 일흔둘, 북부권. 사망일 미상."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "정우철 님, 마흔여섯, 서부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "최병관 님, 예순하나, 동부권. 사망일 추정."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "송민규 님, 스물아홉, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "오태식 님, 쉰여덟, 서부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "임채원 님, 서른넷, 북부권. 사망일 미상."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "강대헌 님, 일흔여섯, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "문성재 님, 마흔둘, 동부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "백승기 님, 쉰다섯, 북부권. 사망일 미상."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "조영래 님, 예순셋, 서부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "서인규 님, 서른여덟, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "앞서 읽어 드린 김영배 님은 동명이인 정정 요청이 있어, 내일 확인 후 다시 안내하겠습니다."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "남은 명단은 내일 이 시간에 이어서 읽겠습니다."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "지금까지 한승호였습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0040",
      "type": "AN",
      "source": "권역 화장시설 안내 계통",
      "time": "Day 12 11:30",
      "provenance": "수집 Day 12 12:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 화장 예약 전산 접수 중단 안내\n\n- 금일 11:30부로 화장 예약 전산 접수를 중단합니다.\n- 접수는 각 시설 현장 창구에서 순번에 따라 진행합니다.\n- 기존 전산 예약분은 예약 번호 순서대로 유효합니다.\n- 재개 시점은 정해지는 대로 공지합니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0041",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 13 05:10",
      "provenance": "수집 Day 13 05:10 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0041-1.jpg",
          "alt": "동트기 전 담장을 따라 선 줄. 등을 보인 사람들. 닫힌 철문.",
          "caption": "권역 화장시설 정문 앞 · Day 13"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 새가 울기 전. 담장 쪽에서 신발 끄는 소리만 이어진다.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다섯 시 십 분. 정문 잠겨 있음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "담장 모서리부터 마흔세 명. 서 있는 사람 서른하나, 접이의자 열둘."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "번호표 기계는 정문 안쪽. 전원 꺼짐."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "첫 사람 앞에 종이 없음. 마지막 사람은 서류 봉투 두 개."
        },
        {
          "b": "cue",
          "text": "(철문 안에서 종이 묶음을 책상에 내려놓는 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "직원 한 명 들어옴. 문은 아직 안 엶."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 정문 기준."
        },
        {
          "b": "cue",
          "text": "(셔터음. 녹음 종료.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0042",
      "type": "AN",
      "source": "권역 장례식장 안내 계통",
      "time": "Day 14 08:00",
      "provenance": "수집 Day 14 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 빈소 운영이 제한됩니다\n\n- 신규 빈소 배정을 중단합니다.\n- 운영 중인 빈소는 예정된 기간까지만 유지됩니다.\n- 안치 접수와 화장 접수는 별도 안내에 따릅니다."
        }
      ]
    },
    {
