    },
    {
      "kind": "record",
      "id": "0047",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 17 08:40",
      "provenance": "수집 Day 17 08:40 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0047-1.jpg",
          "alt": "화장시설 담장과 철문. 꺼진 번호표 기계 옆 벽에 작은 흰 종이들이 겹쳐 붙어 있다.",
          "caption": "권역 화장시설 정문 · Day 17"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 차량 지나가는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 화장시설 정문 앞. 접수처 두 곳. 줄, 하나 둘… 서른둘. 번호표 기계는 꺼져 있고 수기 배부."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "대기번호판, 사천오백 번대."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "기자세요?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네. 취재 중입니다."
        },
        {
          "b": "speech",
          "who": "미상",
          "text": "저기, 인도받아도 확인이 안 되는 거요. 그거 좀 써 주세요. 서명은 했는데, 확인을 한 게 아니에요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네. 쓰겠습니다."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 접수처 두 곳. 창구 직원 세 명. 줄, 서른다섯."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0048",
      "type": "BR",
      "source": "집계 발표 브리핑",
      "time": "Day 17 11:00",
      "provenance": "수집 Day 17 11:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "사회자",
          "text": "발표 후 질의 받겠습니다."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "사망 집계 발표를 일일 단위에서 주간 단위로 전환합니다. 시군구 취합과 신고 정리에 시간이 걸리고 있어, 정확성을 위해 주기를 조정하는 것입니다."
        },
        {
          "b": "speech",
          "who": "기자 1",
          "text": "어제까지 집계된 수치는 어떻게 됩니까."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "주간 발표에 포함해 정리하겠습니다."
        },
        {
          "b": "speech",
          "who": "기자 2",
          "text": "마지막 일일 발표가 닷새 전입니다. 그동안의 수치라도 밝혀 주십시오."
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "취합 중입니다."
        },
        {
          "b": "speech",
          "who": "기자 2",
          "text": "취합 중인 규모라도—"
        },
        {
          "b": "speech",
          "who": "발표자",
          "text": "취합이 끝나는 대로 발표하겠습니다."
        },
        {
          "b": "speech",
          "who": "사회자",
          "text": "다음 질문 받겠습니다."
        },
        {
          "b": "cue",
          "text": "(질의 없음. 브리핑 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0049",
      "type": "AN",
      "source": "권역 장례식장 안내 계통",
      "time": "Day 18 08:30",
      "provenance": "수집 Day 18 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 조문객 방문을 자제하여 주십시오\n\n- 조문은 가족 최소 인원으로 제한합니다.\n- 대기 구역 운영을 중단합니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0050",
      "type": "IV",
      "source": "인터뷰",
      "time": "Month 8",
      "provenance": "수집 Month 8 · C-4",
      "attribution": {
        "subject": "화장장 운영 담당 (권역 화장시설)",
        "interviewer": "윤재경",
        "purpose": "초기 화장·안치 운영 기록수집",
        "testimonyTime": "Day 19 05:30"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그날 새벽 근무를 여쭙겠습니다. 몇 시에 나오셨습니까."
        },
        {
          "b": "speech",
          "who": "화장장 운영 담당",
          "text": "네 시 반이요. 점화 전에 볼 게 많아서요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "무엇부터 보셨습니까."
        },
        {
          "b": "speech",
          "who": "화장장 운영 담당",
          "text": "온도요. 로가 일곱 갠데 여섯만 돌리고 있었어요. 하나는 내화벽돌 갈 때가 지나서요. 그다음에 연료 게이지, 그다음에 대장이요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "대장은 어떤 상태였습니까."
        },
        {
          "b": "speech",
          "who": "화장장 운영 담당",
          "text": "수기였어요. 전산이 멎은 뒤로는 줄 공책에 번호하고 이름을 적었어요. 새벽에 제일 먼저 그날 부를 번호를 벽에 붙였고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다섯 시 반쯤에는 무엇을 하고 계셨습니까."
        },
        {
          "b": "speech",
          "who": "화장장 운영 담당",
          "text": "첫 진행이요. 유족 대기실이 비어 있었어요."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "화장장 운영 담당",
          "text": "규정에 참관 확인 서명 칸이 있는데, 빈 칸으로 두고 진행했어요. 그날이 처음이었어요. 빈 칸으로 넘긴 게."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그 새벽에 대해 더 말씀하실 것이 있습니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "화장장 운영 담당",
          "text": "여섯 시 되기 전에 두 번째 로를 열었어요. 시간표대로요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0051",
      "type": "LG",
      "source": "화장시설 운영 일지",
      "time": "Day 19 23:00",
      "provenance": "수집 Day 20 08:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
