  "items": [
    {
      "kind": "record",
      "id": "0037",
      "type": "AN",
      "source": "권역 장례식장 안내 계통",
      "time": "Day 10 09:00",
      "provenance": "수집 Day 10 10:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 안치 가능 여부를 사전 확인 후 방문해 주십시오\n\n현재 안치 접수가 일시적으로 지연되고 있습니다.\n\n- 방문 전 대표번호로 안치 가능 여부를 확인해 주시기 바랍니다.\n- 접수 순서에 따라 안내되며, 대기가 발생할 수 있습니다.\n- 빈소 배정은 안치 접수 후 순차 진행됩니다.\n\n이용에 불편을 드려 죄송합니다."
        }
      ]
    },
    {
      "personas": {
        "A": "고구마두개",
        "B": "골목길산책",
        "C": "길찾는중",
        "D": "이불밖은위험해",
        "E": "산책중",
        "F": "아침형인간",
        "G": "겨울준비"
      },
      "kind": "record",
      "id": "0038",
      "type": "WA",
      "source": "장례 정보 게시판 · 저장본",
      "time": "Day 10 22:10",
      "provenance": "수집 Day 11 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "22:10",
          "who": "A",
          "text": "어제 접수했는데 이틀 기다리라고 합니다. 원래 이런 건가요"
        },
        {
          "b": "post",
          "ts": "22:14",
          "who": "B",
          "text": "저희는 나흘이라고 들었습니다. 시설마다 다른가 봐요",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:17",
          "who": "C",
          "text": "대표번호는 하루 종일 통화중입니다. 그냥 가는 게 낫습니다"
        },
        {
          "b": "post",
          "ts": "22:20",
          "who": "D",
          "text": "가도 접수만 하고 돌아옵니다. 헛걸음이었어요",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:26",
          "who": "E",
          "text": "세 군데 전화해서 겨우 한 곳 접수했습니다. 필요하신 분 쪽지 주세요"
        },
        {
          "b": "post",
          "ts": "22:31",
          "who": "F",
          "text": "병원에서는 빨리 모셔가라고 하고 장례식장에서는 자리가 없다고 합니다. 저희는 어디에 있어야 하나요"
        },
        {
          "b": "post",
          "ts": "22:39",
          "who": "G",
          "text": "저희도 그 사이에 있습니다",
          "reply": true
        }
      ]
    },
    {
      "kind": "record",
      "id": "0039",
      "type": "BR",
      "source": "라디오 정시 방송 · 명단 낭독",
      "time": "Day 11 18:00",
      "provenance": "수집 Day 11 18:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음)"
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "오늘 접수된 명단을 읽어 드리겠습니다."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "김영배 님, 예순여덟, 북부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "박정호 님, 쉰셋, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "이만수 님, 일흔둘, 북부권. 사망일 미상."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "정우철 님, 마흔여섯, 서부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "최병관 님, 예순하나, 동부권. 사망일 추정."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "송민규 님, 스물아홉, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "오태식 님, 쉰여덟, 서부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "임채원 님, 서른넷, 북부권. 사망일 미상."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "강대헌 님, 일흔여섯, 남부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "문성재 님, 마흔둘, 동부권."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "앞서 읽어 드린 김영배 님은 동명이인 정정 요청이 있어, 내일 확인 후 다시 안내하겠습니다."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "남은 명단은 내일 이 시간에 이어서 읽겠습니다."
        },
        {
          "b": "speech",
          "who": "한승호",
          "text": "지금까지 한승호였습니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0040",
      "type": "AN",
      "source": "권역 화장시설 안내 계통",
      "time": "Day 12 11:30",
      "provenance": "수집 Day 12 12:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 화장 예약 전산 접수 중단 안내\n\n- 금일 11:30부로 화장 예약 전산 접수를 중단합니다.\n- 접수는 각 시설 현장 창구에서 순번에 따라 진행합니다.\n- 기존 전산 예약분은 예약 번호 순서대로 유효합니다.\n- 재개 시점은 정해지는 대로 공지합니다."
        }
      ]
    },
    {
      "personas": {
        "A": "집앞편의점",
        "B": "호두과자",
        "C": "국밥한그릇",
        "D": "천천히걷는중",
        "E": "평범한직장인",
        "F": "새벽운동",
        "G": "오늘도출근",
        "H": "화분에물주기"
      },
      "kind": "record",
      "id": "0041",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 12 21:40",
      "provenance": "수집 Day 13 00:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "21:40",
          "who": "A",
          "text": "예약 페이지 아직도 오류 화면인가요. 저만 그런 건가요"
        },
        {
          "b": "post",
          "ts": "21:42",
          "who": "B",
          "text": "아예 내려갔습니다. 공고 떴어요. 현장 접수랍니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "21:45",
          "who": "C",
          "text": "새벽에 가서 줄을 서야 한다는데 몇 시에 가야 하나요"
        },
        {
          "b": "post",
          "ts": "21:47",
          "who": "D",
          "text": "오늘 새벽 다섯 시에 갔는데 앞에 마흔 명 있었습니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "21:51",
          "who": "E",
          "text": "기존 예약분은 유효하다는데 지금 몇 번대까지 진행됐는지 아시는 분 계신가요"
        },
        {
          "b": "post",
          "ts": "21:54",
          "who": "F",
          "text": "대신 줄 서준다는 업체 연락 받으신 분 있으세요? 사기 같은데요"
        },
        {
          "b": "post",
          "ts": "21:56",
          "who": "G",
          "text": "신고했습니다. 조심하세요",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:02",
          "who": "H",
          "text": "저희는 그냥 기다리기로 했습니다. 어머니가 아버지 옆에 조금 더 계시고 싶다고 하셔서요"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0042",
      "type": "AN",
      "source": "권역 장례식장 안내 계통",
      "time": "Day 14 08:00",
      "provenance": "수집 Day 14 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 빈소 운영이 제한됩니다\n\n- 신규 빈소 배정을 중단합니다.\n- 운영 중인 빈소는 예정된 기간까지만 유지됩니다.\n- 안치 접수와 화장 접수는 별도 안내에 따릅니다."
        }
      ]
    },
    {
      "personas": {
        "A": "커피는아아",
        "B": "건강이최고",
        "C": "첫눈오는날",
        "D": "내일은맑음",
        "E": "큰딸입니다",
        "F": "잘부탁드립니다"
      },
      "kind": "record",
      "id": "0043",
      "type": "WA",
      "source": "장례 정보 게시판 · 저장본",
      "time": "Day 14 22:30",
      "provenance": "수집 Day 15 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "22:30",
          "who": "A",
          "text": "병원에서는 인도됐다고 하는데 안치소에서는 접수된 게 없다고 합니다. 어디에 계신 건가요"
        },
        {
          "b": "post",
          "ts": "22:34",
          "who": "B",
          "text": "이송 중일 수 있답니다. 저희는 그 상태가 이틀째입니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:37",
          "who": "C",
          "text": "지난주 금요일에 돌아가셨는데, 아니다, 목요일인가. 서류마다 날짜가 다릅니다"
        },
        {
          "b": "post",
          "ts": "22:41",
          "who": "D",
          "text": "연락 준다고 한 지 사흘 됐습니다. 대표번호로 온다던데 받으신 분 계세요"
        },
        {
          "b": "post",
          "ts": "22:45",
          "who": "E",
          "text": "그 번호는 안내 녹음만 나옵니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:52",
          "who": "F",
          "text": "기다리는 것 말고 할 수 있는 게 있으면 알려 주세요. 뭐든지요"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0044",
      "type": "FR",
      "source": "임시 안치소 설치 현장 · 작업 녹음",
      "time": "Day 15 14:40",
      "provenance": "수집 Day 16 11:00 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "00:58:16",
        "recovered": "00:00~08:31"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내. 넓은 공간의 잔향. 지게차 후진 경고음)"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "컨테이너 다섯 번째. 왼쪽 벽에 붙여요."
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "바닥 배수구 위치 보고. 호스 지나가게 한 뼘 띄우고."
        },
        {
          "b": "cue",
          "text": "(금속 접지음. 전선 릴 풀리는 소리)"
        },
        {
          "b": "speech",
          "who": "작업자 3",
          "text": "발전기 두 대 다 돌려요?"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "한 대는 예비로. 냉각 먼저 확인하고."
        },
        {
          "b": "cue",
          "text": "(발전기 시동음. 잠시 뒤 두 번째 시동음)"
        },
        {
          "b": "speech",
          "who": "작업자 2",
          "text": "침상은 어디로 가요."
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "침상은 접수동. 전시관 정문 쪽."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "냉각기 가동음이 겹쳐서 커짐"
        },
        {
          "b": "speech",
          "who": "작업자 3",
          "text": "여기 원래 뭐 하던 데예요?"
        },
        {
          "b": "speech",
          "who": "작업자 1",
          "text": "몰라요. 넓으면 됐지."
        },
        {
          "b": "cue",
          "text": "(지게차 경고음 계속)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0045",
