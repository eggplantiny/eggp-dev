    {
      "kind": "record",
      "id": "0052",
      "type": "AN",
      "source": "권역 장례식장 안내 계통",
      "time": "Day 20 09:00",
      "provenance": "수집 Day 20 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 장례 절차 없이 화장 후 인도합니다\n\n- 유골 인도는 각 시설 인도 창구에서 합니다.\n- 신분증과 접수 확인서를 지참하십시오."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0053",
      "type": "FR",
      "source": "권역 화장시설 유골 인도 창구 · 업무 녹음",
      "time": "Day 20 12:20",
      "provenance": "수집 Day 20 23:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(창구 유리 아래 서류 틈. 키보드와 라벨 프린터 소리.)"
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "신분증하고 접수 확인서 주세요."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "확인서는 없습니다. 병원에서 바로 옮겨 가셨다고만 들었어요."
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "성함하고 생년월일 말씀해 주세요."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "이름은 적어 드릴게요. 날짜는 여기 있습니다."
        },
        {
          "b": "cue",
          "text": "(종이를 미는 소리. 키보드 입력이 길어진다.)"
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "병원 반출번호는 확인됩니다. 접수번호를 새로 적어 드릴게요."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "제가 확인해야 할 건 없습니까."
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "이 번호하고 성함 보시고, 여기 인수 서명하시면 됩니다."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "안을 보는 건 아니고요."
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "봉인은 열 수 없습니다."
        },
        {
          "b": "cue",
          "text": "(라벨이 출력된다. 금속 선반에서 작은 물건을 옮기는 소리.)"
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "지정된 유골함입니다. 두 손으로 받으세요."
        },
        {
          "b": "speech",
          "who": "유가족",
          "text": "이게 전부예요?"
        },
        {
          "b": "speech",
          "who": "인도 창구 직원",
          "text": "출구는 오른쪽입니다."
        },
        {
          "b": "silence",
          "sec": 5,
          "note": "펜이 서명란 위에서 한 번 멈췄다가 다시 움직인다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0054",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 20 19:30",
      "provenance": "수집 Day 20 19:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 바람 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 물류센터 서쪽 외벽. 퇴근길에 봄."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "벽에 이름이 적혀 있다. 세로로, 위에서부터. 매직으로 쓴 것도 있고 분필도 있다. 쉰 개쯤. 더 될 수도 있고."
        },
        {
          "b": "cue",
          "text": "(발소리. 멈춤)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "조끼 입은 남자가 하나 더 적고 있다. 물류센터 조끼."
        },
        {
          "b": "silence",
          "sec": 7,
          "note": "매직 뚜껑 닫는 소리"
        },
        {
          "b": "speech",
          "who": "이름을 적는 남자",
          "text": "아는 이름만 적어요."
        },
        {
          "b": "silence",
          "sec": 5,
          "note": "바람 소리"
        },
        {
          "b": "cue",
          "text": "(셔터음 두 번)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이건 자료로 남길 수가 없다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진만 찍어둠."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    }
  ]
}
