  "items": [
    {
      "kind": "record",
      "id": "0218",
      "type": "AN",
      "source": "폐쇄 구역 지정 공고",
      "time": "Day 121 09:00",
      "provenance": "수집 Day 121 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 폐쇄 구역 지정 공고\n\n다음 구역을 폐쇄 구역으로 지정한다.\n\n폐쇄 구역 1: ○○1·2단지 및 연결 상가\n폐쇄 구역 2: ○○선 이북 주거 지역\n폐쇄 구역 3: ○○급수권 전역\n\n1. 각 구역의 이주 일정은 별도 안내한다.\n2. 잔류 사업장은 별표와 같다. 잔류 사업장 종사자의 주거는 사업장 내 지정한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0219",
      "type": "BR",
      "source": "통합 채널 정시 안내",
      "time": "Day 121 12:00",
      "provenance": "수집 Day 121 12:05 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(정시 안내음)"
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "열두 시 안내입니다. 폐쇄 구역이 지정되었습니다. 구역 목록을 읽어 드립니다."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "폐쇄 구역 일. 폐쇄 구역 이. 폐쇄 구역 삼. 상세 경계는 게시대 공고를 확인하십시오."
        },
        {
          "b": "speech",
          "who": "안내",
          "text": "이주 안내는 추후 별도로 드립니다. 이상입니다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0220",
      "type": "AN",
      "source": "이주 실행 안내",
      "time": "Day 123 09:00",
      "provenance": "수집 Day 123 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 이주 실행 안내\n\n1. 휴대 물품은 1인 40kg으로 한다.\n2. 이동일에 검수장에서 무게를 확인한다. 초과분은 현장에서 인계한다.\n3. 인계 물품은 보관하지 않는다.\n4. 가구·가전 등 대형 물품은 휴대 물품에 포함하지 않는다.\n5. 반려동물은 별도 안내에 따른다."
        }
      ]
    },
    {
      "personas": {
        "A": "햇살가득한집",
        "B": "지나가는행인1",
        "C": "오늘도출근",
        "D": "이불밖은위험해",
        "E": "잘부탁드립니다",
        "F": "산책중",
        "G": "동네빵집",
        "I": "골목길산책",
        "H": "하루하루"
      },
      "kind": "record",
      "id": "0221",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 125 22:00",
      "provenance": "수집 Day 126 07:00 · C-2",
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0221.jpg",
          "alt": "골목에 내놓인 피아노. 위에 덮인 담요가 반쯤 흘러내렸다.",
          "caption": "게시판 첨부 · Day 125"
        }
      ],
      "blocks": [
        {
          "b": "post",
          "ts": "22:00",
          "who": "A",
          "text": "사십 킬로가 생각보다 없습니다. 이불 한 채에 사 킬로예요. 다들 뭐부터 빼셨나요"
        },
        {
          "b": "post",
          "ts": "22:06",
          "who": "B",
          "text": "책부터 뺐습니다. 제일 무겁고, 제일 안 급해서요. 그렇게 정리하고 나니 이상하게 서운한 건 책이더라고요",
          "reply": true
        },
        {
          "b": "post",
          "ts": "22:13",
          "who": "C",
          "text": "앨범은 사진만 빼서 봉투에 넣으세요. 틀이 무겁습니다"
        },
        {
          "b": "post",
          "ts": "22:20",
          "who": "D",
          "text": "저희 골목에 피아노가 나왔습니다. 누가 담요까지 덮어놨어요. 사진 올립니다"
        },
        {
          "b": "post",
          "ts": "22:27",
          "who": "E",
          "text": "저 집 아이가 치던 겁니다. 저녁마다 들렸어요",
          "re": "D"
        },
        {
          "b": "post",
          "ts": "22:35",
          "who": "F",
          "text": "항아리는 어떻게들 하시나요. 어머니가 장을 삼 년 치 담가놓으셨는데요"
        },
        {
          "b": "post",
          "ts": "22:44",
          "who": "G",
          "text": "저희는 이웃 잔류 세대에 드렸습니다. 완성되면 소식이나 전해달라고 했습니다",
          "re": "F"
        },
        {
          "b": "post",
          "ts": "22:49",
          "who": "F",
          "text": "잔류 세대가 이웃에 없으면 어떻게 하나요",
          "re": "G"
        },
        {
          "b": "post",
          "ts": "22:54",
          "who": "G",
          "text": "…그럼 땅에 묻어두고 가는 집도 있답니다. 장은 몇 년 가니까요. 언제 와서 파낼지는 모르지만요",
          "re": "F"
        },
        {
          "b": "post",
          "ts": "22:51",
          "who": "I",
          "text": "다들 저울 어디서 구하셨나요. 문구점 것은 삼십 킬로까지밖에 안 됩니다"
        },
        {
          "b": "post",
          "ts": "22:56",
          "who": "B",
          "text": "목욕탕 체중계로 몸무게 빼기로 재세요. 안고 올라가서요",
          "re": "I"
        },
        {
          "b": "post",
          "ts": "23:02",
          "who": "H",
          "text": "무게 재다가 알았는데, 저희 집에서 제일 무거운 게 문패였습니다. 돌이라서요. 그건 그냥 두고 가기로 했습니다"
        },
        {
          "b": "post",
          "ts": "23:11",
          "who": "C",
          "text": "문패는 떼 가시는 게 어때요. 무거워도요",
          "re": "H"
        },
        {
          "b": "post",
          "ts": "23:19",
          "who": "H",
          "text": "…떼서 재봤습니다. 삼 점 이 킬로. 넣겠습니다. 이불을 뺄게요",
          "re": "C"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0222",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 128",
      "provenance": "수집 Day 128 · C-2",
      "attribution": {
        "subject": "이주 세대 (폐쇄 구역 1)",
        "interviewer": "윤재경",
        "purpose": "거주지 이전 기록수집",
        "testimonyTime": "Day 128 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "짐 정리를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "사십 킬로 곱하기 넷이니까 백육십. 그렇게 계산하면 될 줄 알았는데, 아니더라고요. 애들 것 빼고 나면 어른 몫이 줄어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "무엇이 제일 어려우셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "피아노요. 둘째가 쳐요. 오 년 됐어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "어떻게 하기로 하셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "두고 가요. 처음부터 답은 정해져 있었어요. 사십 킬로에 피아노가 들어갈 리가 없잖아요. 답이 정해져 있는데도 일주일을 못 정했어요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "이상하지요. 정할 게 없는데 못 정한다는 게. 그 일주일 동안 저희 부부가 정한 건 피아노가 아니라, 애한테 언제 말하느냐였어요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "애가 마지막으로 한 번 치게 해달라고 했어요. 그래서 그저께 저녁에, 이사 전 마지막으로 쳤어요. 동네 사람 몇이 골목에 서서 들었어요. 아무도 뭐라고 안 하고 그냥 들었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아이는 지금 어떻습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "괜찮아 보여요. 괜찮아 보이는 게 마음에 걸려요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "어제는 이삿짐 목록을 자기가 적겠다고 하더니, 연필로 꾹꾹 눌러서 적었어요. 크레파스, 문제집, 곰인형. 세 개 다 합쳐서 이 킬로도 안 돼요. 애들 짐이 제일 가벼워요. 그게 이상하게 미안해요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "피아노는 지금 어디에 있습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "거실에요. 제자리에요. 담요 덮어서 제자리에 두고 문 잠그고 나갈 거예요. 골목에 내놓는 건 못 하겠어요. 그건 버리는 거잖아요. 두고 가는 거랑 버리는 건 달라요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0223",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 130",
      "provenance": "수집 Day 130 · C-2",
      "attribution": {
        "subject": "이주 대상 주민 (폐쇄 구역 2)",
        "interviewer": "기록수집 4반",
        "purpose": "거주지 이전 기록수집",
        "testimonyTime": "Day 130 11:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "구역 지정을 들으셨을 때부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "방송으로 들었어요. 폐쇄 구역 이. 우리 동네가 번호가 됐구나, 그 생각부터 했어요."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "동네 규모를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "팔천이라고들 해요. 정확한 건 명부가 알겠고. 학교 둘, 시장 하나, 목욕탕 하나."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "잔류 사업장에 대해 아시는 대로 말씀해 주십시오."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "밸브 공장요. 삼백 명. 우리 동네 사람도 여럿 다녔어요. 공장은 남고 사람은 가고. 다니던 사람들은 기숙사로 들어간대요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "팔천이 나가고 삼백이 남는 셈이 어떻게 나온 건지는 몰라요. 우리한테 물어본 사람은 없었고요. 셈은 위에서 하고, 짐은 우리가 싸고."
        },
        {
          "b": "speech",
          "who": "기록수집 4반",
          "text": "목욕탕 얘기를 하셨습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "아, 그 목욕탕이 물이 좋아요. 오십 년 됐어요. 주인 영감님이 잔류 신청을 했다는 소문이 있었는데, 사업장이 아니라서 안 된대요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "마지막 날 무료로 열었어요. 동네 사람 다 왔어요. 수건을 못 받아 갈까 봐 다들 자기 수건을 들고요. 그런 줄이었어요, 마지막 줄이."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0224",
      "type": "LG",
      "source": "짐 검수 대장 · 1일차",
      "time": "Day 132 18:00",
      "provenance": "수집 Day 132 19:00 · C-2",
