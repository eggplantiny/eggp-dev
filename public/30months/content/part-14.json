      "blocks": [
        {
          "b": "ledger",
          "name": "짐 검수 대장 (1일차)",
          "rows": "검수 세대            412\n기준 내 통과         289\n현장 인계 발생       123\n인계 품목   책 상자 41 · 장롱(분해) 7 · 재봉틀 5 · 항아리 12 · 공구함 9 · 화분 22 · 피아노 1 · 기타 별지",
          "note": "재검수 요청 17건. 전량 재검수 후 통과.\n인계 물품은 적치장으로 이동. 이후 처리는 별도 지침.\n저울 2번기 오차 0.2kg 확인. 다음 일차부터 보정."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0225",
      "type": "FR",
      "source": "이주 검수장 · 상시 녹음",
      "time": "Day 133 09:40",
      "provenance": "수집 Day 134 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실외 천막. 저울 삑 소리. 줄 선 발소리.)"
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "삼십팔 점 육. 통과요. 다음 분."
        },
        {
          "b": "cue",
          "text": "(가방 끄는 소리. 저울 소리.)"
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "사십 점 이. 이백 그램 빼세요."
        },
        {
          "b": "speech",
          "who": "목소리",
          "text": "이백 그램을 뭘 빼요."
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "뭐든요. 죄송해요. 기준이 그래서요."
        },
        {
          "b": "cue",
          "text": "(지퍼 소리. 부스럭. 잠시 침묵.)"
        },
        {
          "b": "speech",
          "who": "목소리",
          "text": "…됐어요. 다시 달아요."
        },
        {
          "b": "cue",
          "text": "(저울 소리.)"
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "삼십구 점 팔. 통과요."
        },
        {
          "b": "silence",
          "sec": 14,
          "note": "저울 소리 반복"
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "(작게, 옆으로) 언니, 아까 그분 뭐 뺐어?"
        },
        {
          "b": "speech",
          "who": "검수원 2",
          "text": "(작게) 못 봤어. 보지 마. 보면 하루 못 버텨."
        },
        {
          "b": "cue",
          "text": "(저울 소리. 다음 사람.)"
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "이십팔 점 삼. 통과요."
        },
        {
          "b": "speech",
          "who": "목소리 2",
          "text": "저기, 남는 무게에 남의 짐 실어도 되나요. 옆집 할머니가 십이 킬로밖에 안 되셔서."
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "세대 합산은 안 되고요…"
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "할머님 가방에 넣어서 할머님이 드시면 돼요."
        },
        {
          "b": "speech",
          "who": "목소리 2",
          "text": "아. 고맙습니다."
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "제가 한 말 아니에요. 규정에 그렇게 돼 있어요."
        },
        {
          "b": "cue",
          "text": "(저울 소리. 삑. 삑.)"
        },
        {
          "b": "speech",
          "who": "검수원 2",
          "text": "(작게) 3번기 아직 이백 남게 나와. 오늘도 보정 안 됐어."
        },
        {
          "b": "speech",
          "who": "검수원",
          "text": "(작게) 그럼 아까 그분…"
        },
        {
          "b": "speech",
          "who": "검수원 2",
          "text": "(작게) 다음 분."
        },
        {
          "b": "cue",
          "text": "(저울 소리 계속.)"
        }
      ]
    },
