    {
      "kind": "record",
      "id": "0231",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 143",
      "provenance": "수집 Day 143 · C-2",
      "attribution": {
        "subject": "재이동 대상자",
        "interviewer": "윤재경",
        "purpose": "거주지 이전 기록수집",
        "testimonyTime": "Day 143 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "두 번째 통지를 받으셨습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "도착한 지 열흘 됐어요. 열흘. 짐도 다 안 풀었어요. 반은 풀고 반은 그대로 뒀는데, 안 푼 반이 맞았네요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "열흘 동안 어떠셨습니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "물이 부족하다는 건 알았어요. 급수차가 이틀에 한 번 왔으니까. 그래도 다들 참았어요. 새로 온 데니까 그러려니 했지요. 참는 거랑 다시 나가는 거랑은 다른 얘기지만요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "통지를 받으셨을 때를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "여기가 마지막이라고 했잖아요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "아니에요?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "…통지문을 다시 읽어 드리겠습니다. 첫 통지문입니다. 이동일, 목적지, 휴대 물품 기준, 지원 사항. 두 번째 통지문입니다. 이동일, 새 목적지, 휴대 물품 기준, 지원 사항."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "마지막이라는 말이 없네요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "…네. 없습니다."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "그럼 우리가 어디서 들은 걸까요, 그 말을."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "아무도 안 했는데 다들 들었다고 생각한 거네요. 듣고 싶었으니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이번 이동 준비는 어떠십니까."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "빨라요. 짐이 그대로니까요. 풀었던 반만 다시 싸면 돼요."
        },
        {
          "b": "speech",
          "who": "대상자",
          "text": "이번에는 반도 안 풀 거예요. 세면도구만 꺼내고요. 그게 배운 거라면 배운 거네요."
        }
      ]
    },
