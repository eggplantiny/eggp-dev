    {
      "kind": "record",
      "id": "0296",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 306",
      "provenance": "수집 Day 306 · C-2",
      "attribution": {
        "subject": "타 회랑 기록 실무자",
        "interviewer": "윤재경",
        "purpose": "기록수집 운영 기록수집",
        "testimonyTime": "Day 306 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "그쪽 회랑의 수집을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "우리는 늦게 시작했어요. 여기가 명단 만들 때 우리는 다른 게 급했거든요. 급수가 급했고, 배급이 급했고. 다 급했으니까요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "시작하셨을 때의 상황을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "질문지가 왔어요. 좋은 질문지였어요. 이전 답변을 읽고 다음 질문을 만드는 방식이고."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "물어볼 사람은 있었어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "질문지를 만들었을 때는 없었죠."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "원망할 데를 찾아봤는데요. 없어요. 다들 자기 급한 걸 했을 뿐이라. 그게 제일… 그게 제일 그래요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "지금 그쪽 회랑은 어떻게 하고 있습니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "여기 정정 기록을 받아 가요. 남의 현장 기록인데, 없는 것보단 나으니까. 우리 설비랑 안 맞는 것도 많은데, 안 맞는 걸 알아내는 데도 그 기록이 필요해요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "이곳에는 무엇을 주십니까."
        },
        {
          "b": "speech",
          "who": "실무자",
          "text": "줄 게… 우리 실패 기록요. 뭘 안 했더니 어떻게 됐는지는 우리가 제일 잘 아니까. 그것도 기록은 기록이더라고요. 받는 쪽이 있어요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0297",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 309",
      "provenance": "수집 Day 309 · C-2",
      "attribution": {
        "subject": "정비 3반 신입",
        "interviewer": "기록수집 4반",
        "purpose": "산업 운영 기록수집",
        "testimonyTime": "Day 309 15:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "교육받은 것 중 기억에 남는 것을 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님이 그러는데, 펌프는 발로도 들으래요. 바닥 울림으로요. 처음엔 무슨 말인가 했는데 이제 조금 알아요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "절차 문서와 반장 지시가 다르면 어느 쪽을 따르십니까."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "즉답이시네요. 이유를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님은 틀리면 고쳐요. 지난주에도 자기가 가르친 거 하나 틀렸다고 아침 조회에서 고쳤어요. 매뉴얼은 안 고치잖아요."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "…아니다. 요즘은 매뉴얼도 고쳐지네요. 반장님이 고치니까."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "이 일을 계속하실 생각이십니까."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "네. 처음엔 배치라서 왔는데요. 요즘은… 소리가 들려요. 펌프 소리가 정상인지 아닌지, 지나가다가 들려요. 들리기 시작하면 이 일 하는 거래요, 반장님이."
        }
      ]
    },
