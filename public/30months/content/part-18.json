      "media": [
        {
          "type": "image",
          "src": "/30months/m/0299.jpg",
          "alt": "같은 부두, 같은 자리. 앞쪽에 검은 계선주와 감긴 줄, 난간, 그 너머 화물선 한 척과 크레인 둘, 뒤로 산줄기. 정박선은 지난번과 다른 배다.",
          "caption": "부산항 제7부두 재방문 · Day 313"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 파도. 멀리 크레인 소리.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 제7부두. 열여섯 시 삼십 분. 두 번째."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "같은 자리. 계선주. 난간. 크레인 둘. 산."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다른 것. 그림자 방향. 그때는 저녁이었고 지금은 낮이다. 팔레트 더미 없음. 배는 다른 배. 그때 그 배보다 작다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "같은 것. 계선주의 줄 자국. 난간 세 번째 기둥의 녹. 녹이 조금 넓어졌다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 같은 각도. 지난번 사진을 꺼내 들고 맞춰 본다."
        },
        {
          "b": "cue",
          "text": "(촬영음 한 번.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하역장에 그때 그 차가 오는 날인지 물었다. 오늘은 아니라고 한다. 다음에."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "줄 자국. 녹. 배. 다음에."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
