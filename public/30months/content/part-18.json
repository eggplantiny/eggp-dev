  "items": [
    {
      "kind": "record",
      "id": "0284",
      "type": "AN",
      "source": "현장 권한 조정 공지",
      "time": "Day 271 09:00",
      "provenance": "수집 Day 271 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 현장 절차 정정 권한 공지\n\n1. 현장 책임자는 절차 문서와 현장이 다를 때 절차를 정정할 수 있다.\n2. 정정은 사유와 함께 기록하며, 기록 즉시 적용된다.\n3. 정정 기록은 교육 자료에 반영한다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0285",
      "type": "FR",
      "source": "반응기동 조작실 · 상시 녹음",
      "time": "Day 274 06:00",
      "provenance": "수집 Day 275 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(조작실. 새벽. 의자 소리)"
        },
        {
          "b": "speech",
          "who": "야간",
          "text": "밤새 특이사항 없고요. 삼호기 압이 새벽에 살짝 놀았는데 자리 잡았어요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "몇 시에요?"
        },
        {
          "b": "speech",
          "who": "야간",
          "text": "세 시 반쯤요. 로그에 있어요. 소리도 같이 적어놨어요. 낮게 웅 하다가 돌아왔다고."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "(종이 넘기는 소리) 확인. 오늘 주간 확인 항목 부를게요. 삼호기 압 추이. 냉각수 라인. 이번 주 들어온 재생 씰. 순서 이대로 봐요."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "매뉴얼에는 냉각수가 먼저인데요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "부른 순서로 봐요. 이유는 이따 현장에서 보여줄게요."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "야간",
          "text": "(하품 소리) 아, 그리고 재생 씰 소리요. 밤에 두 번 끼익 하고 조용해졌어요. 반장님이 말한 그대로던데요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "두 번이면 자리 잡은 거예요. 수고했어요. 가서 자요."
        },
        {
          "b": "cue",
          "text": "(발소리. 문소리)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0286",
      "type": "KR",
      "source": "정정 채록 · ○○ 반응기동",
      "time": "Day 277 10:00",
      "provenance": "수집 Day 284 · C-3",
      "preservation": "partial",
      "damage": {
        "duration": "00:41:12",
        "recovered": "00:00~05:22"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(현장 소음)"
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "절차서 삼십칠 항 읽을게요. \"밸브 개방 후 오 분 대기.\" 이거요, 현장은 오 분이 아니에요."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "현장 값을 말씀해 주십시오."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "여름엔 오 분 맞아요. 지금 같은 때는 팔 분. 계기 바늘이 자리 잡는 걸 보고 여는 거지, 시계 보고 여는 게 아니에요."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "정정 기록합니다. 삼십칠 항, 계절 조건 추가. 근거를 말씀해 주십시오."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "근거는… 지난달에 오 분 만에 열었다가 압 튄 거. 그거 로그 있잖아요. 그게 근거예요."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "기록했습니다. 다음 항목 말씀해 주십시오."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0287",
      "type": "LG",
      "source": "정정 접수 대장 · 월간",
      "time": "Day 280 18:00",
      "provenance": "수집 Day 280 19:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "절차 정정 접수 대장 (월간)",
          "rows": "접수              12\n채택              12\n반려               0\n반별   정비 3반 7 · 정비 1반 3 · 운전반 2",
          "note": "교육 자료 반영 완료 9건, 반영 중 3건."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0288",
      "type": "FR",
      "source": "반응기동 조작실 · 상시 녹음",
      "time": "Day 283 14:20",
      "provenance": "수집 Day 284 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(조작실. 안내 음성 톤)"
        },
        {
          "b": "speech",
          "who": "시스템",
          "text": "삼호기 세정 절차를 시작합니다. 순환 펌프를 먼저 기동하십시오."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "아뇨. 여기서는 그렇게 하면 안 돼요."
        },
        {
          "b": "speech",
          "who": "시스템",
          "text": "이유를 설명하십시오."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "재생 씰이에요, 지금 들어간 게. 신품 기준으로 돌리면 초반 압을 못 버텨요. 바이패스 먼저 열고, 압 반으로 낮춰서 기동하고, 씰 자리 잡는 소리 확인하고 본압으로 올려요."
        },
        {
          "b": "speech",
          "who": "시스템",
          "text": "소리 확인의 기준을 설명하십시오."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "…끼익 소리가 두 번 나고 멈추면 자리 잡은 거예요. 세 번 이상 이어지면 세워요."
        },
        {
          "b": "speech",
          "who": "시스템",
          "text": "기록했습니다. 절차를 갱신합니다. 갱신 절차로 진행하시겠습니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "진행해요."
        },
        {
          "b": "speech",
          "who": "시스템",
          "text": "갱신된 절차로 진행합니다. 바이패스 개방."
        },
        {
          "b": "cue",
          "text": "(밸브 소리. 펌프 기동음. 잠시 뒤, 끼익 소리 두 번. 멈춤)"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "(작게) 됐다."
        },
        {
          "b": "cue",
          "text": "(본압 상승음)"
        }
      ]
    },
    {
      "personas": {
        "A": "바람쐬는중",
        "B": "라떼한잔",
        "C": "따뜻한물한잔",
        "D": "늦잠자고싶다",
        "E": "지나가는행인1",
        "F": "감기조심하세요",
        "G": "창가자리",
        "H": "밥은먹고다니자"
      },
      "kind": "record",
      "id": "0289",
      "type": "WA",
      "source": "시민 생활정보 게시판 · 저장본",
      "time": "Day 286 21:00",
      "provenance": "수집 Day 287 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "post",
          "ts": "21:00",
          "who": "A",
          "text": "새벽 교대 도시락 싸시는 분들, 보온통 뭐 쓰세요. 국이 점심까지 식습니다"
        },
        {
          "b": "post",
          "ts": "21:06",
          "who": "B",
          "text": "스텐 이중으로 쓰고, 아침에 끓는 물로 통을 한 번 데우고 담으세요. 그게 제일 큽니다",
          "reply": true
        },
        {
          "b": "post",
          "ts": "21:14",
          "who": "C",
          "text": "저희 집은 아내가 새벽 조라 제가 쌉니다. 반년째인데 이제 김치를 따로 싸는 경지에 올랐습니다"
        },
        {
          "b": "post",
          "ts": "21:22",
          "who": "D",
          "text": "김치 국물 분리, 그게 고수지요",
          "re": "C"
        },
        {
          "b": "post",
          "ts": "21:31",
          "who": "E",
          "text": "아내가 이번에 반장이 됐습니다. 별말 없이 지나가려다가, 여기라도 적어둡니다. 저녁에 고기 구웠습니다"
        },
        {
          "b": "post",
          "ts": "21:39",
          "who": "B",
          "text": "축하드립니다. 고기 굽는 집이 늘어야 합니다",
          "re": "E"
        },
        {
          "b": "post",
          "ts": "21:52",
          "who": "F",
          "text": "축하드립니다. 우리 집도 곧 굽기를 바라며",
          "re": "E"
        },
        {
          "b": "post",
          "ts": "22:05",
          "who": "G",
          "text": "밤 근무 마치고 오는 아내를 위해 아침에 국 끓여 놓는 법 공유합니다. 무를 얇게 썰어야 빨리 무릅니다"
        },
        {
          "b": "post",
          "ts": "22:14",
          "who": "A",
          "text": "받아 적었습니다. 내일 해봅니다",
          "re": "G"
        },
        {
          "b": "post",
          "ts": "22:31",
          "who": "H",
          "text": "이 게시판이 몇 달 전엔 이유식 게시판이더니 요즘은 교대 도시락 게시판이 됐네요. 애들이 큰 것도 아닌데요"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0290",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 288 16:00",
      "provenance": "수집 Day 288 16:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0290.jpg",
          "alt": "책상 위 두 개의 기록지 뭉치. 얇은 것과 세 배 두꺼운 것.",
          "caption": "정정 기록 보존분 · Day 288"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내. 종이 뭉치 놓는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 정정 기록 보존분. 이관 전 확인."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "석 달 전 뭉치, 열한 장. 이번 달 뭉치, 서른네 장."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "자로 잰다. 사 밀리. 십삼 밀리."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "서식이 같아서 두께 차이가 그대로 양의 차이다. 사진 한 장, 나란히 놓고."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "석 달 전엔 질문지가 사람을 찾아다녔다. 요즘 뭉치는 사람이 질문지를 고친 기록이다. 종이는 같은 종이다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "서명란을 본다. 석 달 전 뭉치는 수집원 서명이다. 이번 뭉치는 현장 서명이다. 글씨가 눌려 있다. 장갑 낀 손으로 쓴 글씨다."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0291",
      "type": "KR",
      "source": "정정 채록 · ○○ 반응기동",
      "time": "Day 291 10:00",
      "provenance": "수집 Day 298 · C-3",
      "preservation": "partial",
      "damage": {
        "duration": "00:37:40",
        "recovered": "00:00~04:05"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(현장 소음. 바람)"
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "겨울 기동 대기 시간요. 절차서엔 이십 분인데, 작년 겨울 값으로는 삼십오 분은 봐야 해요."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "작년 겨울의 근거 기록이 있습니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "기록은… 내 몸이 기록이에요. 이십 분에 돌렸다가 배관 두 번 울었어요. 그 소리 들으면 알아요."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "몸의 기록은 수치화가 어렵습니다. 참고 기록으로 남기고, 금년 계측을 병행 기록하겠습니다."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "그래요. 계측해 봐요. 삼십오 분 나올 테니까."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "계측 결과가 다르면 어느 쪽을 기록해야 합니까."
        },
        {
          "b": "speech",
          "who": "작업자",
          "text": "둘 다 적어요. 내 값이랑 계측값이랑. 겨울마다 다시 재 보고. 그러라고 적는 거 아니에요?"
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "…기록했습니다."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0292",
      "type": "AN",
      "source": "교육 과정 개편 공지",
      "time": "Day 294 09:00",
      "provenance": "수집 Day 294 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 산업 교육 과정 개편 공지\n\n1. 교육 자료에 현장 정정 반영분을 포함한다.\n2. 강사진에 현장 책임자 항목을 신설한다. 위촉은 반별 추천에 따른다.\n3. 시행: 다음 기수부터."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0293",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 297",
      "provenance": "수집 Day 297 · C-2",
      "attribution": {
        "subject": "정비 3반 반장",
        "interviewer": "윤재경",
        "purpose": "산업 운영 기록수집",
        "testimonyTime": "Day 297 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "반장이 되신 경위를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "위가 비어서요. 그게 다예요. 잘해서 된 게 아니라 순서가 와서 됐어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "현장 몇 개월 차에 반장이 되셨습니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "일곱 달요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "일곱 달 만에 반장이 되는 것에 대해 어떻게 생각하십니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "생각 안 해요. 생각하면 무서우니까. 아침에 확인 항목 부르고, 낮에 현장 돌고, 저녁에 신입들 가르치고. 그러다 보면 하루가 가요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "배우신 분들 이야기를 여쭤도 되겠습니까."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "그 얘기는 넘어가요. 다음 질문요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "알겠습니다. …정정 대장을 보니 3반이 일곱 건입니다. 다른 반의 두 배가 넘습니다."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "우리 반이 신입이 많아요. 신입이 물으면 내가 답해야 하고, 답하려면 내가 확실해야 하고, 확실하려면 절차서를 다시 봐야 해요. 다시 보면 틀린 게 보여요. 그래서 많아요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "신입이 정정을 만든다는 말씀이시네요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "질문이 정정을 만들죠. 물어볼 사람이 있을 때 물어야 하고요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "…신입들에게 무엇을 먼저 가르치십니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "소리요. 계기보다 소리가 먼저예요. 정상 소리를 외우게 해요. 정상을 알아야 이상을 아니까."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그 교육법은 어디서 오셨습니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "어디서 왔더라. …모르겠어요. 어느새 그렇게 하고 있었어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "처음 현장에 오셨을 때와 지금을 비교해 주시겠습니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "처음엔 다 물어봤어요. 시스템한테요. 이거 눌러도 되냐, 이 소리 정상이냐. 시스템이 하라는 대로 했어요. 그래야 안 무서웠으니까."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "지금은요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "지금은 시스템이 저한테 물어요. 이유를 설명하라고. 설명하면 받아 적고요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "언제 바뀌었는지 모르겠어요. 어느 날 보니까 바뀌어 있었어요. 무서운 건 똑같아요. 무서운 자리가 바뀌었을 뿐이지."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "무서운 자리가 어디로 갔습니까."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "옛날엔 내가 틀릴까 봐 무서웠고, 지금은 내가 마지막일까 봐 무서워요. 나 다음에 물어볼 데가 있나, 그게."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0294",
      "type": "FR",
      "source": "현장 수칙판 앞 · 상시 녹음",
      "time": "Day 300 09:10",
      "provenance": "수집 Day 301 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(옥외. 바람에 종이 소리)"
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "(읽는 소리) 하나. 비 오는 날 B동 계단 셋째 칸 조심."
        },
        {
          "b": "speech",
          "who": "선배",
          "text": "어. 미끄러워. 도색을 몇 번을 해도 그래."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "둘. 육번 계기는 야간에 반 눈금 높게 본다."
        },
        {
          "b": "speech",
          "who": "선배",
          "text": "조명 때문에 그렇게 보이는 거야. 놀라지 말라고."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "이거 다 매뉴얼엔 없죠?"
        },
        {
          "b": "speech",
          "who": "선배",
          "text": "없지. 그건 종이에 없고 벽에만 있어. 벽 거를 외워."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "누가 적기 시작한 거예요?"
        },
        {
          "b": "speech",
          "who": "선배",
          "text": "몰라. 내가 왔을 때도 있었어."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "벽 거는 안 지워져요?"
        },
        {
          "b": "speech",
          "who": "선배",
          "text": "지워지지. 비 들이치면. 그래서 지워지기 전에 다들 자기 수첩에 옮겨 적어. 벽은 원본이 아니라 게시판이야. 원본은 수첩들이고."
        },
        {
          "b": "cue",
          "text": "(종이 소리 계속)"
        }
      ]
    },
