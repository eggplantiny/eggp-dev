    },
    {
      "kind": "record",
      "id": "0296",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 306 14:00",
      "provenance": "수집 Day 306 16:00 · C-2",
      "attribution": {
        "subject": "타 회랑 기술·안전교육 담당",
        "interviewer": "윤재경",
        "purpose": "기록수집 운영 기록수집",
        "testimonyTime": "Day 306 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그쪽의 수집 개시 시점부터 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "여기보다 다섯 달 늦었어요. 그때 저희는 급수가 먼저였고요. 급수 다음이 배급이었고. 교육은 그다음 다음이었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "질문지는 언제 완성되었습니까."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "서른두 문항이요. 완성은 됐어요. 이전 답변을 읽고 다음 문항을 만드는 방식이라 좋은 질문지였어요. 문항 하나 만드는 데 사흘씩 걸렸고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "왜 그때였습니까."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "그때 손이 났으니까요. 그 전에는 손이 없었고요."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "물어볼 사람은 있었어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "질문지를 만들었을 때는 없었죠."
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "대상자 명단은 어떻게 되어 있습니까."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "셋에서 하나, 하나에서 영. 일정표는 계속 갱신해요. 대상자가 영인데도요. 갱신을 안 하면 그 과정이 없어지니까. 없어지면 누가 빠졌는지도 안 남아요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그러면 지금은 무엇으로 교육하십니까."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "여기 정정 채록을 받아 가요. 남의 설비 기록이라 저희 설비랑 안 맞는 게 많은데, 안 맞는 걸 알아내는 데도 그 기록이 필요하더라고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이곳에 주시는 것은요."
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "안 한 기록이요. 뭘 안 했더니 어떻게 됐는지. 그건 저희가 제일 자세하니까요. 그것도 받는 쪽이 있어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "누구에게 물었어야 했다고 보십니까."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "교육 담당",
          "text": "그분들 이름은 명단에 있어요. 명단은 저한테 있고요. 그건 답이 되나요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0297",
      "type": "KR",
      "source": "기록수집 4반 면담 · ○○ 반응기동 정비 3반 신입",
      "time": "Day 309 15:00",
      "provenance": "수집 Day 309 16:00 · C-2",
      "preservation": "full",
      "damage": {
        "duration": "00:18:40"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(교육장. 의자 소리.)"
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "교육받은 것 중에 남는 것부터 말씀해 주십시오."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님이 그러는데, 펌프는 발로도 들으래요. 바닥 울림으로요. 처음엔 무슨 소린가 했는데 지금은 조금 알아요. 신발 벗으면 더 잘 들리고요."
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "절차 문서와 반장 지시가 다르면 어느 쪽을 따르십니까."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님요."
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "이유를 여쭙겠습니다."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "반장님은 틀리면 고쳐요. 지난주에도 자기가 가르친 거 하나 틀렸다고 아침에 고쳤어요. 씰 소리 세 번이 아니라 두 번이라고. 매뉴얼은 안 고치잖아요."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "아니다. 요즘은 매뉴얼도 고쳐지네요. 반장님이 고치니까."
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "고쳐진 매뉴얼은 어디서 보십니까."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "교육 자료요. 지난달 거랑 이번 달 거랑 삼십칠 항이 달라요. 제가 비교해 봤어요. 아무도 시키진 않았는데."
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "왜 비교해 보셨습니까."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "어느 쪽을 외워야 하는지 알아야 하니까요. 둘 다 외우면 헷갈려요."
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "이 일을 계속하실 생각이십니까."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "네. 처음엔 배치라서 왔는데요. 요즘은 소리가 들려요. 지나가다가요. 펌프가 정상인지 아닌지. 들리기 시작하면 이 일 하는 거래요. 반장님이요."
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "반장님이라는 말이 오늘 여덟 번 나왔습니다."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "세셨어요?"
        },
        {
          "b": "speech",
          "who": "수집원",
          "text": "기록하는 일이라서요."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "아홉 번요. 지금."
        },
        {
          "b": "cue",
          "text": "(의자 소리.)"
        }
      ]
    },
