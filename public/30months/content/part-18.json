    {
      "kind": "record",
      "id": "0301",
      "type": "FR",
      "source": "신입 교육 현장 · 상시 녹음",
      "time": "Day 315 10:20",
      "provenance": "수집 Day 315 11:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(교육장. 분필 소리)"
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "(외우는 소리) 기동 전 확인. 하나, 윤활유 레벨. 둘, 냉각수. 셋, 벨트 장력…"
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "잠깐. 둘하고 셋 사이에 하나 더 있어요."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "절차서엔 셋이 벨트인데요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "손등을 모터 케이스에 대 봐요. 어제 돌린 놈이면 미지근해요. 차가우면 오래 선 놈이니까 기동을 천천히 하고."
        },
        {
          "b": "speech",
          "who": "신입",
          "text": "그건 매뉴얼에 없는데요."
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "그건 매뉴얼에 없어요."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "반장",
          "text": "적어요. 적고 나서 외워요."
        },
        {
          "b": "cue",
          "text": "(연필 소리. 분필 소리 계속)"
        }
      ]
