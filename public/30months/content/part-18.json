    {
      "kind": "record",
      "id": "0299",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 313 16:30",
      "provenance": "수집 Day 313 16:30 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0299.jpg",
          "alt": "같은 부두, 같은 자리. 가을 빛. 계선주와 난간, 다른 배.",
          "caption": "부산항 제7부두 재방문 · Day 313"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 파도. 갈매기)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 제7부두. 열여섯 시 반. 두 번째."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "같은 자리에 선다. 계선주, 난간, 크레인 둘, 산."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다른 것. 빛. 그때는 겨울 저녁이었고 지금은 가을 낮이다. 팔레트 더미 없음. 배는 다른 배. 그때 그 배보다 작다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "같은 것. 계선주의 밧줄 자국. 난간 세 번째 기둥의 녹. 녹은 조금 넓어졌다. 같은 것도 조금씩 다른 것이 되는 중이다."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 같은 각도. 지난번 사진을 꺼내 들고 맞춰 본다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그때 동승했던 트럭이 오는 날인지 하역장에 물어봤다. 오늘은 아니라고 한다. 다음에."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
