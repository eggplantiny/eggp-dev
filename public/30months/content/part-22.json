      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(무선 잡음. 사무실 소리.)"
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "17일 09:00 편. 위치 불러 주세요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "표지 41 지나서요. 갓길 아니고요. 차가 옆으로 누웠어요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "사람은요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "둘 다 나왔어요. 저는 팔이고, 옆은 괜찮아요. 걸어요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "알겠습니다. 구급 요청 넣었습니다. 냉장 유닛은요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "꺼졌어요. 넘어지면서요. 다시 안 켜져요. 켜 봤어요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "몇 시에요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "여섯 시 오십 분. 계기판에 남아 있어요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "열여덟 시 오십 분. 적었습니다. 화물칸 문은요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "닫혀 있어요. 봉인은 그대로예요. 열어 볼까요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "열지 마세요. 그대로 두세요. 대체 차 요청 중입니다. 가까운 데가 없어서요. 지금 뒤로 두 대 더 서 있죠."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "세 대요. 하나는 돌아갔어요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "알겠습니다. 견인 요청 넣었습니다. 시간은 아직요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "여기 표지 뒤가 절벽이 아니라 논이에요. 그래서 이 정도예요."
        },
        {
          "b": "speech",
          "who": "배차",
          "text": "알겠습니다. 응답 유지하세요. 십 분마다요."
        },
        {
          "b": "speech",
          "who": "차량",
          "text": "유지할게요. (잡음)"
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료.)"
        },
        {
          "b": "cut"
        }
      ]
