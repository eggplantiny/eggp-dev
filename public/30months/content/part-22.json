  "items": [
    {
      "kind": "record",
      "id": "0356",
      "type": "FR",
      "source": "○○ 물류센터 냉동동 · 회수 작업조 현장 녹음",
      "time": "Day 424 14:20",
      "provenance": "수집 Day 425 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(빈 창고. 발소리가 길게 울린다. 손수레 바퀴.)"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "이거예요. 삼 번 유닛. 코드는 어제 받은 거 그대로."
        },
        {
          "b": "speech",
          "who": "하진주",
          "text": "네."
        },
        {
          "b": "cue",
          "text": "(라벨 붙이는 소리. 볼트에 렌치 거는 소리.)"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "잠깐. 전에는 냉매부터 뺐어요. 배관 열기 전에. 안 그러면 손이 얼어요. 순서가 있어요."
        },
        {
          "b": "speech",
          "who": "하진주",
          "text": "지금은 비어 있는데요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "비어 있어요?"
        },
        {
          "b": "speech",
          "who": "하진주",
          "text": "게이지 영이에요. 흔들어도 안 움직여요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "그럼 됐어요. 열어요."
        },
        {
          "b": "silence",
          "sec": 38,
          "note": "렌치 소리. 배관 캡 떨어지는 소리"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "전에는 이걸 셋이 들었는데. 한 사람이 밑에서 받치고."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "하진주",
          "text": "지금은 둘이에요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "둘이죠."
        },
        {
          "b": "cue",
          "text": "(손수레를 끌어오는 소리. 유닛이 실리는 둔한 소리.)"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "무겁죠. 압축기가 다 무게예요."
        },
        {
          "b": "speech",
          "who": "하진주",
          "text": "됐어요. 다음 거요."
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "잘했어요."
        },
        {
          "b": "silence",
          "sec": 7
        },
        {
          "b": "cue",
          "text": "(발소리. 다음 유닛 쪽으로. 라벨 종이 찢는 소리.)"
        },
        {
          "b": "speech",
          "who": "조장",
          "text": "사 번. 이건 문이 안 열려요. 작년에 이미 안 열렸을 거예요."
        },
        {
          "b": "speech",
          "who": "하진주",
          "text": "지금은 이래요. 옆으로 뜯을게요."
        },
        {
          "b": "cue",
          "text": "(드릴 소리.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0357",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 425 22:10",
      "provenance": "수집 Day 425 22:10 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0357.jpg",
          "alt": "집 앞 처마 밑. 전등 하나가 켜져 있고 그 아래 우편함이 비어 있다. 문은 닫혀 있다.",
          "caption": "반복 촬영 · 집 앞 처마 · Day 425"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 스물두 시 십 분. 집."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "처마 사진 한 장. 지난번과 같은 자리. 전등 켜짐. 우편함 빔."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문자 두 통. 그쪽. 근무 조 바뀜. 밤낮 바뀜. 답 한 통. 자라고."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "낮. 통합 보존고 후속 자료. 사유 칸 빈 대장 한 장. 질문지에 넣음. 순서는 마지막."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다음 주 인터뷰 셋. 보존망 둘, 농촌 하나. 질문지 반. 화요일부터."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "화요일 길. 버스 없음. 자전거 한 시간. 미리 봐 둠."
        },
        {
          "b": "silence",
          "sec": 3
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "저녁. 흰밥, 김, 무나물. 한 그릇."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기까지."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
