      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실내.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 스물세 시 십 분."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "문자 셋. 그저께, 어제, 오늘. 답 없음."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "밤낮 바뀐 조. 시차 계산함. 시차 없음. 같은 시각."
        },
        {
          "b": "silence",
          "sec": 6
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "질문지 세 건 완성. 첫 질문 셋 다 같음. 그날 무엇을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "화요일. 자전거. 한 시간."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "한 통 더 보냄. 바쁘면 답 안 해도 됨."
