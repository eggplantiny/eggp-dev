    {
      "kind": "record",
      "id": "0466",
      "type": "FR",
      "source": "교육자료 포장대 현장 녹음",
      "time": "Day 748 16:00",
      "provenance": "수집 Day 748 16:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내. 종이 다듬는 소리)"
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "이건 누구 것입니까."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수집 사본입니다. 제가 가져갈 거예요."
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "그럼 이쪽으로 빼주세요. 보낼 것하고 섞여요."
        },
        {
          "b": "cue",
          "text": "(종이 옮기는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "뒷면이 비었습니다."
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "어느 것요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "이 한 장이요."
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "아, 기다리세요. 기계에 종이 걸렸을 때 나온 게 섞였네."
        },
        {
          "b": "cue",
          "text": "(멀리서 복사기 돌아가는 소리)"
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "이걸로 바꾸세요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "빈 것도 같이 주십시오."
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "그걸 왜요."
        },
        {
          "b": "cue",
          "text": "(종이 넘기는 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "여기 끼워 둘게요."
        },
        {
          "b": "speech",
          "who": "포장 담당",
          "text": "그럼 밖에 빈 거라고 써요. 모르고 또 보내겠어요."
        },
        {
          "b": "cue",
          "text": "(펜 소리)"
        }
      ]
    }
