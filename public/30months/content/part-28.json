  "items": [
    {
      "kind": "record",
      "id": "0449",
      "type": "AN",
      "source": "표준 제어기 계열 확정 공고",
      "time": "Day 692 09:00",
      "provenance": "수집 Day 692 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 표준 제어기 계열 확정\n\n1. 제어기 표준 8계열을 확정한다.\n2. 기존 계열의 신규 제작은 중단한다. 운용 중인 기존 계열은 수명까지 유지한다.\n3. 교체 신청 시 설비 번호와 기존 계열 번호를 함께 적는다. 계열 번호를 읽을 수 없으면 명판을 첨부한다.\n4. 표준 계열의 도면과 교육 과정은 공개 관리한다.\n\n※ 본 공고는 가동 중인 기존 제어기를 회수하라는 지시가 아님."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0450",
      "type": "LG",
      "source": "제어기 계열 대응표 · 표지 집계",
      "time": "Day 695 17:00",
      "provenance": "수집 Day 696 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "계열 대응",
          "rows": "구 계열 등록      512종\n표준 계열           8종\n대응 완료         471종\n대응 불가          41종\n",
          "note": "대응표 본문: 별책 1권.\n대응 불가 목록: 뒤표지 안쪽 봉투. 별도 검토.\n표지의 합계만으로 교체 부품을 청구하지 말 것."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0451",
      "type": "KR",
      "source": "도면 인계 세션 · 표준 1호",
      "time": "Day 698 10:00",
      "provenance": "수집 Day 699 · C-2",
      "preservation": "full",
      "damage": {
        "duration": "00:24:18"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(교육장. 종이 펴는 소리)"
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "이 선은 어디로 갑니까."
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "어느 선이요."
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "여기서 나가는데 다음 장이 없어요."
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "옛 도면 보셨어요? 그 선은 없어졌어요. 가져오신 것 좀 봐요."
        },
        {
          "b": "cue",
          "text": "(종이를 끌어당기는 소리)"
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "이 물건의 설계는 뺀 목록이에요. 앞장에 삭제표가 있어요. 그걸 먼저 빼 가시면 안 돼요."
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "앞장은 결재문인 줄 알았죠."
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "뒤집어 보세요. 여기, 통신 쪽 세 줄. 연결할 데가 없어진 게 아니라 연결을 안 하게 바꾼 거예요. 구멍도 내지 마세요."
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "함체는 벌써 뚫었는데요."
        },
        {
          "b": "cue",
          "text": "(잠시 말 없음)"
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "몇 개요."
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "오늘 것 두 개."
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "일단 옆에 놔주세요. 막는 방법 확인하고 알려드릴게요. 더 뚫지는 마시고요."
        },
        {
          "b": "speech",
          "who": "기록",
          "text": "삭제표도 같이 찍겠습니다. 손 좀 잠깐만."
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "그럼 이쪽도 없습니까. 갱신하는 데."
        },
        {
          "b": "speech",
          "who": "설계 담당",
          "text": "네. 그 줄도 지워져 있어요."
        },
        {
          "b": "speech",
          "who": "제작 담당",
          "text": "지운 데를 더 진하게 해주세요. 복사하니까 밑에 선이 살아나요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0452",
      "type": "FR",
      "source": "양수장 교대 인수인계 녹음",
      "time": "Day 701 18:10",
      "provenance": "수집 Day 702 07:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(펌프 소리. 금속문 닫힘)"
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "이쪽만 바꿨어요. 뒤의 것은 그대로고."
        },
        {
          "b": "speech",
          "who": "뒤 근무자",
          "text": "눌렀는데요."
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "봤어요. 좀 기다려요."
        },
        {
          "b": "speech",
          "who": "뒤 근무자",
          "text": "안 들어간 것 같아서."
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "한 번만. 두 번 누르면 제가 뭘 봐야 할지 몰라요."
        },
        {
          "b": "cue",
          "text": "(펌프 소리가 달라진다)"
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "지금. 바늘 여기까지 왔죠."
        },
        {
          "b": "speech",
          "who": "뒤 근무자",
          "text": "아."
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "저도 첫날에 두 번 눌렀어요. 그래서 붙여 놓은 건데."
        },
        {
          "b": "speech",
          "who": "뒤 근무자",
          "text": "어디요."
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "문 안쪽."
        },
        {
          "b": "speech",
          "who": "뒤 근무자",
          "text": "문 열면 안 보이잖아요."
        },
        {
          "b": "cue",
          "text": "(테이프 떼는 소리)"
        },
        {
          "b": "speech",
          "who": "앞 근무자",
          "text": "여기면 보여요?"
        },
        {
          "b": "speech",
          "who": "뒤 근무자",
          "text": "제 손이 가려요. 조금 위로."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0453",
      "type": "LG",
      "source": "표준 1호 제원 대비표",
      "time": "Day 705 10:00",
      "provenance": "수집 Day 706 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "제원 대비 (표준 1호 · 구형 동급 대비)",
          "rows": "연산 주기        6배 느림\n함체 부피        3배 큼\n소비 전력        1.4배\n기능 수          214 → 31",
          "note": "비고란 없음."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0454",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 708 14:00",
      "provenance": "수집 Day 708 15:00 · C-2",
      "attribution": {
        "subject": "표준 공장 검사 담당",
        "interviewer": "윤재경",
        "purpose": "검사 기록의 보류 표시 확인",
        "testimonyTime": "Day 708 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오전 표에 같은 번호가 두 번 있습니다."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "한 번 되돌렸어요. 문이 안 닫혀서."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "작동 검사는 끝난 거고요?"
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "문 열어 놓고 했으니까요. 닫으니까 선이 걸렸어요. 여기 보세요. 자국 나 있죠."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "다시 감은 겁니까."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "그건 권선이고, 이건 선 묶음이에요. 묶은 자리만 옮겼어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "제가 잘못 적었습니다."
        },
        {
          "b": "cue",
          "text": "(펜 소리)"
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "오전에 이걸 내보냈으면 저녁에 다시 왔을 거예요. 운반하는 사람이 제일 싫어해요. 같은 번호 또 들고 오는 거."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "반송은 여기로 옵니까."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "우리가 내보낸 것은 이쪽으로 와요. 다른 데 것은 모르고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "예전 물건도요?"
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "만든 데로 보내라는 것들은 따로 쌓아요. 저 선반. 상자마다 주소가 달라요."
        },
        {
          "b": "cue",
          "text": "(함체 문을 여닫는 소리)"
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "잠깐, 아직 적지 마세요. 이쪽 모서리가 또 닿네요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0455",
      "type": "KR",
      "source": "기술기록 세션 · 권선 작업 중단 지점 확인",
      "time": "Day 712 10:00",
      "provenance": "수집 Day 713 · C-2",
      "preservation": "full",
      "damage": {
        "duration": "00:31:12"
      },
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0455.jpg",
          "alt": "교육 영상의 정지 프레임. 교관의 두 손이 작업대 위 동선을 잡고 있다.",
          "caption": "권선 교육장 · Day 712"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(작업장. 기계는 멈춰 있다)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "여기서부터 다시요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "여기?"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "아니요. 그 전에 손을 바꾸셨잖아요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "내가 바꿨나."
        },
        {
          "b": "speech",
          "who": "촬영 담당",
          "text": "오른손에서 왼손으로 넘기셨어요. 화면 끝에서."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "그럼 다시 풀어야 돼요. 잠깐만요."
        },
        {
          "b": "cue",
          "text": "(작업 소리)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "제가 당기는 쪽을 잡고 있을까요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "놓아 보세요. 지금은 혼자 하는 걸 남겨야 하니까."
        },
        {
          "b": "speech",
          "who": "촬영 담당",
          "text": "손을 작업대 가운데로 부탁드립니다."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "이렇게 하면 팔이 걸려요."
        },
        {
          "b": "speech",
          "who": "촬영 담당",
          "text": "제가 옮길게요."
        },
        {
          "b": "cue",
          "text": "(의자 끄는 소리. 녹음기에 닿는 소리)"
        },
        {
          "b": "speech",
          "who": "촬영 담당",
          "text": "다시 하셔도 됩니다."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "여기 잡았죠. 여기서 넘겨요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "아, 손을 바꾸는 게 아니라 이쪽을 놓으시는 거네요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "네. 안 놓으면 꼬여요. 이제 해 보세요."
        },
        {
          "b": "cue",
          "text": "(한동안 말 없음)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "또 꼬였어요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0456",
      "type": "AN",
      "source": "회랑 간 복제 패키지 배포 안내",
      "time": "Day 716 09:00",
      "provenance": "수집 Day 716 09:30 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "notice",
          "text": "■ 표준 계열 복제 패키지 1차 배포\n\n배포처: 인접 3개 회랑 · 원격 2개 회랑.\n구성: 도면집 · 치공구 1식 · 교육 영상 · 견본 2대.\n\n수령처는 상자 수와 도면 개정 번호를 먼저 회신한다.\n파손·누락은 포장 목록의 해당 칸에 표시한다.\n교육 영상에서 식별되지 않는 작업은 구간 번호를 적어 재기록을 요청할 수 있다.\n\n각 회랑의 생산 개시 일정은 이번 수령 확인에 포함하지 않는다."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0457",
      "type": "LG",
      "source": "복제 패키지 발송 대장",
      "time": "Day 720 17:00",
      "provenance": "수집 Day 721 09:00 · C-2",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "ledger",
          "name": "패키지 발송",
          "rows": "발송 부수          5\n인접 회랑          3  수령 확인 3\n원격 회랑          2  수령 확인 1 · 이동 중 1\n",
          "note": "견본은 패키지별 2대. 판매·설치분과 별도 기재.\n수령 확인은 상자 인수 기준.\n이동 중 1부의 도착일 칸: 미기재."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0458",
      "type": "FR",
      "source": "검사대 현장 녹음",
      "time": "Day 723 11:00",
      "provenance": "수집 Day 723 11:00 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(실내. 금속을 책상에 놓는 소리)"
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "그 뚜껑까지 나오게 찍어주세요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "나사 놓은 것 말씀이세요."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "네. 안 그러면 뚜껑 닫고 한 개 남은 줄을 몰라요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "지금 것은 다 있습니까."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "세어 보세요."
        },
        {
          "b": "cue",
          "text": "(작은 금속음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "하나가 문 아래 있네요."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "아까 제가 거기 놨네요. 잠깐만요."
        },
        {
          "b": "cue",
          "text": "(금속음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "찍었습니다."
        },
        {
          "b": "speech",
          "who": "검사 담당",
          "text": "안쪽도 나왔어요?"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "확인할게요."
        },
        {
          "b": "cue",
          "text": "(잠시 말 없음)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "제 그림자가 겹쳤습니다. 한 장 다시요."
        }
      ]
    },
    {
      "kind": "record",
      "id": "0459",
      "type": "KR",
      "source": "여섯 주 정비 과정 · 마지막 실습",
      "time": "Day 727 10:00",
      "provenance": "수집 Day 728 · C-2",
      "preservation": "full",
      "damage": {
        "duration": "00:47:30"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(교육장. 의자 움직이는 소리)"
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "시작하기 전에 뭘 빼먹었죠."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "이름 안 썼어요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "이름 말고."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "차단 확인했습니다. 여기 표시했고요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "그러면 장갑 끼세요. 아까 벗었잖아요."
        },
        {
          "b": "cue",
          "text": "(천 스치는 소리)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "오늘도 안 켜지는 겁니까."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "증상부터 적으세요. 아직 안 켜 봤죠."
        },
        {
          "b": "cue",
          "text": "(이후 작업 18분)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "이 부품 바꾸고 확인까지 했습니다."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "대장은요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "여기요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "읽어 보세요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "안 켜짐. 교체. 정상."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "뭘 교체했어요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "아."
        },
        {
          "b": "cue",
          "text": "(펜 소리)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "이제 혼자 해도 되는 거죠?"
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "오늘 한 데까지요. 여기까지 여섯 주면 누구나."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "보드 안쪽도 다음에 배웁니까."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "그건 여기서 안 해요. 이 표에서 못 찾으면 덮어서 보내요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "고친 게 없는데요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "확인한 건 적을 수 있죠. 어디까지 했는지. 받는 사람이 처음부터 안 하게."
        },
        {
          "b": "cue",
          "text": "(종이를 넘긴다)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "그 칸이 뒤에도 있었네요."
        }
      ]
    },
