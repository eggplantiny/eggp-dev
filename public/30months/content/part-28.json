    {
      "kind": "record",
      "id": "0462",
      "type": "IV",
      "source": "인터뷰",
      "time": "Day 738 14:00",
      "provenance": "수집 Day 738 15:00 · C-2",
      "attribution": {
        "subject": "타 회랑 연수자",
        "interviewer": "윤재경",
        "purpose": "귀환 전 교육자료 인계 확인",
        "testimonyTime": "Day 738 14:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(숙소 앞. 가방 지퍼 소리)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "수료하고도 며칠 더 계셨네요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "차가 오늘 있어요. 기다리는 동안 남의 실습만 봤어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "처음부터 끝까지 여섯 주 하신 거죠."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "네. 제 것은 끝났고요. 이것 좀 눌러주시겠어요."
        },
        {
          "b": "cue",
          "text": "(지퍼 소리가 멎는다)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "책 때문에 안 닫히는 것 같은데요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "책은 맨 밑에 있어요. 빨래가 덜 말라서 봉투를 하나 더 쌌어요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "견본도 가져가십니까."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "그건 먼저 갔어요. 가져가는 게 아니라 배워 가는 거예요. 종이는 거들 뿐이고요."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "오늘은 뭘 다시 보셨어요."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "선 넘기는 거요. 사람이 달라지니까 반대로 하더라고요. 왼손잡이라."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "그쪽에서는 누가 배우게 됩니까."
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "정해 놨다고는 들었는데, 제가 가 봐야죠. 그 사람도 왼손잡이인지 아직 몰라요."
        },
        {
          "b": "cue",
          "text": "(멀리서 사람을 부른다)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "잠깐만요. 제 이름 같은데."
        },
        {
          "b": "cue",
          "text": "(자리를 떠났다가 돌아오는 발소리)"
        },
        {
          "b": "speech",
          "who": "연수자",
          "text": "아니네요. 눌러주신 채로 잠깐만 계세요. 이쪽부터 닫을게요."
        },
        {
          "b": "cue",
          "text": "(이후 승차 안내. 가방을 끄는 소리. 차문이 닫히고 엔진 소리가 멀어진다)"
        }
      ]
    },
