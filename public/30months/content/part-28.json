    {
      "kind": "record",
      "id": "0464",
      "type": "KR",
      "source": "다음 기수 교육 영상 · 접수표 작성",
      "time": "Day 744 10:00",
      "provenance": "수집 Day 745 · C-2",
      "preservation": "partial",
      "damage": {
        "duration": "01:21:05",
        "recovered": "12:40~55:18"
      },
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(복구 구간 시작. 종이 넘기는 소리)"
        },
        {
          "b": "speech",
          "who": "수강생",
          "text": "여기 정상이라고 썼는데 지워요?"
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "뭘 보고 썼어요."
        },
        {
          "b": "speech",
          "who": "수강생",
          "text": "어제까지 돌았대요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "그건 신고 칸. 확인 칸에는 오늘 본 것을 쓰세요."
        },
        {
          "b": "speech",
          "who": "수강생",
          "text": "오늘은 못 켰어요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "그러면 그렇게 적고요."
        },
        {
          "b": "speech",
          "who": "수강생",
          "text": "고장이라고요?"
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "못 켰다고요. 고장인지는 아직 모르잖아요."
        },
        {
          "b": "cue",
          "text": "(펜 소리)"
        },
        {
          "b": "speech",
          "who": "다른 수강생",
          "text": "제 것은 계열 번호가 없어요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "표준 아니에요. 오늘 뒤쪽 책상은 옛것입니다."
        },
        {
          "b": "speech",
          "who": "다른 수강생",
          "text": "이건 왜 있어요."
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "들어오면 분류는 해야죠. 같은 부품 끼워 넣지 않게."
        },
        {
          "b": "cue",
          "text": "(의자를 당기는 소리)"
        },
        {
          "b": "speech",
          "who": "수강생",
          "text": "선생님, 못 켰다는 건 띄어 써요?"
        },
        {
          "b": "speech",
          "who": "교관",
          "text": "그건 알아보게만 쓰세요."
        },
        {
          "b": "cue",
          "text": "(복구 구간 종료)"
        },
        {
          "b": "cut"
        }
      ]
    },
