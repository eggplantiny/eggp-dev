    {
      "kind": "record",
      "id": "0098",
      "type": "FR",
      "source": "가정 내 녹음 · 켜둔 채 잊음",
      "time": "Day 29 14:20",
      "provenance": "수집 Month 19 · C-3",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(부엌. 주전자 소리.)"
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "어머님, 약 드실 시간이에요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "벌써 그렇게 됐나."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "두 시 반 거예요. 물 먼저요."
        },
        {
          "b": "cue",
          "text": "(컵 놓는 소리.)"
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "자네가 고생이 많네."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "고생은요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "미안해서 그러지."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "어머님, 그 말씀 오늘 세 번째예요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "(웃음) 그런가."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "네. 아침에 두 번 하셨어요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "애 엄마는 언제 온다고 했지."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "내일 저녁이요. 모레 아침에 다시 들어가고요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "그래. 내일."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "자네 점심은 먹었나."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "애랑 같이 먹었어요. 어머님 죽 끓이면서 저희 것도 했어요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "죽 말고 자네들은 밥을 먹어야지."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "밥이었어요. 저희 건."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "그럼 됐네."
        },
        {
          "b": "cue",
          "text": "(주전자 소리. 컵 씻는 소리.)"
        }
      ]
    },
    {
      "kind": "record",
      "id": "0099",
      "type": "PV",
      "source": "개인 음성기록",
      "time": "Day 30 08:40",
      "provenance": "수집 Day 30 08:40 · C-1",
      "attribution": {
        "recorder": "윤재경"
      },
      "preservation": "full",
      "media": [
        {
          "type": "image",
          "src": "/30months/m/0099.jpg",
          "alt": "교육동 정문 앞. 버스 두 대 사이로 가방을 든 여성 셋이 건물 쪽으로 걸어간다. 오른쪽에 아이를 목말 태운 남자의 뒷모습.",
          "caption": "권역 발전소 교육동 정문 · Day 30"
        }
      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(실외. 버스 공회전음. 녹음 시작.)"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "교육동 정문. 여덟 시 사십 분. 버스 두 대."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "내리는 사람은 전부 여자다. 가방은 여행 가방이 아니라 장바구니형이 많다. 반찬통 부딪치는 소리."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "정문 밖에 배웅. 남자 여섯, 아이 넷. 안까지는 못 들어간다고 한다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "아이 하나가 손을 흔들다가 남자 목말을 탄다. 더 잘 보이려고."
        },
        {
          "b": "silence",
          "sec": 6,
          "note": "버스 출발음"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "닷새 뒤에 또 나온다는데도 다들 오래 흔든다."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "사진 한 장. 뒷모습만."
        },
        {
          "b": "cue",
          "text": "(녹음 종료.)"
        }
      ]
    },
    {
