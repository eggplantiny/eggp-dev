    {
      "kind": "record",
      "id": "0108",
      "type": "IV",
      "source": "인터뷰",
      "time": "Month 19",
      "provenance": "수집 Month 19 · C-4",
      "attribution": {
        "subject": "산업 기초 교육 1기 수료자",
        "interviewer": "윤재경",
        "purpose": "산업 인력 전환 기록수집",
        "testimonyTime": "Day 38 19:00"
      },
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "speech",
          "who": "—",
          "text": "입교를 결정하실 때 무엇을 기준으로 하셨습니까."
        },
        {
          "b": "speech",
          "who": "수료자",
          "text": "기준이랄 게 있었나요. 됐으니까 갔어요. 집이 됐으니까요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "집이 됐다는 건 어떤 뜻입니까."
        },
        {
          "b": "speech",
          "who": "수료자",
          "text": "약 드릴 사람이 있고, 애 밥 줄 사람이 있고요. 그게 되면 가는 거고 안 되면 못 가는 거예요. 저는 됐어요. 그때는요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "교육은 어떠셨습니까."
        },
        {
          "b": "speech",
          "who": "수료자",
          "text": "처음엔 다 처음이었어요. 공구 이름부터요. 그런데 같은 방 사람들이 다 처음이라서, 그게 오히려 나았어요. 물어보는 게 창피하지 않았어요."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "교육 기간 중에 집 걱정을 하셨습니까."
        },
        {
          "b": "speech",
          "who": "수료자",
          "text": "주말마다 갔으니까요. 갈 때마다 애가 아빠 얘기를 했어요. 아빠가 계란을 터뜨린다고. 그게 좋대요."
        },
        {
          "b": "silence",
          "sec": 9
        },
        {
          "b": "speech",
          "who": "—",
          "text": "수료 후에도 계속 일하러 나가셨습니다."
        },
        {
          "b": "speech",
          "who": "수료자",
          "text": "네."
        },
        {
          "b": "speech",
          "who": "—",
          "text": "그때도 같은 기준이었습니까."
        },
        {
          "b": "silence",
          "sec": 6
        },
