    {
      "kind": "record",
      "id": "0098",
      "type": "FR",
      "source": "가정 내 녹음 · 켜둔 채 잊음",
      "time": "Day 29 14:20",
      "provenance": "수집 Month 19 · C-3",
      "preservation": "full",
      "media": null,
      "blocks": [
        {
          "b": "cue",
          "text": "(부엌. 주전자 소리)"
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "어머님, 약 드실 시간이에요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "벌써 그렇게 됐나."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "두 시 반 거예요. 물 여기요."
        },
        {
          "b": "cue",
          "text": "(컵 놓는 소리)"
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "자네가 고생이 많네."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "고생은요. 뭘."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "미안해서 그러지."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "어머님 그 말씀 오늘 세 번째예요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "(웃음) 그런가."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "네. 아침에 두 번 하셨어요."
        },
        {
          "b": "silence",
          "sec": 5
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "애 엄마는 언제 온다고 했지."
        },
        {
          "b": "speech",
          "who": "남편",
          "text": "토요일에요. 이틀 남았어요."
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "그래. 이틀."
        },
        {
          "b": "silence",
          "sec": 4
        },
        {
          "b": "speech",
          "who": "장모",
          "text": "자네 점심은 먹었나."
        },
        {
