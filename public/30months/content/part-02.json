      ],
      "blocks": [
        {
          "b": "cue",
          "text": "(녹음 시작. 실외. 확성기로 명단 호명이 이어짐)"
        },
        {
          "b": "speech",
          "who": "진행 요원 (확성기)",
          "text": "다음, 사십일 번부터 육십 번. 접수대 앞으로."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 북부체육관 앞. 귀가 시작 삼십 분. 줄은 두 줄."
        },
        {
          "b": "cue",
          "text": "(짐 끄는 소리가 가까워짐)"
        },
        {
          "b": "speech",
          "who": "귀가 입소자",
          "text": "기자님이신가."
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네. 취재 중입니다. 불편하시면 말씀 안 하셔도 됩니다."
        },
        {
          "b": "speech",
          "who": "귀가 입소자",
          "text": "아니, 뭐 하나만. 우리, 괜찮아진 거니까 보내주는 거겠죠."
        },
        {
          "b": "silence",
          "sec": 5,
          "note": "확성기 호명이 이어짐"
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "네. 그럴 거예요."
        },
        {
          "b": "speech",
          "who": "귀가 입소자",
          "text": "그렇지. 고맙습니다."
        },
        {
          "b": "cue",
          "text": "(짐 끄는 소리가 멀어짐)"
        },
        {
          "b": "silence",
          "sec": 8
        },
        {
          "b": "speech",
          "who": "윤재경",
          "text": "(작게) 사십일 번부터 육십 번, 접수대 통과."
        },
        {
          "b": "cue",
          "text": "(녹음 종료)"
        }
      ]
    },
    {
