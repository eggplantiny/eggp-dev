---
interface Props {
  lang?: string;
}
const { lang = "ko" } = Astro.props;
const ko = lang === "ko";
const isHome = Astro.url.pathname === "/";
const isNovel = Astro.url.pathname.startsWith("/30months");
const isEssay = Astro.url.pathname.startsWith("/essays");
---

<nav
  class="site-nav"
  aria-label={ko ? "작업실 둘러보기" : "Explore the workshop"}
>
  <a href={isHome ? "#projects" : "/#projects"}
    >{ko ? "프로젝트" : "Projects"}</a
  >
  <a href="/30months/" aria-current={isNovel ? "page" : undefined}
    >{ko ? "소설" : "Fiction"}</a
  >
  <a
    href={isHome ? "#essays" : "/#essays"}
    aria-current={isEssay ? "location" : undefined}
  >
    {ko ? "글" : "Essays"}
  </a>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 26px);
    font-family: var(--font-sans, var(--archive-sans, sans-serif));
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--text-muted, var(--archive-ink-2));
  }
  .site-nav a:hover,
  .site-nav a[aria-current] {
    color: var(--text, var(--archive-ink));
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>
