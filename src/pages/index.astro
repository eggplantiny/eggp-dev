---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/workshop.css";

const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const stems = [
  ...new Set(essays.map((essay) => essay.id.split("/").slice(1).join("/"))),
];
const groupedEssays = stems.map((stem) => {
  const versions = essays.filter(
    (essay) => essay.id.split("/").slice(1).join("/") === stem,
  );
  const primary =
    versions.find((essay) => essay.id.startsWith("ko/")) ?? versions[0];
  return { primary, versions };
});
const formatted = new Intl.DateTimeFormat("ko-KR", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  title="Essays"
  metaTitle="Essays — AI, 소프트웨어, 창작에 관한 글"
  description="AI, 소프트웨어, 창작에 관한 eggplantiny의 에세이. 만들고 쓰며 남긴 생각을 한국어와 영어로 읽을 수 있습니다."
  lang="ko"
>
  <main class="page-shell collection-page" id="main-content">
    <section id="essays" aria-labelledby="essays-heading">
      <header class="collection-intro">
        <h1 id="essays-heading" lang="en">Essays</h1>
        <p>AI, 소프트웨어, 창작에 관해 쓰고 생각합니다.</p>
      </header>

      <ul class="writing-list">
        {
          groupedEssays.map(({ primary, versions }) => (
            <li>
              <article>
                <h2>
                  <a
                    href={`/essays/${primary.id}/`}
                    lang={primary.id.split("/")[0]}
                  >
                    {primary.data.title}
                  </a>
                </h2>
                <p class="writing-summary" lang={primary.id.split("/")[0]}>
                  {primary.data.subtitle ?? primary.data.description}
                </p>
                <div class="writing-meta">
                  <time datetime={primary.data.date.toISOString()}>
                    {formatted.format(primary.data.date)}
                  </time>
                  <nav
                    class="writing-languages"
                    aria-label={`${primary.data.title} 읽기 언어`}
                  >
                    {["ko", "en"].map((locale) => {
                      const version = versions.find((essay) =>
                        essay.id.startsWith(`${locale}/`),
                      );
                      return (
                        version && (
                          <a
                            href={`/essays/${version.id}/`}
                            lang={locale}
                            hreflang={locale}
                          >
                            {locale === "ko" ? "한국어" : "English"}
                          </a>
                        )
                      );
                    })}
                  </nav>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
      {
        groupedEssays.length === 0 && (
          <p class="collection-empty">아직 공개된 글이 없습니다.</p>
        )
      }
    </section>
  </main>
</BaseLayout>
