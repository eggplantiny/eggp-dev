---
import BaseLayout from "./BaseLayout.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import { asLocale, sectionPaths } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  date: Date;
  subtitle?: string;
  ogImage?: string;
  ogImageAlt?: string;
  draft?: boolean;
  lang?: string;
  tags?: string[];
  keywords?: string[];
  alternateVersions?: Array<{
    lang: string;
    href: string;
    active: boolean;
  }>;
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  date,
  subtitle,
  ogImage,
  ogImageAlt,
  draft = false,
  lang = "en",
  tags = [],
  keywords = [],
  alternateVersions = [],
} = Astro.props;

const dateLocale = lang === "ko" ? "ko-KR" : "en-US";
const indexHref = `${sectionPaths[asLocale(lang)].essays}#essays`;
const formattedDate = new Intl.DateTimeFormat(dateLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<BaseLayout
  title={title}
  description={description}
  metaTitle={seoTitle}
  metaDescription={seoDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType="article"
  noindex={draft}
  lang={lang}
  publishedTime={date}
  tags={tags}
  keywords={keywords}
  alternates={alternateVersions.map((version) => ({
    lang: version.lang.toLowerCase(),
    href: version.href,
    default: version.lang.toLowerCase() === "en",
  }))}
>
  <main class="page-shell essay-page" id="main-content">
    <a href={indexHref} class="essay-backlink"
      >{lang === "ko" ? "← 글 목록" : "← All essays"}</a
    >

    <article class="essay-article">
      <header class="essay-header">
        {
          alternateVersions.length > 1 && (
            <nav
              class="essay-locale-switch"
              aria-label="Essay language versions"
            >
              {alternateVersions.map((version) => (
                <a
                  href={version.href}
                  aria-current={version.active ? "page" : undefined}
                  class:list={[
                    "essay-locale-link",
                    version.active && "is-active",
                  ]}
                >
                  {version.lang}
                </a>
              ))}
            </nav>
          )
        }

        <h1 class="essay-title">{title}</h1>
        {subtitle && <p class="essay-subtitle">{subtitle}</p>}
        <p class="essay-date">{formattedDate}</p>
        <div class="essay-header-rule" aria-hidden="true"></div>
      </header>

      <div class="prose max-w-none essay-prose">
        <slot />
      </div>
    </article>

    <aside
      class="essay-subscribe"
      aria-label={lang === "ko" ? "뉴스레터 구독" : "Newsletter subscription"}
    >
      <SubscribeForm lang={lang} />
    </aside>

    <footer class="essay-footer">
      <a href={indexHref} class="essay-backlink"
        >{lang === "ko" ? "← 글 목록" : "← All essays"}</a
      >
    </footer>
  </main>
</BaseLayout>
